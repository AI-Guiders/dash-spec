<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <disabledPackageSources>
    <!-- Machine-wide aiguiders-local points at a stale path; dash-spec uses project refs + nuget.org. -->
    <add key="aiguiders-local" value="true" />
  </disabledPackageSources>
</configuration>
