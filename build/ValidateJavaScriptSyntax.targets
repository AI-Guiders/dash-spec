<Project>
  <Target Name="ValidateJavaScriptSyntax"
          BeforeTargets="Build"
          Condition="'$(ValidateJavaScriptSyntax)' != 'false'">
    <ItemGroup>
      <_JsSyntaxFile Include="$(MSBuildProjectDirectory)\wwwroot\js\*.js" />
      <_JsSyntaxFile Include="$(MSBuildProjectDirectory)\wwwroot\lib\**\*.js" />
    </ItemGroup>
    <Exec Command="node --check &quot;%(_JsSyntaxFile.FullPath)&quot;"
          Condition="'@(_JsSyntaxFile)' != ''"
          IgnoreExitCode="false"
          ContinueOnError="false" />
  </Target>
</Project>
