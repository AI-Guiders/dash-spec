<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- SelfMade render stack (ADR-0112): everything visual that predates Radzen —
       chrome css parts hub, chartjs/flatpickr libs, datepicker glue — in one
       stack-owned place, so it keeps building and stays out of the Radzen
       stack's way. Asset-only assembly: no code. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>14</LangVersion>
    <RootNamespace>DashSpec.Stack.SelfMade</RootNamespace>
    <Version>0.1.0</Version>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <Import Project="..\..\..\build\ValidateJavaScriptSyntax.targets" />

</Project>
