<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- Radzen render stack (ADR-0112): the stack is the visual language of the
       surface. It reads the author's theme token and links its own reading of
       it — the host never links stack css. Companion of DashSpec.Stack.SelfMade. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>14</LangVersion>
    <RootNamespace>DashSpec.Stack.Radzen</RootNamespace>
    <Version>0.1.0</Version>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\DashSpec.Abstractions\DashSpec.Abstractions.csproj" />
  </ItemGroup>

</Project>
