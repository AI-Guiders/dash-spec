@* Radzen stack head (ADR-0112): the stack reads the author's theme token and
   links its own reading of it — the dictionary lives in RadzenColorSchemes. No
   stack has "own css" — the stack IS the visual language. The host passes the
   token, never the link. Unknown token -> the stack default here; the loud
   warning fires once at bootstrap (HostBootstrapService). Dark = the stock
   dark.css base + this stack's palette override (theme-dark.css): deep navy +
   cyan, the BI surface — not the stock gray. *@
<link rel="stylesheet" href="@ThemeReading.BaseCss" />
@if (ThemeReading.OverrideCss is { } overrideCss)
{
    <link rel="stylesheet" href="@overrideCss" />
}
<link rel="stylesheet" href="_content/DashSpec.Stack.Radzen/css/chrome.css?v=20261029a" />

@code {
    /// <summary>Theme token (ADR-0112 §2): the author's intent, not a palette.</summary>
    [Parameter] public string Theme { get; set; } = RadzenColorSchemes.DefaultToken;

    private RadzenTheme ThemeReading =>
        RadzenColorSchemes.Find(Theme) ?? RadzenColorSchemes.All[0];
}
