@namespace DashSpec.Plugin.Filter.Builtins.Components
@using DashSpec.Core.Runtime
@using DashSpec.Execution.Runtime
@using DashSpec.Filters
@using DashSpec.Plugin.Filter.Builtins.Components.Shared

<TopFilterInput Label="@Context.Label"
                ScopeHint="@Context.Hint"
                ScopeHintAriaLabel="@Context.HintAriaLabel"
                ScopeHintInline="@Context.Filter.IsBindScopeInline"
                Disabled="@Context.Disabled"
                Min="@(Context.Filter.MinValue ?? 1)"
                Max="@(Context.Filter.MaxValue ?? TopLimitDefaults.DefaultMax)"
                Value="@Context.TopValue"
                ValueChanged="@Context.TopValueChanged"
                ToolbarLabeledCells="@Context.ToolbarLabeledCells"
                Style="@Context.PlacementStyle" />

@code {
    [Parameter, EditorRequired] public FilterWidgetRenderContext Context { get; set; } = default!;
}
