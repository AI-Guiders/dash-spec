@namespace DashSpec.Plugin.Filter.Builtins.Components

<button type="button"
        class="secondary card-filter-apply"
        disabled="@Disabled"
        @onclick="OnApply">
    @Label
</button>

@code {
    [Parameter, EditorRequired]
    public string Label { get; set; } = default!;

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public EventCallback OnApply { get; set; }
}
