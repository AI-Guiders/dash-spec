@namespace DashSpec.Plugin.Filter.Builtins.Components
@using DashSpec.Plugin.Filter.Builtins.Components.Shared

<FilterApplyIconButton AriaLabel="@Label"
                       CssClass="secondary card-icon-btn card-filter-apply filter-apply-icon"
                       Disabled="@Disabled"
                       OnClick="OnApply" />

@code {
    [Parameter, EditorRequired]
    public string Label { get; set; } = default!;

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public EventCallback OnApply { get; set; }
}
