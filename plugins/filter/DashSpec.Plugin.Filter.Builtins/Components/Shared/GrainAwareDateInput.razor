@namespace DashSpec.Plugin.Filter.Builtins.Components.Shared

@using System.Globalization
@using DashSpec.Execution.Runtime
@using DashSpec.Presentation.Filters
@inject DashSpec.Plugin.Filter.Builtins.Components.IFilterDateInputOverride DateInputOverride

@{
    // ADR-0118: the stack may bind the single-date input per grain (enum seam);
    // absent an override the flatpickr builtins render below — unchanged path.
    var stackDateInput = DateInputOverride.ResolveDateInput(ResolvedGrain);
}

@if (Filter.IsDayWidget)
{
    @if (ShowLabel)
    {
        <span class="@LabelClass">@Label</span>
    }

    <div class="date-range date-range-day">
        @if (stackDateInput is not null)
        {
            <DynamicComponent Type="stackDateInput"
                              Parameters="@SingleInputParameters(WireValueFor(ResolvedGrain), SingleWireChanged)" />
        }
        else if (HasGrainFilter)
        {
            @switch (Grain)
            {
                case "month":
                    <CultureAwareDateInput Mode="month"
                                           Value="@MonthValue"
                                           ValueChanged="OnMonthWireChanged"
                                           InputClass="date-input-grain filter-grain-input"
                                           AriaLabel="@Label"
                                           Disabled="@Disabled" />
                    break;

                case "year":
                    <CultureAwareDateInput Mode="year"
                                           Value="@YearValue"
                                           ValueChanged="OnYearWireChanged"
                                           InputClass="date-input-grain date-input-year filter-grain-input"
                                           AriaLabel="@Label"
                                           Disabled="@Disabled" />
                    break;

                default:
                    <CultureAwareDateInput Mode="day"
                                           Value="@DayValue"
                                           ValueChanged="OnDayWireChanged"
                                           InputClass="filter-grain-input"
                                           AriaLabel="@Label"
                                           Disabled="@Disabled" />
                    break;
            }
        }
        else
        {
            <CultureAwareDateInput Mode="day"
                                   Value="@DayValue"
                                   ValueChanged="OnDayWireChanged"
                                   InputClass="filter-grain-input"
                                   AriaLabel="@Label"
                                   Disabled="@Disabled" />
        }
    </div>
}
else
{
    @if (ShowLabel)
    {
        <span class="@LabelClass">@Label</span>
    }

    <div class="date-range">
        <CultureAwareDateInput Mode="day"
                               Value="@DayValue"
                               ValueChanged="OnRangeFromWireChanged"
                               InputClass="filter-grain-input"
                               AriaLabel="@($"{Filter.Name} from")"
                               Disabled="@Disabled" />
        <span class="date-sep">—</span>
        <CultureAwareDateInput Mode="day"
                               Value="@RangeToValue"
                               ValueChanged="OnRangeToWireChanged"
                               InputClass="filter-grain-input"
                               AriaLabel="@($"{Filter.Name} to")"
                               Disabled="@Disabled" />
    </div>
}

@code {
    [Parameter, EditorRequired] public FilterDefinition Filter { get; set; } = default!;

    [Parameter, EditorRequired] public Dictionary<string, DateOnly> DateFrom { get; set; } = default!;

    [Parameter, EditorRequired] public Dictionary<string, DateOnly> DateTo { get; set; } = default!;

    [Parameter, EditorRequired] public IReadOnlyDictionary<string, FilterDefinition> FilterIndex { get; set; } = default!;

    [Parameter, EditorRequired] public Dictionary<string, HashSet<string>> SelectedFields { get; set; } = default!;

    [Parameter] public string Label { get; set; } = string.Empty;

    [Parameter] public bool ShowLabel { get; set; } = true;

    [Parameter] public bool Disabled { get; set; }

    [Parameter] public string LabelClass { get; set; } = "filter-inline-label";

    [Parameter] public EventCallback OnRangeChanged { get; set; }

    [Parameter] public EventCallback<string> OnDayChanged { get; set; }

    private bool HasGrainFilter => !string.IsNullOrWhiteSpace(Filter.GrainFilterName?.Value);

    private string? Grain => HasGrainFilter
        ? GrainFilterPresentation.ResolveGrain(Filter, FilterIndex, SelectedFields)
        : null;

    /// <summary>The resolved grain as the enum — the DSL edge already parsed it via
    /// <see cref="GrainFilterPresentation"/>; an unresolved grain degrades to Day
    /// (DS0583 warns at authoring time when the spec forgot the default).</summary>
    private DateGrain ResolvedGrain =>
        Grain is not null && DateGrainText.TryParse(Grain, out var grain) ? grain : DateGrain.Day;

    private string WireValueFor(DateGrain grain) => grain switch
    {
        DateGrain.Month => MonthValue,
        DateGrain.Year => YearValue,
        _ => DayValue,
    };

    private Task SingleWireChanged(string wire) => ResolvedGrain switch
    {
        DateGrain.Month => OnMonthWireChanged(wire),
        DateGrain.Year => OnYearWireChanged(wire),
        _ => OnDayWireChanged(wire),
    };

    private Dictionary<string, object?> SingleInputParameters(string value, Func<string, Task> changed) => new()
    {
        ["Grain"] = ResolvedGrain,
        ["Value"] = value,
        ["ValueChanged"] = EventCallback.Factory.Create<string>(this, changed),
        ["InputClass"] = "filter-grain-input",
        ["AriaLabel"] = Label,
        ["Disabled"] = Disabled,
    };

    private string DayValue => DateValueCodec.FormatWireDay(DateFrom[Filter.Name]);

    private string RangeToValue => DateValueCodec.FormatWireDay(DateTo[Filter.Name]);

    private string MonthValue => $"{DateFrom[Filter.Name]:yyyy-MM}";

    private string YearValue => DateFrom[Filter.Name].Year.ToString(CultureInfo.InvariantCulture);

    private async Task OnDayWireChanged(string wire)
    {
        if (!DateValueCodec.TryParseWireDay(wire, out var parsed) ||
            !SqlDateTimeRange.IsQueryable(parsed))
        {
            return;
        }

        var changed = HasGrainFilter
            ? ApplyAnchor(GrainFilterPresentation.NormalizeAnchor(parsed, Grain))
            : ApplyDay(parsed);

        if (changed)
        {
            await NotifyChangedAsync();
        }
    }

    private async Task OnRangeFromWireChanged(string wire)
    {
        if (DateValueCodec.TryParseWireDay(wire, out var parsed) &&
            SqlDateTimeRange.IsQueryable(parsed))
        {
            DateFrom[Filter.Name] = parsed;
        }

        await OnRangeChangedAsync();
    }

    private async Task OnRangeToWireChanged(string wire)
    {
        if (DateValueCodec.TryParseWireDay(wire, out var parsed) &&
            SqlDateTimeRange.IsQueryable(parsed))
        {
            DateTo[Filter.Name] = parsed;
        }

        await OnRangeChangedAsync();
    }

    private async Task OnRangeChangedAsync()
    {
        if (OnRangeChanged.HasDelegate)
        {
            await OnRangeChanged.InvokeAsync();
        }
    }

    private async Task OnMonthWireChanged(string wire)
    {
        var changed = false;
        if (DateValueCodec.TryParseWireMonthAnchor(wire, out var parsed) &&
            SqlDateTimeRange.IsQueryable(parsed))
        {
            changed = ApplyAnchor(GrainFilterPresentation.NormalizeAnchor(parsed, "month"));
        }

        if (changed)
        {
            await NotifyChangedAsync();
        }
    }

    private async Task OnYearWireChanged(string wire)
    {
        var changed = false;
        if (int.TryParse(wire, NumberStyles.None, CultureInfo.InvariantCulture, out var year) &&
            year is >= 1970 and <= 2100)
        {
            var parsed = new DateOnly(year, 1, 1);
            if (SqlDateTimeRange.IsQueryable(parsed))
            {
                changed = ApplyAnchor(GrainFilterPresentation.NormalizeAnchor(parsed, "year"));
            }
        }

        if (changed)
        {
            await NotifyChangedAsync();
        }
    }

    private bool ApplyDay(DateOnly day)
    {
        if (DateFrom.TryGetValue(Filter.Name, out var from) && from == day &&
            DateTo.TryGetValue(Filter.Name, out var to) && to == day)
        {
            return false;
        }

        DateFrom[Filter.Name] = day;
        DateTo[Filter.Name] = day;
        return true;
    }

    private bool ApplyAnchor(DateOnly anchor) => ApplyDay(anchor);

    private DateOnly? _lastNotifiedFrom;
    private DateOnly? _lastNotifiedTo;

    private async Task NotifyChangedAsync()
    {
        // Same day/anchor re-picked (picker echo, re-render) must not re-trigger
        // the filter apply pipeline — that is a full reload per commit.
        DateFrom.TryGetValue(Filter.Name, out var from);
        DateTo.TryGetValue(Filter.Name, out var to);
        if (_lastNotifiedFrom == from && _lastNotifiedTo == to)
        {
            return;
        }

        _lastNotifiedFrom = from;
        _lastNotifiedTo = to;

        if (OnDayChanged.HasDelegate)
        {
            await OnDayChanged.InvokeAsync(Filter.Name);
        }
        else if (OnRangeChanged.HasDelegate)
        {
            await OnRangeChanged.InvokeAsync();
        }
    }
}
