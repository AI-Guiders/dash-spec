@namespace DashSpec.Plugin.Filter.Builtins.Components
@using DashSpec.Filters
@inject IFilterWidgetComponentResolver WidgetResolver

@if (_componentType is not null)
{
    <div data-testid="filter-@Context.Filter.Name">
        <DynamicComponent @key="@($"{Context.Filter.Name}:{Context.Options.Count}")"
                          Type="_componentType"
                          Parameters="_parameters" />
    </div>
}

@code {
    [Parameter, EditorRequired] public FilterWidgetRenderContext Context { get; set; } = default!;

    private Type? _componentType;
    private Dictionary<string, object?> _parameters = new();

    protected override void OnParametersSet()
    {
        _componentType = WidgetResolver.ResolveComponentType(Context.Filter);
        _parameters = new Dictionary<string, object?>
        {
            ["Context"] = Context,
        };
    }
}
