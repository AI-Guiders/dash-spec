@namespace DashSpec.Plugin.Viz.RadzenUI.Components
@using Radzen.Blazor
@using DashSpec.Viz

@* ADR-0112: the Radzen stack's card chrome button — RadzenButton, the theme paints
   it. Surface: StackButtonContext (Label, Disabled, Clicked, optional Pressed,
   optional Icon, optional TestId). *@

@{
    // object? values: a null TestId renders no attribute — the renderer drops it.
    var extra = Context.Pressed is { } pressed
        ? new Dictionary<string, object?> { ["aria-pressed"] = pressed ? "true" : "false" }
        : new Dictionary<string, object?>();
    extra["data-testid"] = Context.TestId;
}

@if (Context.Icon is null)
{
    <RadzenButton @attributes="extra"
                  Text="@Context.Label"
                  Click="@(() => Context.Clicked.InvokeAsync())"
                  Disabled="@Context.Disabled"
                  ButtonType="ButtonType.Button"
                  Size="ButtonSize.Small"
                  Variant="Variant.Text"
                  class="card-chrome-btn"
                  AriaLabel="@Context.Label" />
}
else
{
    <RadzenButton @attributes="extra"
                  Click="@(() => Context.Clicked.InvokeAsync())"
                  Disabled="@Context.Disabled"
                  ButtonType="ButtonType.Button"
                  Size="ButtonSize.Small"
                  Variant="Variant.Text"
                  class="card-chrome-btn"
                  Title="@Context.Label"
                  AriaLabel="@Context.Label">
      <ChildContent>@Context.Icon</ChildContent>
    </RadzenButton>
}

@code {
    [Parameter, EditorRequired] public StackButtonContext Context { get; set; } = default!;
}
