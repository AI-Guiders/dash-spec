@namespace DashSpec.Plugin.Viz.RadzenUI.Components
@using System.Globalization
@using Radzen.Blazor
@using DashSpec.Execution.Runtime

@* ADR-0118: the Radzen stack's own selector/dates control — the date-domain role
   binds here instead of the flatpickr wrapper. Same wire surface as
   CultureAwareDateInput (Mode day | month | year; Value yyyy-MM-dd | yyyy-MM | yyyy;
   ValueChanged<string>): the swap is invisible to the grain logic above. The theme
   paints it — Radzen components follow the stack theme, no extra skin. *@

<RadzenDatePicker TValue="DateTime?"
                  Value="@Parsed"
                  Change="@OnChanged"
                  Culture="@Culture"
                  DateFormat="@Format"
                  ShowTime="false"
                  Min="@MinDate"
                  Max="@MaxDate"
                  Disabled="@Disabled"
                  @key="@($"{Mode}:{Value}")"
                  Style="@($"width:100%;{(InputClass.Contains("date-input-year") ? "min-width:5.5rem;" : null)}")"
                  class="@InputClass"
                  AriaLabel="@AriaLabel" />

@code {
    /// <summary>day | month | year — the date-domain selector modes (ADR-0118).</summary>
    [Parameter, EditorRequired] public string Mode { get; set; } = "day";

    /// <summary>Wire value: yyyy-MM-dd | yyyy-MM | yyyy (the shared wire, ADR-0118).</summary>
    [Parameter, EditorRequired] public string Value { get; set; } = string.Empty;

    [Parameter] public EventCallback<string> ValueChanged { get; set; }

    [Parameter] public bool Disabled { get; set; }

    [Parameter] public string InputClass { get; set; } = string.Empty;

    [Parameter] public string AriaLabel { get; set; } = string.Empty;

    private CultureInfo Culture => LabelFormat.ResolveReportCulture();

    private string Format => Mode switch
    {
        "month" => "yyyy-MM",
        "year" => "yyyy",
        _ => Culture.DateTimeFormat.ShortDatePattern,
    };

    private DateTime? Parsed
    {
        get
        {
            var formats = Mode switch
            {
                "month" => new[] { "yyyy-MM" },
                "year" => new[] { "yyyy" },
                _ => new[] { "yyyy-MM-dd" },
            };

            return DateTime.TryParseExact(
                Value.Trim(),
                formats,
                CultureInfo.InvariantCulture,
                DateTimeStyles.None,
                out var parsed)
                ? parsed
                : null;
        }
    }

    private DateTime? MinDate => Mode is "year" or "month" ? null : new DateTime(1970, 1, 1);

    private DateTime? MaxDate => Mode is "year" or "month" ? null : new DateTime(2100, 12, 31);

    private async Task OnChanged(DateTime? value)
    {
        if (value is null)
        {
            return;
        }

        var wire = Mode switch
        {
            "month" => value.Value.ToString("yyyy-MM", CultureInfo.InvariantCulture),
            "year" => value.Value.Year.ToString(CultureInfo.InvariantCulture),
            _ => DateValueCodec.FormatWireDay(DateOnly.FromDateTime(value.Value)),
        };

        await ValueChanged.InvokeAsync(wire);
    }
}
