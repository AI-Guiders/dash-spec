@namespace DashSpec.Plugin.Viz.RadzenUI.Components
@typeparam TItem
@using DashSpec.Plugin.Viz.RadzenUI.Resources
@using Microsoft.JSInterop
@inject IStringLocalizer<RadzenVizStrings> Loc
@inject IJSRuntime Js


@* The same table grid as before (ADR-0115/0107 chrome: header menu, copy, row click,
   LabelFormat cells) — ADR-0124 only changed the payload: rows arrive as CLR objects
   (compiled row types), so Radzen's native machinery works on real properties:
   sorting, filters, and its own grouping (drag the header into the panel). *@
@* The header stays Radzen's own (title, sort, filter menu icon live there — a custom
   HeaderTemplate would bury them); the column context menu rides the grid-level
   contextmenu event and resolves the column from the th[data-column-index]. *@
<RadzenDataGrid @ref="_grid" TItem="TItem" Data="@Items" data-testid="typed-grid"
                class="@GridCssClass"
                Wrap="true" Density="@GridDensity" Style="@GridStyle"
                AllowSorting="true" AllowFiltering="@ColumnFilters"
                FilterMode="@(Fields.Count <= 4 ? FilterMode.Simple : FilterMode.SimpleWithMenu)"
                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                AllowPaging="true" PageSize="@PageSize" AllowColumnResize="true"
                AllowColumnPicking="@(Fields.Count > 4)" AllowColumnReorder="true"
                AllowGrouping="@AllowGrouping" GroupIndent="16"
                RowClick="@OnRowClicked"
                RowRender="@OnRowRender">
    <GroupHeaderTemplate>
        <span class="rviz-typed-group">
            <strong>@(context.GroupDescriptor?.GetTitle() ?? ""):</strong> @(context.Data.Key?.ToString() ?? Loc["(empty)"])
            <span class="rviz-group-count">@(context.Data.Count)</span>
        </span>
    </GroupHeaderTemplate>
    <Columns>
        @for (var c = 0; c < Fields.Count; c++)
        {
            var index = c;
            @* A picked day filters that whole day — timestamp equality never matches
               (Radzen's built-in «равно» compares 00:00:00 against 18:25). A custom
               expression gives the [day, day+1) range; other columns keep the native
               operator menu. *@
            if (IsDateTimeColumn(index) && ColumnFilters)
            {
                <RadzenDataGridColumn TItem="TItem" Property="@Fields[index].Name"
                                      Title="@Fields[index].Header" TextAlign="@ColumnTextAlign(index)"
                                      CssClass="@ColumnCssClass(index)" HeaderCssClass="@ColumnCssClass(index)"
                                      Width="auto" Sortable="true" Filterable="true"
                                      Frozen="@(index < FrozenColumns)">
                    <HeaderTemplate>@HeaderFragment(index)</HeaderTemplate>
                    <FilterTemplate Context="column">
                        <RadzenDatePicker TValue="DateTime?" Value="@DateFilterOf(index)"
                                          Change="@(v => OnDateFilterChanged(column, index, v))"
                                          ShowTime="false" AllowClear="true"
                                          Style="width:100%" Placeholder="@Loc["Date"]" />
                    </FilterTemplate>
                    <Template Context="row">@CellFragment(row, index)</Template>
                </RadzenDataGridColumn>
            }
            else
            {
                <RadzenDataGridColumn TItem="TItem" Property="@Fields[index].Name"
                                      Title="@Fields[index].Header" TextAlign="@ColumnTextAlign(index)"
                                      CssClass="@ColumnCssClass(index)" HeaderCssClass="@ColumnCssClass(index)"
                                      Width="auto" Sortable="true" Filterable="@ColumnFilters"
                                      Frozen="@(index < FrozenColumns)">
                    <HeaderTemplate>@HeaderFragment(index)</HeaderTemplate>
                    <Template Context="row">@CellFragment(row, index)</Template>
                </RadzenDataGridColumn>
            }
        }
    </Columns>
</RadzenDataGrid>

<RadzenContextMenu @ref="_columnMenu" />

@code {
    /// <summary>Column header with inline copy-column icon button (ADR-0115 §4):
    /// stopPropagation prevents triggering column sort when clicking the copy glyph.</summary>
    private RenderFragment HeaderFragment(int index) => __builder =>
    {
        var copied = _copiedColumn == index;
        var title = copied ? Loc["Copied"].Value : Loc["Copy column"].Value;
        <span class="rviz-grid-head" @oncontextmenu="args => OpenColumnMenu(args, index)" @oncontextmenu:preventDefault="true">
            <span class="rviz-grid-head-text">@Fields[index].Header</span>
            <button type="button"
                    class="rviz-grid-copy @(copied ? "rviz-grid-copy--done" : null)"
                    title="@title"
                    aria-label="@title"
                    @onclick="() => CopyColumnAsync(index)"
                    @onclick:stopPropagation="true">
                @if (copied)
                {
                    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="3 8.5 6.5 12 13 4.5" />
                    </svg>
                }
                else
                {
                    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="5.5" y="5.5" width="8" height="8" rx="1.5" />
                        <path d="M10.5 5.5V3.5A1.5 1.5 0 0 0 9 2H3.5A1.5 1.5 0 0 0 2 3.5V9a1.5 1.5 0 0 0 1.5 1.5h2" />
                    </svg>
                }
            </button>
        </span>
    };

    /// <summary>The cell body: formatted value + the column context menu (the column
    /// index is known at render time — no DOM round-trip).</summary>
    private RenderFragment CellFragment(TItem row, int index) => __builder =>
    {
        var text = FormatCell(PropertyOf(row, index), index);
        <div class="rviz-cell" title="@text" @oncontextmenu="args => OpenColumnMenu(args, index)"
             @oncontextmenu:preventDefault="true">@text</div>
    };
}
