@namespace DashSpec.Plugin.Viz.RadzenUI.Components
@using Radzen.Blazor
@using DashSpec.Viz

@* ADR-0112: the Radzen stack's card view-switcher — ONE RadzenDropDown over the
   card's views (Id/Label), the theme paints it. Surface: StackViewSwitchContext. *@

<RadzenDropDown TValue="string"
                Data="@Context.Views"
                TextProperty="Label"
                ValueProperty="Id"
                Value="@Context.Active"
                Change="@(v => OnChanged(v as string ?? string.Empty))"
                AllowClear="false"
                AllowFiltering="@(Context.Views.Count > 6)"
                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                Disabled="@Context.Disabled"
                Name="@Context.AriaLabel"
                Style="width:auto;min-width:7.5rem;"
                AriaLabel="@Context.AriaLabel" />

@code {
    [Parameter, EditorRequired] public StackViewSwitchContext Context { get; set; } = default!;

    private async Task OnChanged(string id)
    {
        if (!string.IsNullOrWhiteSpace(id) && Context.ActiveChanged.HasDelegate)
        {
            await Context.ActiveChanged.InvokeAsync(id);
        }
    }
}
