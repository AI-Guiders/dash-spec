@namespace DashSpec.Plugin.Viz.RadzenUI.Components
@using Radzen.Blazor
@using DashSpec.Viz

@* ADR-0112: the Radzen stack's card view-switcher — ONE RadzenDropDown over the
   card's views (Id/Label), the theme paints it. Surface: Views, Active,
   ActiveChanged<string>, Disabled, AriaLabel. *@

<RadzenDropDown TValue="string"
                Data="@Views"
                TextProperty="Label"
                ValueProperty="Id"
                Value="@Active"
                Change="@(v => OnChanged(v as string ?? string.Empty))"
                AllowClear="false"
                AllowFiltering="@(Views.Count > 6)"
                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                Disabled="@Disabled"
                Name="@AriaLabel"
                Style="width:auto;min-width:7.5rem;"
                AriaLabel="@AriaLabel" />

@code {
    [Parameter, EditorRequired] public IReadOnlyList<CardViewOption> Views { get; set; } = [];

    [Parameter, EditorRequired] public string Active { get; set; } = string.Empty;

    [Parameter] public EventCallback<string> ActiveChanged { get; set; }

    [Parameter] public bool Disabled { get; set; }

    [Parameter] public string AriaLabel { get; set; } = string.Empty;

    private async Task OnChanged(string id)
    {
        if (!string.IsNullOrWhiteSpace(id) && ActiveChanged.HasDelegate)
        {
            await ActiveChanged.InvokeAsync(id);
        }
    }
}
