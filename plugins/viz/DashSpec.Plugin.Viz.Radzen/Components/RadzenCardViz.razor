@namespace DashSpec.Plugin.Viz.RadzenUI.Components
@using DashSpec.Abstractions.Viz
@using DashSpec.Plugin.Viz.RadzenUI.Resources
@inject IStringLocalizer<RadzenVizStrings> Loc

@* Radzen visual layer pilot ([ADR-0111]): every data family through Radzen — 100% native C#,
   no JS interop of our own. One component for the whole family set: charts (line/area/bar/
   pie/donut/scatter) inside RadzenChart, heatmap/tables/gantt as standalone Radzen pieces.
   Emptiness is per family — a heatmap card has no Chart payload, a chart card has no Matrix.
   The render is a vertical slice (ADR-0077): rviz-* classes live in this plugin's css,
   the copy rides RadzenVizStrings — the renderer owns the whole render. *@

@if (IsEmptyForFamily)
{
    <p class="rviz-empty-state">@Loc["No data for the selected period"]</p>
}
else if (IsChartFamily)
{
    <div class="rviz-chart-wrap rviz-chart-wrap--fixed">
        <RadzenChart Style="height:100%" TItem="RadzenPoint">
            @switch (DiagramKind)
            {
                case "bar":
                case "histogram":
                    @if (IsHorizontal)
                    {
                        @foreach (var series in Chart.Series)
                        {
                            <RadzenBarSeries TItem="RadzenPoint"
                                             Data="PointsOf(series)"
                                             CategoryProperty="Label"
                                             ValueProperty="Value"
                                             Title="@SeriesTitle(series)"
                                             Fill="@SeriesColor(series)" />
                        }
                    }
                    else
                    {
                        @foreach (var series in Chart.Series)
                        {
                            <RadzenColumnSeries TItem="RadzenPoint"
                                                Data="PointsOf(series)"
                                                CategoryProperty="Label"
                                                ValueProperty="Value"
                                                Title="@SeriesTitle(series)"
                                                Fill="@SeriesColor(series)" />
                        }
                    }
                    <RadzenCategoryAxis />
                    <RadzenValueAxis />
                    break;
                case "pie":
                    <RadzenPieSeries TItem="RadzenPoint"
                                     Data="PointsOf(FirstSeries)"
                                     CategoryProperty="Label"
                                     ValueProperty="Value"
                                     Title="@FirstSeries.Name" />
                    break;
                case "donut":
                case "doughnut":
                    <RadzenDonutSeries TItem="RadzenPoint"
                                       Data="PointsOf(FirstSeries)"
                                       CategoryProperty="Label"
                                       ValueProperty="Value"
                                       Title="@FirstSeries.Name" />
                    break;
                case "scatter":
                    <RadzenScatterSeries TItem="RadzenPoint"
                                          Data="PointsOf(FirstSeries)"
                                          CategoryProperty="Label"
                                          ValueProperty="Value"
                                          Title="@FirstSeries.Name" />
                    <RadzenCategoryAxis />
                    <RadzenValueAxis />
                    break;
                case "area":
                    @foreach (var series in Chart.Series)
                    {
                        <RadzenAreaSeries TItem="RadzenPoint"
                                          Data="PointsOf(series)"
                                          CategoryProperty="Label"
                                          ValueProperty="Value"
                                          Title="@SeriesTitle(series)"
                                          Fill="@SeriesColor(series)" />
                    }
                    <RadzenCategoryAxis />
                    <RadzenValueAxis />
                    break;
                default:
                    @foreach (var series in Chart.Series)
                    {
                        <RadzenLineSeries TItem="RadzenPoint"
                                          Data="PointsOf(series)"
                                          CategoryProperty="Label"
                                          ValueProperty="Value"
                                          Title="@SeriesTitle(series)"
                                          Stroke="@SeriesColor(series)" />
                    }
                    <RadzenCategoryAxis />
                    <RadzenValueAxis />
                    break;
            }
        </RadzenChart>
    </div>
}
else
{
    <div class="rviz-chart-wrap @(NeedsFixedHeight ? "rviz-chart-wrap--fixed" : null)">
        @switch (DiagramKind)
        {
            case "heatmap":
                @* Kind heatmap is native to the Radzen stack (ADR-0112): the square
                   heatmap draws the matrix payload — row-normalized colors, tooltips,
                   cell drill-down ride the same contracts as the builtin heatmap. *@
                <RadzenSquareHeatmap Matrix="@Matrix"
                                     Presentation="@Context.Card.MatrixPresentation"
                                     Limits="@Context.Card.MatrixLimits"
                                     OnCellSelected="@Context.OnHeatmapCellSelected"
                                     OnCategoryItemSelected="@Context.OnHeatmapCategoryItemSelected"
                                     Style="width:100%;height:100%" />
                break;
            case "gantt":
            case "gantt_timeline":
                <RadzenGantt TItem="GanttTask" Data="@GanttTasks"
                             TextProperty="Text" StartProperty="Start" EndProperty="End"
                             Style="width:100%;height:100%" />
                break;
            case "table":
            case "browse":
                @* Radzen v12: columns live in the <Columns> template (the default ChildContent
                   is never rendered). Sort/filter/pager are Radzen's own — LoadData mode maps
                   them onto the typed dataset; columns bind by the field's wire Name. *@
                <RadzenDataGrid TItem="RadzenRow" Data="@GridRows" Count="@GridCount"
                                LoadData="@OnGridLoadData"
                                AllowSorting="true" AllowFiltering="@(ColumnFilters)" FilterMode="FilterMode.Simple"
                                AllowPaging="true" PageSize="@GridPageSize" AllowColumnResize="true"
                                RowClick="@OnRowClicked"
                                Wrap="true" Density="Density.Compact" Style="width:100%">
                    <Columns>
                        @for (var c = 0; c < Table.Fields.Count; c++)
                        {
                            var index = c;
                            <RadzenDataGridColumn TItem="RadzenRow" Property="@Table.Fields[index].Name"
                                                  Title="@Table.Fields[index].Header" TextAlign="@ColumnTextAlign(index)"
                                                  Width="auto" Sortable="true" Filterable="@ColumnFilters">
                                <Template Context="row">@FormatCell(row.Cells[index], index)</Template>
                            </RadzenDataGridColumn>
                        }
                    </Columns>
                </RadzenDataGrid>
                break;
        }
    </div>
}

@code {
    [Parameter, EditorRequired]
    public CardVizRenderContext Context { get; set; } = default!;

    private string DiagramKind =>
        (Context.EffectiveCard.DiagramKind ?? "line").ToLowerInvariant();

    private bool IsChartFamily =>
        DiagramKind is not ("heatmap" or "table" or "browse" or "gantt" or "gantt_timeline");

    /// <summary>Heatmap and gantt measure their container at first render — a zero-height host
    /// bakes a zero viewBox (SVG cells flat, the card looks empty). Tables size themselves.</summary>
    private bool NeedsFixedHeight =>
        DiagramKind is "heatmap" or "gantt" or "gantt_timeline";

    /// <summary>Emptiness per family: a heatmap card has no Chart, a chart card has no Matrix.
    /// The square heatmap handles its own all-empty-cells and oversize states.</summary>
    private bool IsEmptyForFamily => DiagramKind switch
    {
        "heatmap" => Context.EffectiveCard.Matrix is null,
        "table" or "browse" => Context.EffectiveCard.Table is null || Table.Rows.Count == 0,
        "gantt" or "gantt_timeline" => Context.EffectiveCard.Gantt is null || Gantt.Rows.Count == 0,
        _ => Context.EffectiveCard.Chart is null || IsEmpty(Context.EffectiveCard.Chart),
    };

    /// <summary>Horizontal bars (bar/histogram): RadzenBarSeries vs the default vertical columns.</summary>
    private bool IsHorizontal =>
        Context.EffectiveCard.ChartPresentation?.Orientation == ChartOrientation.Horizontal;

    private ChartSeries FirstSeries => Chart.Series[0];

    private ChartPayload Chart => Context.EffectiveCard.Chart!;

    private TablePayload Table => Context.EffectiveCard.Table!;

    private MatrixPayload Matrix => Context.EffectiveCard.Matrix!;

    private GanttPayload Gantt => Context.EffectiveCard.Gantt!;

    /// <summary>Gantt segments as flat Radzen tasks: one task per segment (Text = the row label).</summary>
    private IReadOnlyList<GanttTask> GanttTasks =>
        Gantt.Rows
            .SelectMany(row => row.Segments.Select(segment => new GanttTask(row.Label, segment.Start, segment.End)))
            .ToList();

    /// <summary>Radzen's own sort/filter/pager over the typed dataset (LoadData mode):
    /// the grid supplies the UX; sorting keys off the wire kind, display text comes from
    /// LabelFormat with the report defaults carried on the render result (ADR-0079 §3).</summary>
    private const int GridPageSize = 15;

    private IReadOnlyList<RadzenRow> _gridRows = [];

    private int _gridCount;

    private IReadOnlyList<RadzenRow> GridRows => _gridRows;

    private int GridCount => _gridCount;

    private bool ColumnFilters => Context.Card.TablePresentation?.ColumnFilters ?? true;

    private ReportFormatDefaults? FormatDefaults => Context.Card.FormatDefaults;

    private string FormatCell(DashValue cell, int fieldIndex)
    {
        var field = Table.Fields[fieldIndex];
        return LabelFormat.FormatObject(cell.ToClr(), field.Format, FormatDefaults);
    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        SeedGrid();
    }

    private void SeedGrid()
    {
        // OnParametersSet runs during the Loading phase too — the table payload arrives later.
        if (Context.EffectiveCard.Table is not { } table)
        {
            _gridRows = [];
            _gridCount = 0;
            return;
        }

        _gridCount = table.Rows.Count;
        _gridRows = table.Rows
            .Take(GridPageSize)
            .Select(row => new RadzenRow(row))
            .ToList();
    }

    private void OnGridLoadData(LoadDataArgs args)
    {
        IEnumerable<DashValue[]> rows = Table.Rows;

        if (args.Filters is { } filters)
        {
            foreach (var filter in filters)
            {
                var index = FieldIndexOf(filter.Property);
                var needle = filter.FilterValue?.ToString();
                if (index < 0 || string.IsNullOrWhiteSpace(needle))
                {
                    continue;
                }

                rows = rows.Where(row =>
                    DisplayCell(row, index).Contains(needle, StringComparison.OrdinalIgnoreCase));
            }
        }

        _gridCount = rows.Count();

        if (!string.IsNullOrWhiteSpace(args.OrderBy))
        {
            var sort = args.OrderBy.Trim().Split(' ');
            var index = FieldIndexOf(sort[0]);
            if (index >= 0)
            {
                var descending = sort.Length > 1 &&
                    sort[1].StartsWith("desc", StringComparison.OrdinalIgnoreCase);
                var kind = Table.Fields[index].Kind;
                rows = descending
                    ? rows.OrderByDescending(row => SortKey(row[index], kind), NullsFirst)
                    : rows.OrderBy(row => SortKey(row[index], kind), NullsFirst);
            }
        }

        _gridRows = rows
            .Skip(args.Skip ?? 0)
            .Take(args.Top ?? GridPageSize)
            .Select(row => new RadzenRow(row))
            .ToList();
    }

    private int FieldIndexOf(string? name)
    {
        for (var i = 0; i < Table.Fields.Count; i++)
        {
            if (string.Equals(Table.Fields[i].Name, name, StringComparison.OrdinalIgnoreCase))
            {
                return i;
            }
        }

        return -1;
    }

    /// <summary>ADR-0107 row click: the card declares a `row`-sourced handler → rows are
    /// clickable; the first column's formatted value rides YLabel — the same contract as
    /// the builtin table (value-based, a re-render can't make it stale).</summary>
    private bool RowClickEnabled =>
        Context.EffectiveCard.ClickHandlers is { Count: > 0 } handlers &&
        handlers.Any(h => string.Equals(h.Source, TableClickSources.Row, StringComparison.OrdinalIgnoreCase));

    private async Task OnRowClicked(DataGridRowMouseEventArgs<RadzenRow> args)
    {
        if (!RowClickEnabled || args.Data is not { } row || !Context.OnHeatmapCategoryItemSelected.HasDelegate)
        {
            return;
        }

        var context = new HeatmapCellContext(
            -1,
            -1,
            string.Empty,
            FormatCell(row.Cells[0], 0),
            null,
            null,
            null,
            TableClickSources.Row);

        await Context.OnHeatmapCategoryItemSelected.InvokeAsync(context);
    }

    /// <summary>Display text for filter matching — the same string the cell renders,
    /// so what the user sees is what the filter matches.</summary>
    private string DisplayCell(DashValue[] row, int index) => FormatCell(row[index], index);

    /// <summary>Typed sort keys (ADR-0079 §3): numbers order numerically, dates
    /// chronologically — the wire kind, not the display string, decides the order.</summary>
    private static IComparable? SortKey(DashValue cell, DashPrimitiveKind kind) => cell.IsNull
        ? null
        : kind switch
        {
            DashPrimitiveKind.Int => cell.AsInt32(),
            DashPrimitiveKind.Decimal => cell.AsDecimal(),
            DashPrimitiveKind.Date => cell.AsDate(),
            DashPrimitiveKind.DateTime => cell.AsDateTimeUtc(),
            DashPrimitiveKind.Duration => cell.AsDuration(),
            DashPrimitiveKind.Time => cell.AsTime(),
            DashPrimitiveKind.Bool => cell.AsBool(),
            _ => cell.AsString(),
        };

    private static readonly Comparer<object?> NullsFirst = Comparer<object?>.Create((a, b) =>
        a is null ? (b is null ? 0 : -1) : b is null ? 1 : ((IComparable)a).CompareTo(b));

    private TextAlign ColumnTextAlign(int index) =>
        Table.Fields[index].Alignment switch
        {
            "right" => TextAlign.Right,
            "center" => TextAlign.Center,
            _ => TextAlign.Left,
        };

    private static bool IsEmpty(ChartPayload chart) =>
        chart.Points is { Count: > 0 }
            ? false
            : chart.Labels.Count == 0;

    private IReadOnlyList<RadzenPoint> PointsOf(ChartSeries series) =>
        Chart.Labels
            .Select((label, index) => new RadzenPoint(label, series.Values[index] ?? 0))
            .ToList();

    /// <summary>
    /// Legend title: the payload builder names an unnamed series "default" — a single-series
    /// bar carries no legend entry, a real series split carries its name.
    /// </summary>
    private static string? SeriesTitle(ChartSeries series) =>
        string.IsNullOrWhiteSpace(series.Name) || series.Name.Equals("default", StringComparison.OrdinalIgnoreCase)
            ? null
            : series.Name;

    /// <summary>The series color from our palette (ChartSeries.Color) — Radzen never picks for us.</summary>
    private static string? SeriesColor(ChartSeries series) =>
        string.IsNullOrWhiteSpace(series.Color) ? null : series.Color;

    /// <summary>
    /// One chart point as Radzen sees it: category label + value.
    /// Value must stay non-nullable: Radzen compiles ValueProperty into a getter
    /// that unwraps Nullable&lt;double&gt;.Value — the first null point kills the circuit
    /// on a legend/tooltip hit (FindClosestSeries: "Nullable object must have a value").
    /// A payload null (empty bucket) maps to 0, same as the builtin canvas value axis
    /// (charts.js counts null as 0).
    /// </summary>
    public sealed record RadzenPoint(string Label, double Value);

    /// <summary>One table row as Radzen sees it: the typed cells by field order.</summary>
    public sealed record RadzenRow(DashValue[] Cells);

    /// <summary>One gantt task as Radzen sees it: text + start/end.</summary>
    public sealed record GanttTask(string Text, DateTime Start, DateTime End);
}
