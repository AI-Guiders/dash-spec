@namespace DashSpec.Plugin.Viz.RadzenUI.Components
@using DashSpec.Presentation.Components
@using DashSpec.Abstractions.Viz
@using DashSpec.Core.Interaction
@using DashSpec.Abstractions.Plugins
@using DashSpec.Plugin.Viz.RadzenUI.Resources
@using Microsoft.JSInterop
@inject DashSpec.Viz.IOnClickInteractionService Interactions
@inject IStringLocalizer<RadzenVizStrings> Loc
@inject ICardVizDisplayState VizDisplayState
@inject IJSRuntime Js

@* Radzen visual layer pilot ([ADR-0111]): every data family through Radzen — 100% native C#,
   no JS interop of our own. One component for the whole family set: charts (line/area/bar/
   pie/donut/scatter) inside RadzenChart, heatmap/tables/gantt as standalone Radzen pieces.
   Emptiness is per family — a heatmap card has no Chart payload, a chart card has no Matrix.
   The render is a vertical slice (ADR-0077): rviz-* classes live in this plugin's css,
   the copy rides RadzenVizStrings — the renderer owns the whole render. *@

@if (IsNumberFamily)
{
    @* KPI number (ADR-0112: Radzen speaks it natively): a percent rides a RadialGauge
       with traffic ranges, everything else (counts, dates) is a value tile. The value
       text is the resolver's formatted Number — one formatting path for every stack. *@
    <div class="rviz-kpi @(IsPercentGauge ? "rviz-kpi--gauge" : "rviz-kpi--tile")">
        @if (IsPercentGauge)
        {
            <RadzenRadialGauge Style="width:100%;height:120px">
                <RadzenRadialGaugeScale Min="0" Max="100" StartAngle="-120" EndAngle="120" Step="25" TickPosition="GaugeTickPosition.Inside">
                    <RadzenRadialGaugeScalePointer Value="@GaugeValue" Length="0.62" ShowValue="false" />
                    <RadzenRadialGaugeScaleRange From="0" To="50" Fill="var(--rz-success)" />
                    <RadzenRadialGaugeScaleRange From="50" To="80" Fill="var(--rz-warning)" />
                    <RadzenRadialGaugeScaleRange From="80" To="100" Fill="var(--rz-danger)" />
                </RadzenRadialGaugeScale>
            </RadzenRadialGauge>
        }
        <div class="rviz-kpi-value" data-testid="kpi-@Context.EffectiveCard.Id">@NumberText</div>
    </div>
}
else if (IsEmptyForFamily)
{
    @* ADR-0106 when-table: the author's wording for an empty result beats the generic
       string — an empty over-limit top is a good result, not missing data. *@
    @if (!string.IsNullOrWhiteSpace(EmptyMessage))
    {
        <p class="rviz-empty-state"><RichTextView Text="@EmptyMessage" /></p>
    }
    else
    {
        <p class="rviz-empty-state">@Loc["No data for the selected period"]</p>
    }
}
else if (IsChartFamily)
{
    <div class="rviz-chart-wrap rviz-chart-wrap--fixed" style="@ChartWrapStyle" data-testid="scroll-viz-@Context.EffectiveCard.Id">
        @* The legend is a pie's only label surface (Radzen lists category labels for a pie
           series there — chartjs parity: slices are named in the legend, never on the chart).
           Categorical charts show it for real multi-series splits only — a single-series
           legend would just restate the axis labels, the chartjs renderer hid it too. *@
        <RadzenChart Style="height:100%" TItem="RadzenPoint" SeriesClick="OnSeriesClick">
            <RadzenLegend Visible="@LegendVisible" Position="LegendPosition.Bottom" />
            @switch (DiagramKind)
            {
                case "bar":
                case "histogram":
                    @if (IsHorizontal)
                    {
                        @foreach (var series in Chart.Series)
                        {
                            <RadzenBarSeries TItem="RadzenPoint"
                                             Data="PointsOf(series)"
                                             CategoryProperty="Label"
                                             ValueProperty="Value"
                                             Title="@SeriesTitle(series)"
                                             Fill="@SeriesColor(series)"
                                             Fills="@series.PointColors" />
                        }
                    }
                    else
                    {
                        @foreach (var series in Chart.Series)
                        {
                            <RadzenColumnSeries TItem="RadzenPoint"
                                                Data="PointsOf(series)"
                                                CategoryProperty="Label"
                                                ValueProperty="Value"
                                                Title="@SeriesTitle(series)"
                                                Fill="@SeriesColor(series)"
                                                Fills="@series.PointColors" />
                        }
                    }
                    <RadzenCategoryAxis LabelFit="CategoryAxisLabelFit.Auto" />
                    <RadzenValueAxis />
                    break;
                case "pie":
                    <RadzenPieSeries TItem="RadzenPoint"
                                     Data="PointsOf(FirstSeries)"
                                     CategoryProperty="Label"
                                     ValueProperty="Value"
                                     Fills="@FirstSeries.PointColors"
                                     Title="@SeriesTitle(FirstSeries)" />
                    break;
                case "donut":
                case "doughnut":
                    <RadzenDonutSeries TItem="RadzenPoint"
                                       Data="PointsOf(FirstSeries)"
                                       CategoryProperty="Label"
                                       ValueProperty="Value"
                                       Fills="@FirstSeries.PointColors"
                                       Title="@SeriesTitle(FirstSeries)" />
                    break;
                case "scatter":
                    <RadzenScatterSeries TItem="RadzenPoint"
                                          Data="PointsOf(FirstSeries)"
                                          CategoryProperty="Label"
                                          ValueProperty="Value"
                                          Title="@FirstSeries.Name" />
                    <RadzenCategoryAxis LabelFit="CategoryAxisLabelFit.Auto" />
                    <RadzenValueAxis />
                    break;
                case "area":
                    @foreach (var series in Chart.Series)
                    {
                        <RadzenAreaSeries TItem="RadzenPoint"
                                          Data="PointsOf(series)"
                                          CategoryProperty="Label"
                                          ValueProperty="Value"
                                          Title="@SeriesTitle(series)"
                                          Fill="@SeriesColor(series)" />
                    }
                    <RadzenCategoryAxis LabelFit="CategoryAxisLabelFit.Auto" />
                    <RadzenValueAxis />
                    break;
                default:
                    @foreach (var series in Chart.Series)
                    {
                        <RadzenLineSeries TItem="RadzenPoint"
                                          Data="PointsOf(series)"
                                          CategoryProperty="Label"
                                          ValueProperty="Value"
                                          Title="@SeriesTitle(series)"
                                          Stroke="@SeriesColor(series)" />
                    }
                    <RadzenCategoryAxis LabelFit="CategoryAxisLabelFit.Auto" />
                    <RadzenValueAxis />
                    break;
            }
        </RadzenChart>
    </div>
}
else
{
    <div class="rviz-chart-wrap @((NeedsFixedHeight && !MatrixFill) ? "rviz-chart-wrap--fixed" : null) @(MatrixFill ? "rviz-chart-wrap--fill" : null)"
         style="@MatrixWrapStyle" data-testid="scroll-viz-@Context.EffectiveCard.Id">
        @switch (DiagramKind)
        {
            @* Kind heatmap no longer routes here: the stack delegates it to the ECharts
               guest (KindPlugins, ADR-0112) — this switch only sees kinds the Radzen
               stack owns natively. *@
            case "gantt":
            case "gantt_timeline":
                <RadzenGantt TItem="GanttTask" Data="@GanttTasks"
                             TextProperty="Text" StartProperty="Start" EndProperty="End"
                             Style="width:100%;height:100%" />
                break;
            case "table":
            case "browse":
                @* ADR-0124: the conveyor materializes compiled CLR row types — one path, the
                   native grid on real properties (sorting, filters, Radzen's own grouping).
                   The renderer resolves nothing: the payload carries the typed rows + Type. *@
                {
                    var typedComponent = typeof(TypedTableGrid<>).MakeGenericType(
                        Table.RowType ?? throw new InvalidOperationException(
                            $"Card '{Context.EffectiveCard.Id}': table payload has no compiled row type — run `dsc build types` next to the catalog."));
                    <DynamicComponent Type="@typedComponent" Parameters="TypedGridParameters()" />
                }
                break;
        }
    </div>
}



@code {
    [Parameter, EditorRequired]
    public CardVizRenderContext Context { get; set; } = default!;

    private string DiagramKind =>
        (Context.EffectiveCard.DiagramKind ?? "line").ToLowerInvariant();

    private bool IsChartFamily =>
        DiagramKind is not ("heatmap" or "table" or "browse" or "gantt" or "gantt_timeline");

    /// <summary>Heatmap and gantt measure their container at first render — a zero-height host
    /// bakes a zero viewBox (SVG cells flat, the card looks empty). Tables size themselves.</summary>
    private bool NeedsFixedHeight =>
        DiagramKind is "heatmap" or "gantt" or "gantt_timeline";

    /// <summary>Emptiness per family: a heatmap card has no Chart, a chart card has no Matrix.
    /// The square heatmap handles its own all-empty-cells and oversize states.</summary>
    private bool IsEmptyForFamily => DiagramKind switch
    {
        "number" => string.IsNullOrWhiteSpace(NumberText),
        "heatmap" => Context.EffectiveCard.Matrix is null,
        "table" or "browse" => Context.EffectiveCard.Table is null || Table.Rows.Count == 0,
        "gantt" or "gantt_timeline" => Context.EffectiveCard.Gantt is null || Gantt.Rows.Count == 0,
        _ => Context.EffectiveCard.Chart is null || IsEmpty(Context.EffectiveCard.Chart),
    };

    /// <summary>KPI number family: the resolver's formatted value (scalar payload).</summary>
    private bool IsNumberFamily => DiagramKind == "number";

    private string? NumberText => Context.EffectiveCard.Number;

    /// <summary><c>when | no data | message |</c> — the author's empty-state wording.</summary>
    private string? EmptyMessage => Context.EffectiveCard.EmptyMessage;

    /// <summary><c>scale_value = percent</c> numbers ride a radial gauge (0..100 traffic).</summary>
    private bool IsPercentGauge =>
        string.Equals(Context.EffectiveCard.NumberScale, "percent", StringComparison.OrdinalIgnoreCase);

    private double GaugeValue =>
        double.TryParse((NumberText ?? "0").Replace(',', '.').TrimEnd('%'), System.Globalization.CultureInfo.InvariantCulture, out var v)
            ? Math.Clamp(v, 0, 100)
            : 0;

    /// <summary>Horizontal bars (bar/histogram): RadzenBarSeries vs the default vertical columns.</summary>
    private bool IsHorizontal =>
        Context.EffectiveCard.ChartPresentation?.Orientation == ChartOrientation.Horizontal;

    /// <summary>Pie/donut: the bottom legend carries the category labels — the only label
    /// surface Radzen gives a pie series. Other families: real multi-series splits only.</summary>
    private bool LegendVisible
    {
        get
        {
            var legendOverride = VizDisplayState.GetLegendOverride(Context.ResolveVizStateCardId());
            return legendOverride ?? (DiagramKind is "pie" or "donut" or "doughnut" || Chart.Series.Count > 1);
        }
    }

    /// <summary>Card-authored chart height (chartjs parity): the presentation height on the
    /// board, expanded in the detail view so rotated axis labels keep their room.</summary>
    private string ChartWrapStyle => ChartHeightStyle.Resolve(Context.Card, Context.DetailView);

    /// <summary>stretch_mode = fill (matrix): the wrap stops capping at the fixed px height
    /// and takes the slot; the heatmap inside owns its own floor/cap.</summary>
    private bool MatrixFill =>
        DiagramKind is "heatmap" &&
        Context.EffectiveCard.MatrixPresentation is { StretchMode: VizStretchMode.Fill };

    private string MatrixWrapStyle => MatrixFill ? "height:100%;" : string.Empty;

    /// <summary>ADR-0107 category click: a series point click rides the same contract as the
    /// builtin chartjs renderer — gated on the card declaring effects for its click.</summary>
    private bool CategoryClickEnabled =>
        Context.OnHeatmapCellSelected.HasDelegate &&
        Context.EffectiveCard.ClickBehaviour is not null &&
        (Interactions.HasNavigationEffects(Context.EffectiveCard.ClickBehaviour) ||
         Interactions.ResolveShowEffect(Context.EffectiveCard.ClickBehaviour) is not null);

    private async Task OnSeriesClick(SeriesClickEventArgs args)
    {
        if (!CategoryClickEnabled || args.Data is not RadzenPoint point)
        {
            return;
        }

        var index = -1;
        for (var i = 0; i < Chart.Labels.Count; i++)
        {
            if (string.Equals(Chart.Labels[i], point.Label, StringComparison.Ordinal))
            {
                index = i;
                break;
            }
        }

        // Category label satisfies both `from x` and `from y` (horizontal bar vs vertical/donut).
        var context = new HeatmapCellContext(
            index,
            index,
            point.Label,
            point.Label,
            null,
            null);

        await Context.OnHeatmapCellSelected.InvokeAsync(context);
    }

    private ChartSeries FirstSeries => Chart.Series[0];

    private ChartPayload Chart => Context.EffectiveCard.Chart!;

    private TablePayload Table => Context.EffectiveCard.Table!;

    private MatrixPayload Matrix => Context.EffectiveCard.Matrix!;

    private GanttPayload Gantt => Context.EffectiveCard.Gantt!;

    /// <summary>Gantt segments as flat Radzen tasks: one task per segment (Text = the row label).</summary>
    private IReadOnlyList<GanttTask> GanttTasks =>
        Gantt.Rows
            .SelectMany(row => row.Segments.Select(segment => new GanttTask(row.Label, segment.Start, segment.End)))
            .ToList();


    /// <summary>Author intent (ADR-0115 §2): keep the first N columns pinned during
    /// horizontal scroll — <c>frozen_columns</c> in the presentation block. The self-made
    /// table ignores the key; the Radzen grid honors it per column.</summary>
    private int FrozenColumns => Context.Card.TablePresentation?.FrozenColumns ?? 0;


    private bool ColumnFilters => Context.Card.TablePresentation?.ColumnFilters ?? true;


    private Dictionary<string, object?> TypedGridParameters() => new()
    {
        ["Fields"] = Table.Fields,
        ["Items"] = Table.TypedItems,
        ["ColumnFilters"] = ColumnFilters,
        ["FrozenColumns"] = FrozenColumns,
        ["FormatDefaults"] = Context.Card.FormatDefaults,
        ["RowClickEnabled"] = RowClickEnabled,
        ["OnRowClick"] = EventCallback.Factory.Create<string>(this, OnTableRowClicked),
    };

    /// <summary>ADR-0107 row click: the card declares a `row`-sourced handler → rows are
    /// clickable; the first column's formatted value rides YLabel — the same contract as
    /// the builtin table (value-based, a re-render can't make it stale).</summary>
    private bool RowClickEnabled =>
        Context.EffectiveCard.ClickHandlers is { Count: > 0 } handlers &&
        handlers.Any(h => string.Equals(h.Source, TableClickSources.Row, StringComparison.OrdinalIgnoreCase));

    private async Task OnTableRowClicked(string value)
    {
        if (!Context.OnHeatmapCategoryItemSelected.HasDelegate)
        {
            return;
        }

        var context = new HeatmapCellContext(
            -1,
            -1,
            string.Empty,
            value,
            null,
            null,
            null,
            ClickSource: TableClickSources.Row);

        await Context.OnHeatmapCategoryItemSelected.InvokeAsync(context);
    }

    private static bool IsEmpty(ChartPayload chart) =>
        chart.Points is { Count: > 0 }
            ? false
            : chart.Labels.Count == 0;

    private IReadOnlyList<RadzenPoint> PointsOf(ChartSeries series) =>
        Chart.Labels
            .Select((label, index) => new RadzenPoint(label, series.Values[index] ?? 0))
            .ToList();

    /// <summary>
    /// Legend title: the payload builder names an unnamed series "default" — a single-series
    /// bar carries no legend entry, a real series split carries its name.
    /// </summary>
    private static string? SeriesTitle(ChartSeries series) =>
        string.IsNullOrWhiteSpace(series.Name) || series.Name.Equals("default", StringComparison.OrdinalIgnoreCase)
            ? null
            : series.Name;

    /// <summary>The series color from our palette (ChartSeries.Color) — Radzen never picks for us.</summary>
    private static string? SeriesColor(ChartSeries series) =>
        string.IsNullOrWhiteSpace(series.Color) ? null : series.Color;

    /// <summary>
    /// One chart point as Radzen sees it: category label + value.
    /// Value must stay non-nullable: Radzen compiles ValueProperty into a getter
    /// that unwraps Nullable&lt;double&gt;.Value — the first null point kills the circuit
    /// on a legend/tooltip hit (FindClosestSeries: "Nullable object must have a value").
    /// A payload null (empty bucket) maps to 0, same as the builtin canvas value axis
    /// (charts.js counts null as 0).
    /// </summary>
    public sealed record RadzenPoint(string Label, double Value);

    /// <summary>One gantt task as Radzen sees it: text + start/end.</summary>
    public sealed record GanttTask(string Text, DateTime Start, DateTime End);
}
