@namespace DashSpec.Plugin.Viz.RadzenUI.Components
@using DashSpec.Abstractions.Plugins
@using DashSpec.Execution.Runtime
@using DashSpec.Plugin.Viz.Builtins.Components.MatrixCanvas
@using DashSpec.Plugin.Viz.RadzenUI.Resources
@using DashSpec.Viz

@* Square-cell heatmap over the matrix payload (ADR-0112: kind heatmap is native to the
   Radzen stack). Cells stay square via CSS aspect-ratio — the grid fills the card width
   and scrolls when the rows outrun the card height. The payload features — row/column
   color normalization, per-cell tooltips, X bucket instants, drill-down clicks — ride the
   same contracts as the builtin heatmap (ADR-0107). Colors come from HeatmapColorScale,
   chrome text/borders from rviz-* CSS variables — the stack owns the look. *@

<div class="rviz-shm @WrapCssClass" style="@Style">
    @if (Matrix is null || Empty)
    {
        <p class="rviz-empty-state">@Loc["No data for the selected period"]</p>
    }
    else
    {
        <div class="rviz-shm-scroll" style="@($"max-height:{HeightPx}px")">
            <div class="rviz-shm-grid" style="@GridStyle()">
                <div class="rviz-shm-corner" style="grid-row:1;grid-column:1">
                    @if (ShowAxisLabelsY && !string.IsNullOrWhiteSpace(Presentation?.YLabel))
                    {
                        <span class="rviz-shm-axis-y">@Presentation!.YLabel</span>
                    }
                    @if (ShowAxisLabelsX && !string.IsNullOrWhiteSpace(Presentation?.XLabel))
                    {
                        <span class="rviz-shm-axis-x">@Presentation!.XLabel →</span>
                    }
                </div>
                @for (var xi = 0; xi < Cols; xi++)
                {
                    var xIndex = xi;
                    var showXLabel = ShowAxisLabelsX && ShouldShowXLabel(xi);
                    <div class="rviz-shm-x-label rviz-shm-x-label--clickable @(showXLabel ? null : "rviz-shm-x-label-sparse")"
                         style="grid-row:1;grid-column:@(xi + 2)"
                         role="button"
                         tabindex="0"
                         title="@(ShowAxisLabelsX ? FormatXLabel(XLabel(xIndex)) : null)"
                         @onclick="() => SelectXLabel(xIndex)"
                         @onclick:stopPropagation="true">
                        @(showXLabel ? FormatXLabel(XLabel(xIndex)) : "")
                    </div>
                }
                @for (var yi = 0; yi < Rows; yi++)
                {
                    var rowIndex = yi;
                    @if (ShowAxisLabelsY)
                    {
                        <button type="button"
                                class="rviz-shm-y-label @(_selectedRow == rowIndex ? "rviz-shm-y-label-selected" : null)"
                                style="grid-row:@(yi + 2);grid-column:1"
                                title="@FormatYLabel(YLabel(rowIndex))"
                                @onclick="() => SelectCategory(rowIndex)"
                                @onclick:stopPropagation="true">@FormatYLabel(YLabel(rowIndex))</button>
                    }
                    else
                    {
                        <div class="rviz-shm-y-label rviz-shm-y-label-spacer"
                             style="grid-row:@(yi + 2);grid-column:1" aria-hidden="true"></div>
                    }
                    @for (var xi = 0; xi < Cols; xi++)
                    {
                        var colIndex = xi;
                        var value = Matrix.Cells[rowIndex][colIndex];
                        var filled = value is not null;
                        var (cellMin, cellMax) = Matrix.ColorRangeForCell(rowIndex, colIndex);
                        <button type="button"
                                class="rviz-shm-cell @(filled ? "rviz-shm-cell-filled" : "rviz-shm-cell-empty") @(_selectedYi == rowIndex && _selectedXi == colIndex ? "rviz-shm-cell-selected" : null)"
                                style="@CellAttributes(rowIndex, xi, value, cellMin, cellMax)"
                                title="@CellTooltip(rowIndex, colIndex, value)"
                                tabindex="@(filled ? 0 : -1)"
                                @onclick="() => SelectCell(rowIndex, colIndex)"
                                @onclick:stopPropagation="true">
                            @if (filled && value is { } labeled && ShowCellValues)
                            {
                                <span class="rviz-shm-cell-value">@FormatValue(labeled)</span>
                            }
                        </button>
                    }
                }
            </div>
        </div>
    }
</div>

@code {
    [Inject]
    private IStringLocalizer<RadzenVizStrings> Loc { get; set; } = default!;

    [Parameter, EditorRequired]
    public MatrixPayload Matrix { get; set; } = default!;

    [Parameter]
    public MatrixPresentation? Presentation { get; set; }

    /// <summary>Cell click — the generic drill source (ADR-0107).</summary>
    [Parameter]
    public EventCallback<HeatmapCellContext> OnCellSelected { get; set; }

    /// <summary>Y-axis category item click (ADR-0107: "category item").</summary>
    [Parameter]
    public EventCallback<HeatmapCellContext> OnCategoryItemSelected { get; set; }

    [Parameter]
    public string? Style { get; set; } = "width:100%";

    /// <summary>Граф (G) получения данных: клик-значения фильтров конвертируются через G⁻¹ в storage-кадр.</summary>
    [Parameter]
    public DashflowExecutionPath? FlowPath { get; set; }

    /// <summary>The viz-state key (ADR-0062): the display toolbar's toggles land here.</summary>
    [Parameter]
    public string? VizStateCardId { get; set; }

    [Inject]
    private ICardVizDisplayState VizDisplayState { get; set; } = default!;

    private int Rows => Matrix.YLabels.Count;

    private int Cols => Matrix.XLabels.Count;

    private bool Empty => Rows == 0 || Cols == 0;

    private string ColorScale => HeatmapColorScale.Normalize(Presentation?.ColorScale);

    private bool ShowAxisLabelsX =>
        VizLabelDisplayResolver.EffectiveAxisVisible(
            Presentation?.AxisLabelsX ?? true,
            VizDisplayState.GetAxisLabelsXOverride(VizStateCardId ?? string.Empty));

    private bool ShowAxisLabelsY =>
        VizLabelDisplayResolver.EffectiveAxisVisible(
            Presentation?.AxisLabelsY ?? true,
            VizDisplayState.GetAxisLabelsYOverride(VizStateCardId ?? string.Empty));

    private int HeightPx => Presentation?.HeightPx ?? 320;

    /// <summary>Value labels: no heuristic — visible unless the author (<c>value_labels = hide</c>)
    /// or the viewer's display toolbar says otherwise (ADR-0116: the toolbar buttons are the
    /// control; the shared resolver already behaves exactly that way).</summary>
    private bool ShowCellValues =>
        VizLabelDisplayResolver.EffectiveValueLabelsVisible(
            Presentation?.ValueLabels ?? VizValueLabelMode.Auto,
            VizDisplayState.GetValueLabelsOverride(VizStateCardId ?? string.Empty));

    private string WrapCssClass =>
        $"{(ShowAxisLabelsX ? null : "rviz-shm--hide-x")} {(ShowAxisLabelsY ? null : "rviz-shm--hide-y")}".Trim();

    /// <summary>Data columns size from their content (ADR-0116): each column is at least as
    /// wide as its X label — a wider date format widens the columns by itself — and spare
    /// card width is shared equally. When the mins outrun the card, the grid scrolls.
    /// Rows keep a fixed compact height regardless of width.</summary>
    private string GridStyle()
    {
        var yColumn = ShowAxisLabelsY ? "minmax(8rem, max-content)" : "0";
        return $"grid-template-columns:{yColumn} repeat({Cols}, minmax(auto, 1fr));";
    }

    /// <summary>One cell's full inline style: grid placement, then the color scale fill.</summary>
    private string CellAttributes(int yi, int xi, double? value, double cellMin, double cellMax) =>
        $"grid-row:{yi + 2};grid-column:{xi + 2};{CellStyle(value, cellMin, cellMax)}";

    /// <summary>Viewer-facing selection state (ADR-0116): the clicked cell keeps a highlight
    /// until the payload changes — the same feedback the builtin canvas gives.</summary>
    private int? _selectedYi;

    private int? _selectedXi;

    private int? _selectedRow;

    private MatrixPayload? _lastMatrix;

    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        if (!ReferenceEquals(Matrix, _lastMatrix))
        {
            _selectedYi = null;
            _selectedXi = null;
            _selectedRow = null;
            _lastMatrix = Matrix;
        }
    }

    private string CellStyle(double? value, double cellMin, double cellMax)
    {
        if (value is null)
        {
            return string.Empty;
        }

        return $"background:{HeatmapColorScale.CellBackground(ColorScale, value.Value, cellMin, cellMax)};" +
               $"color:{HeatmapColorScale.CellText(ColorScale, value.Value, cellMin, cellMax)};";
    }

    private bool ShouldShowXLabel(int index)
    {
        if (Cols <= 14)
        {
            return true;
        }

        var step = (int)Math.Ceiling(Cols / 14.0);
        return index == 0 || index == Cols - 1 || index % step == 0;
    }

    private string YLabel(int index) => Matrix.YLabels[index];

    private string XLabel(int index) => Matrix.XLabels[index];

    private string FormatValue(double value) => value.ToString("0", System.Globalization.CultureInfo.InvariantCulture);

    private string FormatXLabel(string label) =>
        LabelFormat.Format(label, Presentation?.XFormat ?? "date.short");

    private string FormatYLabel(string label) =>
        LabelFormat.Format(label, Presentation?.YFormat ?? "user.short");

    private string CellTooltip(int yi, int xi, double? value)
    {
        var head = $"{FormatYLabel(YLabel(yi))} · {FormatXLabel(XLabel(xi))}: {(value is { } v ? FormatValue(v) : "—")}";
        var tip = Matrix.Tooltips?[yi][xi];
        if (string.IsNullOrWhiteSpace(tip))
        {
            return head;
        }

        return string.IsNullOrWhiteSpace(Presentation?.TooltipLabel)
            ? $"{head} — {tip}"
            : $"{head} — {Presentation!.TooltipLabel}: {tip}";
    }

    private async Task SelectCell(int yi, int xi)
    {
        var value = Matrix.Cells[yi][xi];
        if (value is null)
        {
            return;
        }

        _selectedYi = yi;
        _selectedXi = xi;
        _selectedRow = null;

        await OnCellSelected.InvokeAsync(Context(yi, xi, value, MatrixClickSources.Cell));
    }

    private async Task SelectCategory(int yi)
    {
        if (!OnCategoryItemSelected.HasDelegate)
        {
            return;
        }

        _selectedRow = yi;
        _selectedYi = null;
        _selectedXi = null;

        // Canvas-parity: a category click carries no bucket instants — otherwise the
        // resolver's auto bucket-range overlay pins the drill to the axis's first bucket.
        await OnCategoryItemSelected.InvokeAsync(new HeatmapCellContext(
            yi,
            -1,
            string.Empty,
            Matrix.YLabels[yi],
            null,
            null,
            null,
            null,
            ClickSource: MatrixClickSources.CategoryItem,
            FlowPath: FlowPath));
    }

    private HeatmapCellContext Context(int yi, int xi, double? value, string clickSource)
    {
        var (bucketStart, bucketEnd) = BucketInterval(xi);

        return new HeatmapCellContext(
            yi,
            xi,
            Matrix.XLabels[xi],
            Matrix.YLabels[yi],
            value,
            Matrix.Tooltips?[yi][xi],
            bucketStart,
            bucketEnd,
            ClickSource: clickSource,
            FlowPath: FlowPath);
    }

    /// <summary>Полуинтервал бакета колонки [start, end): конец следующего бакета, для
    /// последнего — шаг сетки (разница соседних starts).</summary>
    private (DateTime? Start, DateTime? End) BucketInterval(int xi)
    {
        if (Matrix.XBucketStarts is not { } buckets || xi >= buckets.Count)
        {
            return (null, null);
        }

        var start = buckets[xi];
        var end = xi + 1 < buckets.Count
            ? buckets[xi + 1]
            : buckets.Count > 1
                ? start + (start - buckets[xi - 1])
                : (DateTime?)null;
        return (start, end);
    }

    /// <summary>X-axis label click: the whole column — one time bucket, all categories.
    /// Fires through the "cell" source: the <c>on click</c> | cell | row binds the bucket
    /// interval via <c>activity_slot=x</c>; the <c>y</c> bind stays empty and the resolver
    /// skips it — so the drill shows the hour across every product.</summary>
    private async Task SelectXLabel(int xi)
    {
        var (bucketStart, bucketEnd) = BucketInterval(xi);

        await OnCellSelected.InvokeAsync(new HeatmapCellContext(
            -1,
            xi,
            Matrix.XLabels[xi],
            string.Empty,
            null,
            null,
            bucketStart,
            bucketEnd,
            ClickSource: MatrixClickSources.Cell,
            FlowPath: FlowPath));
    }
}
