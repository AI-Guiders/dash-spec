@namespace DashSpec.Plugin.Viz.Builtins.Components.Hosting
@inject ICardVizComponentResolver VizComponents

@if (!string.IsNullOrEmpty(Slot.Error))
{
    <div class="card-error">@Slot.Error</div>
}
else if (_componentType is null)
{
    <div class="card-error">Неизвестный viz plugin: @Slot.RenderPluginId</div>
}
else
{
    <DynamicComponent Type="_componentType" Parameters="_parameters" />
}

@code {
    [Parameter, EditorRequired] public CardRenderResult Card { get; set; } = default!;
    [Parameter, EditorRequired] public CardSlotRenderResult Slot { get; set; } = default!;

    private Type? _componentType;
    private Dictionary<string, object?> _parameters = new();

    protected override void OnParametersSet()
    {
        _componentType = VizComponents.TryGetComponentType(Slot.RenderPluginId);
        var synthetic = new CardRenderResult(
            $"{Card.Id}:{Slot.SlotRef}",
            string.Empty,
            Slot.DiagramKind,
            Slot.DataFamily,
            Slot.RenderPluginId,
            Chart: Slot.Chart,
            Table: Slot.Table,
            Matrix: Slot.Matrix,
            Gantt: Slot.Gantt,
            MatrixPresentation: Slot.MatrixPresentation,
            TablePresentation: Slot.TablePresentation);
        _parameters = new Dictionary<string, object?>
        {
            ["Context"] = new CardVizRenderContext { Card = synthetic, VizStateCardId = Card.Id },
        };
    }
}
