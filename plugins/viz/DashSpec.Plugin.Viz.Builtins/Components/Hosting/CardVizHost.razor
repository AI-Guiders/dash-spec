@namespace DashSpec.Plugin.Viz.Builtins.Components.Hosting
@inject ICardVizComponentResolver VizComponents
@inject IStringLocalizer<VizStrings> Loc

@if (EffectiveCard.Loading)
{
    <div class="card-skeleton">
        <div class="spinner" aria-hidden="true"></div>
    </div>
}
else if (!string.IsNullOrEmpty(EffectiveCard.Error))
{
    <div class="card-error">@EffectiveCard.Error</div>
}
else if (Slot is not null && Slot.AwaitingClick)
{
    <div class="card-slot-awaiting">
        @if (!string.IsNullOrWhiteSpace(Slot.SlotTitle))
        {
            <div class="card-slot-title">@Slot.SlotTitle</div>
        }
        <p class="empty-state">@AwaitingHint</p>
    </div>
}
else if (_componentType is null)
{
    <div class="card-error">@(Loc["Unknown viz plugin: {0}", EffectiveCard.RenderPluginId])</div>
}
else
{
    @if (Slot is not null && !string.IsNullOrWhiteSpace(Slot.SlotTitle))
    {
        <div class="card-slot-title">@Slot.SlotTitle</div>
    }
    @* The testid is a stable DOM handle for automation, not a layout box: display:contents
       keeps the flex chain intact (stack → viz root) — a plain block wrapper here grew to
       the frame's content height and punched through the card (724px vs 560px slot). *@
    <div data-testid="viz-@(Slot is null ? Card.Id : $"{Card.Id}:{Slot.SlotRef}")" style="display:contents">
        <DynamicComponent Type="_componentType" Parameters="_parameters" />
    </div>
}

@code {
    [Parameter, EditorRequired] public CardVizHostRequest Request { get; set; } = default!;

    private CardRenderResult Card => Request.Card;
    private CardSlotRenderResult? Slot => Request.Slot;

    private Type? _componentType;
    private Dictionary<string, object?> _parameters = new();

    private CardRenderResult EffectiveCard => Slot is null ? Card : FromSlot(Slot);

    /// <summary>Drill UX hint: what to click to fill this slot (ADR-0107; "switch" = ADR-0113 switch slot).</summary>
    private string AwaitingHint => Slot?.AwaitingSource switch
    {
        "category item" => Loc["Click an axis label to load this table"],
        "cell" => Loc["Click a heatmap cell to load this table"],
        "switch" => Loc["Click a heatmap cell or an axis label to load this table"],
        _ => Loc["Click the diagram to load this table"],
    };

    protected override void OnParametersSet()
    {
        var card = EffectiveCard;
        _componentType = VizComponents.TryGetComponentType(card.RenderPluginId);
        _parameters = new Dictionary<string, object?>
        {
            ["Context"] = new CardVizRenderContext
            {
                Card = card,
                DetailView = Request.DetailView,
                MatrixMin = Request.MatrixMin,
                MatrixMax = Request.MatrixMax,
                OnHeatmapCellSelected = Request.OnHeatmapCellSelected,
                OnHeatmapCategoryItemSelected = Request.OnHeatmapCategoryItemSelected,
                OnCardAction = Request.OnCardAction,
                VizStateCardId = Slot is null ? null : Card.Id,
                FlowPath = Slot?.FlowPath ?? Card.FlowPath,
            },
        };
    }

    private CardRenderResult FromSlot(CardSlotRenderResult slot) =>
        new(
            $"{Card.Id}:{slot.SlotRef}",
            string.Empty,
            slot.DiagramKind,
            slot.DataFamily,
            slot.RenderPluginId,
            Chart: slot.Chart,
            DetailChart: slot.DetailChart,
            Table: slot.Table,
            Number: slot.Number,
            NumberScale: slot.NumberScale,
            NumberDelta: slot.NumberDelta,
            NumberDeltaTone: slot.NumberDeltaTone,
            ChartPresentation: slot.ChartPresentation,
            Matrix: slot.Matrix,
            DetailMatrix: slot.DetailMatrix,
            Gantt: slot.Gantt,
            MatrixPresentation: slot.MatrixPresentation,
            TablePresentation: slot.TablePresentation,
            FormatDefaults: slot.FormatDefaults ?? Card.FormatDefaults,
            EmptyMessage: slot.EmptyMessage ?? Card.EmptyMessage,
            ClickBehaviour: slot.ClickBehaviour ?? Card.ClickBehaviour,
            ClickHandlers: slot.ClickHandlers ?? Card.ClickHandlers,
            FlowPath: slot.FlowPath ?? Card.FlowPath);
}
