@namespace DashSpec.Plugin.Viz.Builtins.Components.Charts
@using DashSpec.Core.Interaction
@using DashSpec.Execution.Runtime
@using Microsoft.JSInterop
@inject IJSRuntime Js
@implements IAsyncDisposable
@inject IStringLocalizer<VizStrings> Loc

@if (Payload is null || Payload.XLabels.Count == 0 || Payload.YLabels.Count == 0)
{
    <p class="empty-state">@Loc["No data for the selected period"]</p>
}
else if (EffectiveLimits.IsOversized(Payload.XLabels.Count, Payload.YLabels.Count))
{
    <div class="heatmap-oversized" role="alert">
        <p><strong>@Loc["Heatmap not shown (protection limit)"]</strong> — @MatrixOversizeMessage.Format(Loc, EffectiveLimits, Payload.XLabels.Count, Payload.YLabels.Count).</p>
        @if (!string.IsNullOrWhiteSpace(OversizeMessage))
        {
            <p class="muted"><RichTextView Text="@OversizeMessage" /></p>
        }
        else
        {
            <p class="muted">@Loc["Narrow the period or select a single user in the toolbar."]</p>
        }
    </div>
}
else
{
    <div id="@HostId"
         class="matrix-canvas-host @HostCssClass"
         style="@HostStyle"
         data-color-scale="@HeatmapColorScale.Normalize(ColorScale)">
        <div class="matrix-canvas-scroll">
            <div class="matrix-canvas-layout">
                <div class="matrix-canvas-corner">
                    @if (ShowAxisLabelsY && !string.IsNullOrWhiteSpace(YAxisLabel))
                    {
                        <span class="heatmap-axis-y"><RichTextView Text="@YAxisLabel" /></span>
                    }
                    @if (ShowAxisLabelsX && !string.IsNullOrWhiteSpace(XAxisLabel))
                    {
                        <span class="heatmap-axis-x"><RichTextView Text="@XAxisLabel" /> →</span>
                    }
                </div>
                <div class="matrix-canvas-x-labels @(ShowAxisLabelsX ? null : "matrix-canvas-x-labels--hidden")"
                     aria-hidden="@(!ShowAxisLabelsX)">
                    @for (var xi = 0; xi < Payload.XLabels.Count; xi++)
                    {
                        var show = ShowAxisLabelsX && ShouldShowXLabel(xi);
                        <span class="matrix-canvas-x-label @(show ? null : "matrix-canvas-x-label-sparse")"
                              title="@(ShowAxisLabelsX ? FormatXLabel(Payload.XLabels[xi]) : null)">
                            @(show ? FormatXLabel(Payload.XLabels[xi]) : "")
                        </span>
                    }
                </div>
                @if (ShowAxisLabelsY)
                {
                    <div class="matrix-canvas-y-labels">
                        @for (var yi = 0; yi < Payload.YLabels.Count; yi++)
                        {
                            var yLabel = Payload.YLabels[yi];
                            var idx = yi;
                            <div class="matrix-canvas-y-label @YLabelCssClass(yLabel)"
                                 title="@yLabel"
                                 @onclick="() => HandleCategoryItemClickAsync(idx, yLabel)">@yLabel</div>
                        }
                    </div>
                }
                <canvas id="@CanvasId"
                        class="matrix-canvas"
                        width="1"
                        height="1"
                        @onclick="@(async args => await HandleCanvasClickAsync(args))"></canvas>
            </div>
        </div>
        @if (ShowGradientLegend && (!string.IsNullOrWhiteSpace(LegendMinText) || !string.IsNullOrWhiteSpace(LegendMaxText)))
        {
            <div class="heatmap-legend">
                @if (!string.IsNullOrWhiteSpace(LegendMinText))
                {
                    <span><RichTextView Text="@LegendMinText" /></span>
                }
                <span class="heatmap-legend-bar" aria-hidden="true"></span>
                @if (!string.IsNullOrWhiteSpace(LegendMaxText))
                {
                    <span><RichTextView Text="@LegendMaxText" /></span>
                }
            </div>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public MatrixPayload Payload { get; set; } = default!;

    [Parameter, EditorRequired] public string HostId { get; set; } = string.Empty;

    [Parameter, EditorRequired] public string CanvasId { get; set; } = string.Empty;

    [Parameter] public int HeightPx { get; set; } = 320;

    [Parameter] public int? VisibleRows { get; set; }

    [Parameter] public string? XAxisLabel { get; set; }

    [Parameter] public string? YAxisLabel { get; set; }

    [Parameter] public string? ValueLabel { get; set; }

    [Parameter] public string XFormat { get; set; } = "date.short";

    /// <summary>Граф (G) получения данных: клик-значения фильтров конвертируются через G⁻¹ в storage-кадр.</summary>
    [Parameter] public DashSpec.Execution.Runtime.DashflowExecutionPath? FlowPath { get; set; }

    [Parameter] public string YFormat { get; set; } = "user.short";

    [Parameter] public string ColorScale { get; set; } = "heat";

    [Parameter] public string? LegendMinText { get; set; }

    [Parameter] public string? LegendMaxText { get; set; }

    [Parameter] public bool ShowGradientLegend { get; set; } = true;

    [Parameter] public EventCallback<HeatmapCellContext> OnCellSelected { get; set; }

    [Parameter] public EventCallback<HeatmapCellContext> OnCategoryItemSelected { get; set; }

    [Parameter] public bool CategoryItemClickEnabled { get; set; }

    [Parameter] public MatrixRenderLimitsDefinition? Limits { get; set; }

    [Parameter] public string? OversizeMessage { get; set; }

    [Parameter] public string ValueLabelsWire { get; set; } = "auto";

    [Parameter] public bool ShowAxisLabelsX { get; set; } = true;

    [Parameter] public bool ShowAxisLabelsY { get; set; } = true;

    [Parameter] public MatrixAxisScrollMode AxisScroll { get; set; } = MatrixAxisScrollMode.Sticky;

    [Parameter] public int ValueLabelsThresholdPx { get; set; } = VizAxisPresentationParser.DefaultValueLabelsThresholdPx;

    private MatrixRenderLimitsDefinition EffectiveLimits => Limits ?? MatrixRenderLimitsDefinition.Default;

    private string HostCssClass
    {
        get
        {
            var parts = new List<string>();
            if (!ShowAxisLabelsX)
            {
                parts.Add("matrix-canvas-host--hide-x-labels");
            }

            if (!ShowAxisLabelsY)
            {
                parts.Add("matrix-canvas-host--hide-y-labels");
            }

            if (AxisScroll is MatrixAxisScrollMode.Sticky)
            {
                parts.Add("matrix-canvas-host--axis-sticky");
            }

            return string.Join(' ', parts);
        }
    }

    private string? _mountedPayloadKey;
    private string? _activeCategoryLabel;
    private (int Yi, int Xi)? _activeCell;
    private const int TargetVisibleXLabels = 14;

    private string HostStyle => $"--matrix-max-height:{HeightPx}px";

    private MatrixPayload? _lastSeenPayload;

    protected override void OnParametersSet()
    {
        if (_lastSeenPayload is not null &&
            !ReferenceEquals(_lastSeenPayload, Payload) &&
            !SameAxes(_lastSeenPayload, Payload))
        {
            // Axes changed (filters/scope): the active markers point at stale positions.
            _activeCell = null;
            _activeCategoryLabel = null;
        }

        _lastSeenPayload = Payload;
    }

    private static bool SameAxes(MatrixPayload left, MatrixPayload right) =>
        left.YLabels.SequenceEqual(right.YLabels) &&
        left.XLabels.SequenceEqual(right.XLabels);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!RendererInfo.IsInteractive || Payload is null)
        {
            return;
        }

        if (Payload.XLabels.Count == 0 ||
            Payload.YLabels.Count == 0 ||
            EffectiveLimits.IsOversized(Payload.XLabels.Count, Payload.YLabels.Count))
        {
            await UnmountIfMountedAsync();
            return;
        }

        var payloadKey = BuildPayloadKey();
        var payloadObj = new
        {
            xCount = Payload.XLabels.Count,
            yCount = Payload.YLabels.Count,
            cells = Payload.Cells,
            min = Payload.Min,
            max = Payload.Max,
            colorNormalize = MatrixColorNormalizeParser.ToWire(Payload.ColorNormalize),
            rowMins = Payload.RowMins,
            rowMaxs = Payload.RowMaxs,
            colMins = Payload.ColMins,
            colMaxs = Payload.ColMaxs,
            colorScale = ColorScale,
            maxHeight = HeightPx,
            visibleRows = VisibleRows,
            showValues = ValueLabelsWire,
            valueLabelsThreshold = ValueLabelsThresholdPx,
            showAxisLabelsX = ShowAxisLabelsX,
            showAxisLabelsY = ShowAxisLabelsY,
            activeCell = _activeCell is { } active ? new { yi = active.Yi, xi = active.Xi } : (object?)null,
        };

        if (_mountedPayloadKey is not null &&
            !firstRender &&
            !string.Equals(payloadKey, _mountedPayloadKey, StringComparison.Ordinal))
        {
            _mountedPayloadKey = payloadKey;
            await Js.InvokeVoidAsync("dashSpecMatrix.update", HostId, CanvasId, payloadObj);
            return;
        }

        if (string.Equals(payloadKey, _mountedPayloadKey, StringComparison.Ordinal) && !firstRender)
        {
            await Js.InvokeVoidAsync("dashSpecMatrix.update", HostId, CanvasId, payloadObj);
            return;
        }

        _mountedPayloadKey = payloadKey;
        await Js.InvokeVoidAsync(
            "dashSpecMatrix.mount",
            HostId,
            CanvasId,
            payloadObj);
    }

    private string BuildPayloadKey() =>
        $"{string.Join('|', Payload.YLabels)}::{string.Join('|', Payload.XLabels)}::{Payload.Min}:{Payload.Max}:{MatrixColorNormalizeParser.ToWire(Payload.ColorNormalize)}:{ComputeCellHash()}:{ColorScale}:{HeightPx}:{VisibleRows}:{ValueLabelsWire}:{ValueLabelsThresholdPx}:{ShowAxisLabelsX}:{ShowAxisLabelsY}:{ActiveCellKey()}";

    private string ActiveCellKey() => _activeCell is { } cell ? $"{cell.Yi},{cell.Xi}" : "-";

    private int ComputeCellHash()
    {
        unchecked
        {
            var hash = 17;
            foreach (var row in Payload.Cells)
            {
                foreach (var cell in row)
                {
                    hash = (hash * 31) + (cell?.GetHashCode() ?? 0);
                }
            }

            return hash;
        }
    }

    private async Task HandleCanvasClickAsync(MouseEventArgs args)
    {
        if (!OnCellSelected.HasDelegate)
        {
            return;
        }

        var hit = await Js.InvokeAsync<CanvasHit?>("dashSpecMatrix.hitTest", CanvasId, args.OffsetX, args.OffsetY);
        if (hit is null || hit.Value is null)
        {
            return;
        }

        // Active state: the clicked cell stays outlined until the next click
        // (instant repaint; the slot refresh lands later, ADR-0066).
        _activeCell = (hit.Yi, hit.Xi);
        await InvokeAsync(StateHasChanged);

        var xBucket = Payload.XBucketStarts is { Count: > 0 } buckets && hit.Xi >= 0 && hit.Xi < buckets.Count
            ? buckets[hit.Xi]
            : (DateTime?)null;
        DateTime? xBucketEnd = xBucket is { } start && hit.Xi + 1 < buckets.Count
            ? buckets[hit.Xi + 1]
            : null;
        var context = new HeatmapCellContext(
            hit.Yi,
            hit.Xi,
            Payload.XLabels[hit.Xi],
            Payload.YLabels[hit.Yi],
            hit.Value,
            Payload.Tooltips?[hit.Yi][hit.Xi],
            xBucket,
            xBucketEnd,
            // ADR-0107: the cell body is the "cell" click source, so the sourced `on click`
            // table rows (| cell | … |) resolve; legacy cards fall back to the generic block.
            DashSpec.Plugin.Viz.Builtins.Components.MatrixCanvas.MatrixClickSources.Cell,
            FlowPath);

        await OnCellSelected.InvokeAsync(context);
    }

    /// <summary>Y-axis category item click (ADR-0107): the row label of the category axis.</summary>
    private async Task HandleCategoryItemClickAsync(int yi, string yLabel)
    {
        if (!CategoryItemClickEnabled || !OnCategoryItemSelected.HasDelegate)
        {
            return;
        }

        // Instant active-state feedback; the slot refresh lands later (ADR-0066 interior refresh).
        _activeCategoryLabel = yLabel;
        await InvokeAsync(StateHasChanged);

        var context = new HeatmapCellContext(
            yi,
            -1,
            string.Empty,
            yLabel,
            null,
            null,
            null,
            DashSpec.Plugin.Viz.Builtins.Components.MatrixCanvas.MatrixClickSources.CategoryItem,
            FlowPath);

        await OnCategoryItemSelected.InvokeAsync(context);
    }

    /// <summary>The clicked category item stays highlighted (ADR-0107 active state).</summary>
    private string? YLabelCssClass(string yLabel)
    {
        var parts = new List<string>();
        if (CategoryItemClickEnabled)
        {
            parts.Add("matrix-canvas-y-label--clickable");
        }

        if (string.Equals(yLabel, _activeCategoryLabel, StringComparison.Ordinal))
        {
            parts.Add("matrix-canvas-y-label--active");
        }

        return parts.Count == 0 ? null : string.Join(' ', parts);
    }

    private bool ShouldShowXLabel(int index)
    {
        var count = Payload.XLabels.Count;
        var target = string.Equals(XFormat, "time.short", StringComparison.OrdinalIgnoreCase) && count <= 24
            ? count
            : TargetVisibleXLabels;
        if (count <= target)
        {
            return true;
        }

        var step = (int)Math.Ceiling(count / (double)target);
        return index == 0 || index == count - 1 || index % step == 0;
    }

    private string FormatXLabel(string label) => LabelFormat.Format(label, XFormat);

    private string FormatYLabel(string label) => LabelFormat.Format(label, YFormat);

    private async Task UnmountIfMountedAsync()
    {
        if (_mountedPayloadKey is null)
        {
            return;
        }

        _mountedPayloadKey = null;
        try
        {
            await Js.InvokeVoidAsync("dashSpecMatrix.unmount", HostId);
        }
        catch (JSDisconnectedException)
        {
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (!RendererInfo.IsInteractive)
        {
            return;
        }

        await UnmountIfMountedAsync();
    }

    private sealed record CanvasHit(int Xi, int Yi, double? Value);
}
