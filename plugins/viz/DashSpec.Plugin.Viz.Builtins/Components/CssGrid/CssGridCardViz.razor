@namespace DashSpec.Plugin.Viz.Builtins.Components.CssGrid
@using DashSpec.Abstractions.Plugins
@using DashSpec.Core.Model
@using DashSpec.Execution.Runtime
@using DashSpec.Viz
@implements IDisposable
@inject ICardVizDisplayState VizDisplayState

@if (Context.Card.Matrix is not null)
{
    var presentation = Context.Card.MatrixPresentation;
    var cardId = Context.ResolveVizStateCardId();
    var spec = presentation ?? new MatrixPresentation();
    var valueOverride = VizDisplayState.GetValueLabelsOverride(cardId);
    var axisXOverride = VizDisplayState.GetAxisLabelsXOverride(cardId);
    var axisYOverride = VizDisplayState.GetAxisLabelsYOverride(cardId);
    var legendOverride = VizDisplayState.GetLegendOverride(cardId);
    var showValues = VizLabelDisplayResolver.EffectiveValueLabelsVisible(spec.ValueLabels, valueOverride);
    var showAxisX = VizLabelDisplayResolver.ResolveAxisVisible(spec.AxisLabelsX, axisXOverride);
    var showAxisY = VizLabelDisplayResolver.ResolveAxisVisible(spec.AxisLabelsY, axisYOverride);
    var showLegend = VizLabelDisplayResolver.EffectiveLegendVisible(spec.ShowsGradientLegend, legendOverride);

    <HeatmapView Payload="Context.Card.Matrix"
                 HeightPx="@spec.HeightPx"
                 XAxisLabel="@presentation?.XLabel"
                 YAxisLabel="@presentation?.YLabel"
                 ValueLabel="@presentation?.ValueLabel"
                 TooltipLabel="@presentation?.TooltipLabel"
                 TooltipFormat="@(presentation?.TooltipFormat ?? TooltipFormat.Inline)"
                 TooltipSplit="@(presentation?.TooltipSplit ?? ", ")"
                 XFormat="@(presentation?.XFormat ?? "date.short")"
                 YFormat="@(presentation?.YFormat ?? "user.short")"
                 ColorScale="@(presentation?.ColorScale ?? "heat")"
                 ShowAxisLabelsX="@showAxisX"
                 ShowAxisLabelsY="@showAxisY"
                 ShowCellValues="@showValues"
                 ShowGradientLegend="@showLegend"
                 LegendMinText="@(showLegend ? presentation?.FormatLegendMin(Context.MatrixMin, Context.MatrixMax) : null)"
                 LegendMaxText="@(showLegend ? presentation?.FormatLegendMax(Context.MatrixMin, Context.MatrixMax) : null)"
                 Limits="Context.Card.MatrixLimits"
                 OversizeMessage="Context.Card.OversizeMessage"
                 OnCellSelected="Context.OnHeatmapCellSelected" />
}

@code {
    [Parameter, EditorRequired] public CardVizRenderContext Context { get; set; } = default!;

    protected override void OnInitialized()
    {
        VizDisplayState.Changed += OnVizDisplayStateChanged;
    }

    public void Dispose()
    {
        VizDisplayState.Changed -= OnVizDisplayStateChanged;
    }

    private void OnVizDisplayStateChanged(string cardId)
    {
        if (!string.Equals(cardId, Context.ResolveVizStateCardId(), StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        _ = InvokeAsync(StateHasChanged);
    }
}
