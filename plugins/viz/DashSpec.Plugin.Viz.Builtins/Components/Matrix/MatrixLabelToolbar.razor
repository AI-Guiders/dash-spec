@namespace DashSpec.Plugin.Viz.Builtins.Components.Matrix
@using DashSpec.Abstractions.Plugins
@using DashSpec.Execution.Runtime
@using DashSpec.Viz
@implements IDisposable
@inject ICardVizDisplayState VizDisplayState
@inject IStringLocalizer<VizStrings> Loc
@inject ICardChromeControlsOverride ChromeControls

@if (Context.Card.MatrixPresentation is not null)
{
    var stackButton = ChromeControls.ResolveButton();

    <div class="card-matrix-glyph-group" role="group" aria-label="@Loc["Matrix display"]"
         data-testid="viz-toolbar-@Context.Card.Id">
        @* Toggle roles (values / axis-x / axis-y / legend): the toolbar owns the
           semantics — state, action wiring, glyph; the stack paints the button
           (ADR-0112). Absent a stack binding — the native button. The testid is the
           automation handle: scope buttons by the group, the toggles keep their
           aria-labels and aria-pressed. *@
        <ChromeGlyphToggle StackButton="stackButton"
                           Label="@ValueLabelsTitle"
                           Pressed="@MatrixValueLabelsVisible"
                           Disabled="@Context.Card.Loading"
                           Glyph="D"
                           TestId="@($"viz-toggle-{Context.Card.Id}-D")"
                           OnClick="ToggleMatrixValueLabelsAsync" />
        <ChromeGlyphToggle StackButton="stackButton"
                           Label="@AxisLabelsXTitle"
                           Pressed="@MatrixAxisLabelsXVisible"
                           Disabled="@Context.Card.Loading"
                           Glyph="X"
                           TestId="@($"viz-toggle-{Context.Card.Id}-X")"
                           OnClick="ToggleMatrixAxisLabelsXAsync" />
        <ChromeGlyphToggle StackButton="stackButton"
                           Label="@AxisLabelsYTitle"
                           Pressed="@MatrixAxisLabelsYVisible"
                           Disabled="@Context.Card.Loading"
                           Glyph="Y"
                           TestId="@($"viz-toggle-{Context.Card.Id}-Y")"
                           OnClick="ToggleMatrixAxisLabelsYAsync" />
        @if (MatrixSpec?.ShowsGradientLegend == true)
        {
            <ChromeGlyphToggle StackButton="stackButton"
                               Label="@LegendTitle"
                               Pressed="@MatrixLegendVisible"
                               Disabled="@Context.Card.Loading"
                               Glyph="L"
                           TestId="@($"viz-toggle-{Context.Card.Id}-L")"
                               OnClick="ToggleMatrixLegendAsync" />
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public VizCardToolbarContext Context { get; set; } = default!;

    private MatrixPresentation? MatrixSpec => Context.Card.MatrixPresentation;

    private bool MatrixValueLabelsVisible =>
        VizLabelDisplayResolver.EffectiveValueLabelsVisible(
            MatrixSpec?.ValueLabels ?? VizValueLabelMode.Auto,
            VizDisplayState.GetValueLabelsOverride(Context.Card.Id));

    private bool MatrixAxisLabelsXVisible =>
        VizLabelDisplayResolver.EffectiveAxisVisible(
            MatrixSpec?.AxisLabelsX ?? true,
            VizDisplayState.GetAxisLabelsXOverride(Context.Card.Id));

    private bool MatrixAxisLabelsYVisible =>
        VizLabelDisplayResolver.EffectiveAxisVisible(
            MatrixSpec?.AxisLabelsY ?? true,
            VizDisplayState.GetAxisLabelsYOverride(Context.Card.Id));

    private bool MatrixLegendVisible =>
        VizLabelDisplayResolver.EffectiveLegendVisible(
            MatrixSpec?.ShowsGradientLegend == true,
            VizDisplayState.GetLegendOverride(Context.Card.Id));

    private static string GlyphBtnClass(bool on) =>
        on
            ? "secondary card-icon-btn card-matrix-glyph-btn is-on"
            : "secondary card-icon-btn card-matrix-glyph-btn is-off";

    private string ValueLabelsTitle => Loc["Toggle cell values"];

    private string AxisLabelsXTitle => Loc["Toggle X axis labels"];

    private string AxisLabelsYTitle => Loc["Toggle Y axis labels"];

    private string LegendTitle => Loc["Toggle gradient legend"];

    protected override void OnInitialized()
    {
        VizDisplayState.Changed += OnVizDisplayStateChanged;
    }

    public void Dispose()
    {
        VizDisplayState.Changed -= OnVizDisplayStateChanged;
    }

    private void OnVizDisplayStateChanged(string cardId)
    {
        if (!string.Equals(cardId, Context.Card.Id, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        _ = InvokeAsync(StateHasChanged);
    }

    private Task ToggleMatrixValueLabelsAsync() =>
        Context.OnCardAction.InvokeAsync(
            new CardActionRequest(Context.Card.Id, VizCardDisplayActions.ToggleValueLabels, new Dictionary<string, string>()));

    private Task ToggleMatrixAxisLabelsXAsync() =>
        Context.OnCardAction.InvokeAsync(
            new CardActionRequest(Context.Card.Id, VizCardDisplayActions.ToggleAxisLabelsX, new Dictionary<string, string>()));

    private Task ToggleMatrixAxisLabelsYAsync() =>
        Context.OnCardAction.InvokeAsync(
            new CardActionRequest(Context.Card.Id, VizCardDisplayActions.ToggleAxisLabelsY, new Dictionary<string, string>()));

    private Task ToggleMatrixLegendAsync() =>
        Context.OnCardAction.InvokeAsync(
            new CardActionRequest(Context.Card.Id, VizCardDisplayActions.ToggleLegend, new Dictionary<string, string>()));
}
