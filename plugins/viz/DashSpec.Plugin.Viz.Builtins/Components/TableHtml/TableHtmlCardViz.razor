@namespace DashSpec.Plugin.Viz.Builtins.Components.TableHtml
@using DashSpec.Execution.Runtime
@using Microsoft.JSInterop
@inject IJSRuntime Js
@inject IStringLocalizer<VizStrings> Loc

@if (Context.Card.Table is null || Context.Card.Table.Rows.Count == 0)
{
    <p class="empty-state">@Loc["No rows"]</p>
}
else
{
    <div class="@WrapClass" style="@WrapStyle">
        <table>
            <thead>
                <tr>
                    @for (var i = 0; i < Context.Card.Table.Columns.Count; i++)
                    {
                        var column = Context.Card.Table.Columns[i];
                        var headerText = Context.Card.Table.HeaderTexts is { } texts && i < texts.Count
                            ? texts[i]
                            : column;
                        var copied = _copiedColumn == i;
                        <th style="@HeaderAlignStyle(i)">
                            <div class="table-col-head">
                                @headerText
                                <button type="button"
                                        class="table-col-copy @(copied ? "table-col-copy--done" : null)"
                                        title="@(copied ? Loc["Copied"] : Loc["Copy column"])"
                                        aria-label="@(copied ? Loc["Copied"] : Loc["Copy column"])"
                                        @onclick="() => CopyColumnAsync(i)"></button>
                            </div>
                            @if (ShowColumnFilters)
                            {
                                <input type="search"
                                       size="2"
                                       class="table-col-filter"
                                       placeholder="@FilterPlaceholder"
                                       aria-label="@ResolveFilterAria(headerText)"
                                       value="@GetFilter(column)"
                                       @oninput="e => SetFilter(column, e.Value?.ToString())" />
                            }
                        </th>
                    }
                </tr>
            </thead>
            <tbody>
                @for (var ri = 0; ri < FilteredRows.Count; ri++)
                {
                    var row = FilteredRows[ri];
                    var rowValue = row.Count > 0 ? row[0] ?? string.Empty : string.Empty;
                    var activeRow = RowClickEnabled && string.Equals(rowValue, _activeRowValue, StringComparison.Ordinal);
                    <tr class="@(activeRow ? "table-row--active" : null)"
                        @onclick="() => HandleRowClickAsync(rowValue)">
                        @for (var i = 0; i < row.Count; i++)
                        {
                            <td style="@CellAlignStyle(i)">@row[i]</td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p class="table-foot muted">
        @RowsSummary
        @if (HasActiveFilters)
        {
            <button type="button" class="table-filter-clear" @onclick="ClearFilters">@Loc["Clear filters"]</button>
        }
    </p>
}

@code {
    [Parameter, EditorRequired] public CardVizRenderContext Context { get; set; } = default!;

    private string FilterPlaceholder => Loc["Filter"];

    private string ResolveFilterAria(string column) => Loc["Filter: {0}", column];

    private string RowsSummary =>
        Loc["Showing {0} of {1} rows", FilteredRowCount, Context.Card.Table!.Rows.Count];

    private TablePresentation Presentation =>
        Context.Card.TablePresentation ?? TablePresentation.FromProperties(new Dictionary<string, string>());

    private bool ShowColumnFilters => Presentation.ColumnFilters;

    /// <summary>ADR-0107: the card declares a `row`-sourced handler → rows are clickable.</summary>
    private bool RowClickEnabled =>
        Context.EffectiveCard.ClickHandlers is { Count: > 0 } handlers &&
        handlers.Any(h => string.Equals(h.Source, TableClickSources.Row, StringComparison.OrdinalIgnoreCase));

    private string WrapClass
    {
        get
        {
            var parts = new List<string> { "table-wrap" };
            parts.Add(Presentation.Width is TableWidthMode.Fill
                ? "table-wrap--width-fill"
                : "table-wrap--width-content");
            if (Presentation.Density is TableDensity.Compact)
            {
                parts.Add("table-wrap--density-compact");
            }

            if (RowClickEnabled)
            {
                parts.Add("table-wrap--row-click");
            }

            return string.Join(' ', parts);
        }
    }

    private string WrapStyle => $"max-height: {Presentation.MaxHeightPx}px;";

    // Spec-driven per-column text-align (`alignment`); the header follows its column
    // unless `header_alignment` is set explicitly.
    private string? CellAlign(int i)
    {
        var list = Context.Card.Table?.ColumnAlignments;
        return list is not null && i < list.Count ? list[i] : null;
    }

    private string? HeaderAlign(int i)
    {
        var list = Context.Card.Table?.HeaderAlignments;
        if (list is not null && i < list.Count && list[i] is { } header)
        {
            return header;
        }

        return CellAlign(i);
    }

    private string? CellAlignStyle(int i) => CellAlign(i) is { } a ? $"text-align: {a};" : null;

    private string? HeaderAlignStyle(int i) => HeaderAlign(i) is { } a ? $"text-align: {a};" : null;

    private int? _copiedColumn;

    private readonly Dictionary<string, string> _columnFilters = new(StringComparer.OrdinalIgnoreCase);

    private IReadOnlyList<IReadOnlyList<string>> FilteredRows
    {
        get
        {
            var table = Context.Card.Table!;
            if (!HasActiveFilters)
            {
                return table.Rows;
            }

            return table.Rows.Where(MatchesFilters).ToList();
        }
    }

    private int FilteredRowCount => FilteredRows.Count;

    private bool HasActiveFilters =>
        ShowColumnFilters &&
        _columnFilters.Values.Any(value => !string.IsNullOrWhiteSpace(value));

    private string GetFilter(string column) =>
        _columnFilters.TryGetValue(column, out var value) ? value : string.Empty;

    private void SetFilter(string column, string? value)
    {
        _columnFilters[column] = value ?? string.Empty;
    }

    private void ClearFilters() => _columnFilters.Clear();

    /// <summary>Copy one column's visible values to the clipboard (newline-joined).</summary>
    private async Task CopyColumnAsync(int columnIndex)
    {
        var text = string.Join(
            Environment.NewLine,
            FilteredRows.Select(row => columnIndex < row.Count ? row[columnIndex] ?? string.Empty : string.Empty));
        try
        {
            await Js.InvokeVoidAsync("navigator.clipboard.writeText", text);
            _copiedColumn = columnIndex;
            await InvokeAsync(StateHasChanged);
            _ = ResetCopiedAsync();
        }
        catch (JSDisconnectedException)
        {
        }
        catch (JSException)
        {
        }
    }

    private async Task ResetCopiedAsync()
    {
        await Task.Delay(900);
        _copiedColumn = null;
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Body row click (ADR-0107): the first column's value rides YLabel, source is "row".
    /// Value-based (not index-based): a re-render may change the visible rows between the
    /// click and the handler — a captured index would go stale, a captured value cannot.
    /// </summary>
    private async Task HandleRowClickAsync(string value)
    {
        if (!RowClickEnabled || !Context.OnHeatmapCategoryItemSelected.HasDelegate)
        {
            return;
        }

        // Active row (standard row-click feedback, like the heatmap cell outline):
        // instant highlight; the slot refresh lands later. Value-based, so a data
        // change simply stops matching the stale value — no explicit reset needed.
        _activeRowValue = value;
        await InvokeAsync(StateHasChanged);

        var context = new HeatmapCellContext(
            -1,
            -1,
            string.Empty,
            value,
            null,
            null,
            null,
            TableClickSources.Row);

        await Context.OnHeatmapCategoryItemSelected.InvokeAsync(context);
    }

    private string? _activeRowValue;

    private bool MatchesFilters(IReadOnlyList<string> row)
    {
        var columns = Context.Card.Table!.Columns;
        for (var i = 0; i < columns.Count; i++)
        {
            if (!_columnFilters.TryGetValue(columns[i], out var needle) || string.IsNullOrWhiteSpace(needle))
            {
                continue;
            }

            var cell = i < row.Count ? row[i] : string.Empty;
            if (cell is null || !cell.Contains(needle, StringComparison.OrdinalIgnoreCase))
            {
                return false;
            }
        }

        return true;
    }
}
