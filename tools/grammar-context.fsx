// Generates docs/grammar/CONTEXT.md from the parser registries.
// Run: dotnet fsi tools/grammar-context.fsx   (after building the solution once)

#r "../src/DashSpec.Modeling.Core/bin/Debug/net10.0/DashSpec.Modeling.Core.dll"
#r "../src/DashSpec.Modeling.Parse/bin/Debug/net10.0/DashSpec.Modeling.Parse.dll"

open System
open System.IO
open System.Reflection
open System.Text
open DashSpec.Modeling.Core
open DashSpec.Modeling.Parse

let sb = StringBuilder()
let line (s: string) = sb.AppendLine s |> ignore

line "# DashSpec grammar context"
line ""
line "Generated by `tools/grammar-context.fsx` from the parser registries. Do not edit by hand."
line ""

line "## Import kinds"
line ""
line "`import <keyword> from <Namespace> [as <alias>]` in a module header."
line ""
line "| Keyword | Kind |"
line "|---|---|"
for d in ImportKindRegistry.allDefinitions do
    line $"| `{d.Keyword}` | `{d.Kind}` |"
line ""

line "## Qualified flow blocks"
line ""
line "`<keyword> flow … end <keyword> flow`. Allowed scopes are read from `FlowGraphKindRegistry.isAllowed`."
line ""
line "| Keyword | Kind | Report / page | Card interior |"
line "|---|---|---|---|"
for d in FlowGraphKindRegistry.allDefinitions do
    let mark (scope: FlowGraphKindRegistry.FlowGraphScope) =
        if FlowGraphKindRegistry.isAllowed scope d.Kind then "yes" else "no"
    line $"| `{d.Keyword}` | `{d.Kind}` | {mark FlowGraphKindRegistry.FlowGraphScope.ReportOrPage} | {mark FlowGraphKindRegistry.FlowGraphScope.CardInterior} |"
line ""

line "## Property schemas"
line ""
line "Each `PropertySchemas` value is the set of `key = value` properties one block accepts."
line ""
let schemaModule = typeof<PropertySchemas.PropertySpec>.DeclaringType
let schemaProps =
    schemaModule.GetProperties(BindingFlags.Public ||| BindingFlags.Static)
    |> Array.filter (fun p -> p.PropertyType = typeof<PropertySchemas.PropertySpec list>)
    |> Array.sortBy (fun p -> p.Name)
for p in schemaProps do
    let specs = p.GetValue(null) :?> PropertySchemas.PropertySpec list
    line $"### `{p.Name}`"
    line ""
    line "| Property | Value type |"
    line "|---|---|"
    for s in specs do
        line $"| `{s.Name}` | `{s.ValueType}` |"
    line ""

let outPath = Path.Combine(__SOURCE_DIRECTORY__, "..", "docs", "grammar", "CONTEXT.md")
Directory.CreateDirectory(Path.GetDirectoryName outPath) |> ignore
File.WriteAllText(outPath, sb.ToString(), UTF8Encoding(false))
printfn "wrote %s" outPath
