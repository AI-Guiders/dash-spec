{
  "Tab module unit": {
    "prefix": "dstab",
    "body": [
      "module tab ${1:my_tab}",
      "    namespace ${2:Demo.MyTab}",
      "    import palettes from ${3:Demo.Palettes}",
      "",
      "    runtime",
      "        manifest = \"${4:demo.toml}\"",
      "    end runtime",
      "",
      "    configuration",
      "        sqldialect = tsql",
      "    end configuration",
      "",
      "    connect",
      "        use palette ${5:demo_apps}",
      "    end connect",
      "",
      "    report",
      "        title = \"${6:Title}\"",
      "        $0",
      "    end report",
      "end tab"
    ],
    "description": "DashSpec tab module unit: module tab <id>, namespace, imports (ADR-0101)"
  },
  "Card with data and view": {
    "prefix": "dscard",
    "body": [
      "card ${1:id} as \"${2:Title}\" ref ${1:id}",
      "  data",
      "    datasource view ${3:demo.v_example}",
      "    bind ${4:usage_date}",
      "  end data",
      "",
      "  view",
      "    diagram ${5:diagram_id}",
      "  end view",
      "end card"
    ],
    "description": "Structured card (data + view)"
  },
  "Diagram module": {
    "prefix": "dsdiagram",
    "body": [
      "module diagram ${1:id}",
      "    namespace ${2:Demo.Diagrams}",
      "",
      "chrome",
      "  use ${3:bar_horizontal_360}",
      "end chrome",
      "",
      "bar",
      "  category = ${4:col}",
      "  value = ${5:metric}",
      "end bar"
    ],
    "description": "Diagram unit: module diagram <id> with chrome preset"
  },
  "Filter bind field": {
    "prefix": "dsfilter",
    "body": [
      "filter ${1:name}",
      "  bind field",
      "    column = ${2:column}",
      "  end bind",
      "  show",
      "    label = \"${3:Label}\"",
      "    widget = ${4|combobox,chips,select,day|}",
      "  end show",
      "end filter"
    ],
    "description": "Filter with bind + show"
  },
  "Phase browse detail": {
    "prefix": "dsphase",
    "body": [
      "phase browse",
      "  card ${1:browse} as \"${2:Browse}\" ref ${1:browse}",
      "    when ${3:user_name} empty",
      "    on click",
      "      set ${3:user_name} from y",
      "      focus detail",
      "    end click",
      "    data",
      "      datasource view ${4:demo.v_example}",
      "      bind ${5:usage_date}",
      "    end data",
      "    view",
      "      diagram ${6:diagram_id}",
      "    end view",
      "  end card",
      "end browse",
      "",
      "phase detail",
      "  card ${7:detail} as \"${8:Detail}\" ref ${7:detail}",
      "    when ${3:user_name}",
      "      message = \"${9:Select user first.}\"",
      "    end when",
      "    data",
      "      datasource view ${4:demo.v_example}",
      "      bind ${5:usage_date}, ${3:user_name}",
      "    end data",
      "    view",
      "      diagram ${10:diagram_id}",
      "    end view",
      "  end card",
      "end detail"
    ],
    "description": "Browse/detail phases (end-block syntax)"
  },
  "Chrome use preset": {
    "prefix": "dschrome",
    "body": [
      "chrome",
      "  use ${1:preset_id}",
      "end chrome"
    ],
    "description": "Chart chrome block with use preset"
  },
  "Presentation preset": {
    "prefix": "dspresentation",
    "body": [
      "module presentation ${1:id}",
      "    namespace ${2:Demo.Chrome}",
      "",
      "legend = ${3|bottom,top,none|}",
      "height = ${4:320}"
    ],
    "description": "Presentation unit: module presentation <id>"
  }
}
