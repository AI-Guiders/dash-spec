@tab analytics
    runtime
        manifest = "demo.toml"
    end runtime

    configuration
        sqldialect = tsql
        palette = "palettes/demo-apps.dashpalette"
    end configuration

    connect
        use palette demo_apps
    end connect

    report
        title = "Analytics"
        card period_peak_by_app as "Peak by app (period)"
            show flow
                period_grain -> [toolbar] chrome.card.period_peak_by_app
                period_start -> [toolbar] chrome.card.period_peak_by_app
            end show flow
            data flow
                period_peak_tz [rows] -> [rows] __diagram__
            end data flow
            diagram demo_period_peak_by_app_bar
                bind
                    period_grain, period_start, app_name
                end bind
            end card

            card peak_apps_heatmap as "**Peak apps** per user"
                data flow
                    peak_apps_tz [rows] -> [rows] __diagram__
                end data flow
                diagram demo_peak_apps_heatmap
                    bind
                        usage_date, user_name
                    end bind
                    legend
                        min = "min apps"
                        max = "max **{max}**"
                    end legend
                end card

                card idle_table as "Idle minutes (user × app)"
                    show flow
                        idle_top -> [toolbar] chrome.card.idle_table
                    end show flow
                    data flow
                        idle_tz [rows] -> [rows] __diagram__
                    end data flow
                    diagram demo_idle_table
                        bind
                            usage_date, user_name, app_name
                        end bind
                    end card

                    card idle_histogram as "Idle minutes (histogram)"
                        data flow
                            idle_tz [rows] -> [rows] __diagram__
                        end data flow
                        diagram demo_idle_histogram
                            bind
                                usage_date, user_name, app_name
                            end bind
                        end card

                        card idle_vs_peak_scatter as "Idle vs peak apps"
                            data flow
                                idle_scatter_tz [rows] -> [rows] __diagram__
                            end data flow
                            diagram demo_idle_vs_peak_scatter
                                bind
                                    usage_date, user_name, app_name
                                end bind
                            end card

                            card idle_by_app_box as "Idle minutes by app (box)"
                                data flow
                                    idle_tz [rows] -> [rows] __diagram__
                                end data flow
                                diagram demo_idle_by_app_box
                                    bind
                                        usage_date, user_name, app_name
                                    end bind
                                end card

                                card peak_by_app_treemap as "Peak by app (treemap)"
                                    show flow
                                        period_grain -> [toolbar] chrome.card.peak_by_app_treemap
                                        period_start -> [toolbar] chrome.card.peak_by_app_treemap
                                    end show flow
                                    data flow
                                        period_peak_tz [rows] -> [rows] __diagram__
                                    end data flow
                                    diagram demo_peak_by_app_treemap
                                        bind
                                            period_grain, period_start, app_name
                                        end bind
                                    end card

                                    card peak_gauge as "Peak concurrent (gauge)"
                                        data flow
                                            daily_peak_tz [rows] -> [rows] __diagram__
                                        end data flow
                                        diagram demo_peak_gauge
                                            bind
                                                usage_date, user_name, app_name
                                            end bind
                                        end card

                                        card peak_by_app_windrose as "Peak by app (wind rose)"
                                            show flow
                                                period_grain -> [toolbar] chrome.card.peak_by_app_windrose
                                                period_start -> [toolbar] chrome.card.peak_by_app_windrose
                                            end show flow
                                            data flow
                                                period_peak_tz [rows] -> [rows] __diagram__
                                            end data flow
                                            diagram demo_peak_by_app_windrose
                                                bind
                                                    period_grain, period_start, app_name
                                                end bind
                                            end card
                                        end report
                                    end tab
