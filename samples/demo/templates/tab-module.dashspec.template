# Tab module template — unit file (ADR-0101), referenced by id from a dashboard.
#   Dashboard: import tabs from Demo.MyTab   +   tab my_tab as "My tab"   (no body)
#   Units shared by namespace: import palettes / layouts / diagrams … from <Namespace> (ADR-0098).

module section my_tab
    namespace Demo.MyTab
    import palettes from Demo.Palettes

    runtime
        manifest = "demo.toml"
    end runtime

    configuration
        sqldialect = tsql
    end configuration

    connect
        use palette demo_apps
        layout grid
            columns = 12
            gap = 16
        end grid
    end connect

    report
        title = "My tab label"

        card my_card as "Example card"
            data flow
                my_rows [rows] -> [rows] __diagram__
            end data flow
            diagram my_diagram
                bind
                    usage_date, app_name
                end bind
            end card
        end report
end section
