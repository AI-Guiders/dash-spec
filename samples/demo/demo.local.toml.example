# Local override for demo-soak.dashspec — copy and set your server.
# Save as demo.local.toml (gitignored) or point @config in .dashspec to this file.

[connectors.sqlserver]
connection_string = "Server=YOUR_SERVER;Database=DashSpecDemo;Trusted_Connection=True;TrustServerCertificate=True"

[plugins]
default_connector_id = "sqlserver"

[[plugins.load]]
id = "sqlserver"
assembly = "DashSpec.Connector.SqlServer.dll"
