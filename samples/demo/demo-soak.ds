module dashboard demo_soak
    namespace Demo.Soak
    import tooltips from Demo.Tooltips
    import diagrams from Demo.Diagrams
    import types from Demo.Types
    import flows from Demo.Flows as demo_report_flow
    import palettes from Demo.Palettes
    import sections from Demo.Analytics
    import presentations from DashSpec.Std
    runtime
        manifest = "demo.toml"
    end runtime

    configuration
        sqldialect = tsql

    end configuration

    connect
        use palette demo_apps
        use flow demo_report_flow
    end connect

    report
        title = "DashSpec — Demo soak"
        defaults
            filter.usage_date.range = -7d..today
            filter.activity_slot.range = today
            filter.period_start.range = today
            filter.period_grain.scale = day
            filter.events_top.limit = 200
            filter.idle_top.limit = 100
        end defaults
        filters
            | id            | bind  | column                                        | label                     | widget   | grain        | single |
            | usage_date    | date  | usage_date                                    | Report date               | -        | period_grain | -      |
            | activity_slot | date  | bucket_start_utc                              | Day                       | day      | -            | true   |
            | period_start  | date  | period_start                                  | Period start              | day      | -            | -      |
            | app_name      | field | demo.v_daily_active_events.app_name           | Products                  | combobox | -            | -      |
            | user_name     | field | demo.v_events_detail.user_id                  | User                      | combobox | -            | -      |
            | period_grain  | field | demo.v_peak_concurrent_by_period.period_grain | Grain: day / month / year | combobox | -            | -      |
            | events_top    | top   | -                                             | Rows (TOP)                | -        | -            | -      |
            | idle_top      | top   | -                                             | Rows (TOP)                | -        | -            | -      |
        end filters
        toolbar chrome
            layout = bar
            sticky = line
            apply = auto
            debounce_ms = 400
        end chrome

        show flow
            usage_date -> [toolbar] chrome.dashboard
            user_name -> [toolbar] chrome.dashboard
            app_name -> [toolbar] chrome.dashboard
        end show flow

        section overview as "Overview"
            cards
                peak_concurrent_kpi
                peak_sparkline
                peak_concurrent_proxy
                peak_stacked_bar
                activity_5min
                activity_area
                dau_by_product
                dau_by_product_donut
            end cards
        end section

        section analytics as "Analytics"
            section detail as "Detail"
                cards
                    events_detail
                end cards
            end section

            card peak_concurrent_kpi as "Peak concurrent (max)"
                data flow
                    daily_peak_tz [rows] -> [rows] __diagram__
                end data flow
                diagram demo_peak_kpi
                    bind
                        usage_date, user_name, app_name
                    end bind
                end card

                card peak_sparkline as "Peak trend"
                    data flow
                        daily_peak_tz [rows] -> [rows] __diagram__
                    end data flow
                    diagram demo_peak_sparkline
                        bind
                            usage_date, user_name, app_name
                        end bind
                    end card

                    card peak_concurrent_proxy as "Peak concurrent (proxy)"
                        data flow
                            daily_peak_tz [rows] -> [rows] __diagram__
                        end data flow
                        diagram demo_peak_concurrent_line
                            bind
                                usage_date, user_name, app_name
                            end bind
                        end card

                        card peak_stacked_bar as "Peak by product (stacked)"
                            data flow
                                daily_peak_tz [rows] -> [rows] __diagram__
                            end data flow
                            diagram demo_peak_stacked_bar
                                bind
                                    usage_date, user_name, app_name
                                end bind
                            end card

                            card activity_5min as "Activity 5-min"
                                show flow
                                    activity_slot -> [toolbar] chrome.card.activity_5min
                                end show flow
                                data flow
                                    activity_tz [rows] -> [rows] __diagram__
                                end data flow
                                diagram demo_activity_5min_line
                                    bind
                                        usage_date, user_name, app_name
                                    end bind
                                end card

                                card activity_area as "Activity (area)"
                                    data flow
                                        activity_tz [rows] -> [rows] __diagram__
                                    end data flow
                                    diagram demo_activity_area
                                        bind
                                            usage_date, user_name, app_name
                                        end bind
                                    end card

                                    card dau_by_product as "DAU by product"
                                        data flow
                                            dau_tz [rows] -> [rows] __diagram__
                                        end data flow
                                        diagram demo_dau_bar
                                            bind
                                                usage_date, user_name, app_name
                                            end bind
                                        end card

                                        card dau_by_product_donut as "DAU by product (donut)"
                                            data flow
                                                dau_tz [rows] -> [rows] __diagram__
                                            end data flow
                                            diagram demo_dau_donut
                                                bind
                                                    usage_date, user_name, app_name
                                                end bind
                                            end card

                                            card events_detail as "Events detail"
                                                show flow
                                                    events_top -> [toolbar] chrome.card.events_detail
                                                end show flow
                                                data flow
                                                    events_tz [rows] -> [rows] __diagram__
                                                end data flow
                                                diagram demo_events_detail_table
                                                    bind
                                                        app_name, user_name
                                                    end bind
                                                end card
                                            end report
                                        end dashboard
