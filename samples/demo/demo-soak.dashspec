@config "demo.toml"
@sqldialect tsql
@diagramlibrary "demo-diagram-library.toml"

@dashboard demo_soak

dashboard "DashSpec — Demo soak" {
  connector sqlserver

  layout grid {
    columns = 12
    gap = 16
  }

  filter date usage_date on usage_date as "Report date" default -7d..today
  filter date activity_slot {
    column = bucket_start_utc as "Day"
    default = today
    widget = day
  }
  filter date period_start on period_start as "Period start" default -7d..today
  filter field app_name on demo.v_daily_active_users.app_name as "Products" widget combobox
  filter field user_name on demo.v_events_detail.user_id as "User" widget combobox
  filter field period_grain on demo.v_peak_concurrent_by_period.period_grain as "Grain: day / month / year"
  filter top events_top as "Rows (TOP)" default 200
  filter top idle_top as "Rows (TOP)" default 100

  toolbar chrome {
    layout = bar
    sticky = line
    apply = auto
    debounce_ms = 400
  }

  toolbar {
    usage_date
    user_name
    app_name
  }

  tab overview as "Overview" {
    cards {
      peak_concurrent_proxy
      activity_5min
      dau_by_product
    }
  }

  tab analytics as "Analytics" {
    cards {
      period_peak_by_app
      peak_apps_heatmap
      idle_table
    }
  }

  tab detail as "Detail" {
    cards { events_detail }
  }

  card peak_concurrent_proxy as "Peak concurrent (proxy)" {
    use demo_peak_concurrent
  }

  card activity_5min as "Activity 5-min" {
    filters { activity_slot }
    use demo_activity_5min
  }

  card dau_by_product as "DAU by product" {
    use demo_dau_bar
  }

  card events_detail as "Events detail" {
    filters { events_top }
    use demo_events_detail
  }

  card period_peak_by_app as "Peak by app (period)" {
    filters { period_grain, period_start }
    use demo_period_peak_by_app
  }

  card peak_apps_heatmap as "**Peak apps** per user" {
    use demo_peak_apps_heatmap
    legend {
      min = "min apps"
      max = "max **{max}**"
    }
  }

  card idle_table as "Idle minutes (user × app)" {
    filters { idle_top }
    use demo_idle_table
  }
}
