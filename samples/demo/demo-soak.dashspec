@dashboard demo_soak
  runtime
  manifest = "demo.toml"
  end runtime
  configuration
  sqldialect = tsql
  palette = "palettes/demo-apps.dashpalette"
  end configuration
  !include "diagrams/*.dashdiagram"
  wiring
  use connector sqlserver
  use palette demo_apps
  layout grid
  columns = 12
  gap = 16
  end grid
  end wiring
  report
  title = "DashSpec — Demo soak"
  filter date usage_date on usage_date as "Report date" default -7d..today
  filter date activity_slot on bucket_start_utc as "Day" default today widget day
  filter date period_start on period_start as "Period start" default today widget day grain_filter period_grain
  filter field app_name on demo.v_daily_active_users.app_name as "Products" widget combobox
  filter field user_name on demo.v_events_detail.user_id as "User" widget combobox
  filter field period_grain on demo.v_peak_concurrent_by_period.period_grain as "Grain: day / month / year" default day widget combobox single
  filter top events_top as "Rows (TOP)" default 200
  filter top idle_top as "Rows (TOP)" default 100
  toolbar chrome
  layout = bar
  sticky = line
  apply = auto
  debounce_ms = 400
  end chrome
  toolbar
  usage_date
  user_name
  app_name
  end toolbar
  tab overview as "Overview"
  cards
  peak_concurrent_kpi
  peak_sparkline
  peak_concurrent_proxy
  peak_stacked_bar
  activity_5min
  activity_area
  dau_by_product
  dau_by_product_donut
  end cards
  end tab
  tab analytics as "Analytics" dashspec "demo-analytics.dashspec"
  tab detail as "Detail"
  cards
  events_detail
  end cards
  end tab
  card peak_concurrent_kpi as "Peak concurrent (max)"
  diagram demo_peak_kpi
  datasource view demo.v_daily_peak_concurrent_proxy
  bind
    usage_date, user_name, app_name
  end bind
  end card
  card peak_sparkline as "Peak trend"
  diagram demo_peak_sparkline
  datasource view demo.v_daily_peak_concurrent_proxy
  bind
    usage_date, user_name, app_name
  end bind
  end card
  card peak_concurrent_proxy as "Peak concurrent (proxy)"
  diagram demo_peak_concurrent_line
  datasource view demo.v_daily_peak_concurrent_proxy
  bind
    usage_date, user_name, app_name
  end bind
  end card
  card peak_stacked_bar as "Peak by product (stacked)"
  diagram demo_peak_stacked_bar
  datasource view demo.v_daily_peak_concurrent_proxy
  bind
    usage_date, user_name, app_name
  end bind
  end card
  card activity_5min as "Activity 5-min"
  filters
    activity_slot
  end filters
  diagram demo_activity_5min_line
  datasource view demo.v_five_minute_activity
  bind
    usage_date, user_name, app_name
  end bind
  end card
  card activity_area as "Activity (area)"
  diagram demo_activity_area
  datasource view demo.v_five_minute_activity
  bind
    usage_date, user_name, app_name
  end bind
  end card
  card dau_by_product as "DAU by product"
  diagram demo_dau_bar
  datasource view demo.v_daily_active_users
  bind
    usage_date, user_name, app_name
  end bind
  end card
  card dau_by_product_donut as "DAU by product (donut)"
  diagram demo_dau_donut
  datasource view demo.v_daily_active_users
  bind
    usage_date, user_name, app_name
  end bind
  end card
  card events_detail as "Events detail"
  filters
    events_top
  end filters
  diagram demo_events_detail_table
  datasource view demo.v_events_detail
  bind
    app_name, user_name
  end bind
  end card
  end report
  end dashboard
