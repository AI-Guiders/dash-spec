module flow demo_report
namespace Demo.Flows

source daily_peak_raw: FixtureRow = View(demo.v_daily_peak_concurrent_proxy) {
  use provider infer
}

transformer daily_peak_tz {
  transform use to_zone { zone = UTC+3 }
}

daily_peak_raw [rows] -> [rows] daily_peak_tz

source activity_raw: FixtureRow = View(demo.v_five_minute_events) {
  use provider infer
}

transformer activity_tz {
  transform use to_zone { zone = UTC+3 }
}

activity_raw [rows] -> [rows] activity_tz

source dau_raw: FixtureRow = View(demo.v_daily_active_events) {
  use provider infer
}

transformer dau_tz {
  transform use to_zone { zone = UTC+3 }
}

dau_raw [rows] -> [rows] dau_tz

source period_peak_raw: FixtureRow = View(demo.v_peak_concurrent_by_period) {
  use provider infer
}

transformer period_peak_tz {
  transform use to_zone { zone = UTC+3 }
}

period_peak_raw [rows] -> [rows] period_peak_tz

source peak_apps_raw: FixtureRow = View(demo.v_daily_peak_concurrent_apps_per_user) {
  use provider infer
}

transformer peak_apps_tz {
  transform use to_zone { zone = UTC+3 }
}

peak_apps_raw [rows] -> [rows] peak_apps_tz

source idle_raw: FixtureRow = View(demo.v_daily_idle_minutes_by_user_app) {
  use provider infer
}

transformer idle_tz {
  transform use to_zone { zone = UTC+3 }
}

idle_raw [rows] -> [rows] idle_tz

source idle_scatter_raw: FixtureRow = SqlFile("sql/idle-vs-peak-scatter.sql") {
  use provider infer
}

transformer idle_scatter_tz {
  transform use to_zone { zone = UTC+3 }
}

idle_scatter_raw [rows] -> [rows] idle_scatter_tz

source events_raw: EventDetailRow = View(demo.v_events_detail) {
  use provider infer
}

transformer events_tz {
  transform use to_zone { zone = UTC+3 }
}

events_raw [rows] -> [rows] events_tz

end flow demo_report
