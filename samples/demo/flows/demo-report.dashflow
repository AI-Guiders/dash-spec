@flow demo_report

source daily_peak_raw {
  use provider infer
  from view demo.v_daily_peak_concurrent_proxy
  ports
    default output raw
    output stream raw: FixtureRow
  end ports
}

transformer daily_peak_tz {
  ports
    default input raw
    default output rows
    input stream raw: FixtureRow
    output stream rows: FixtureRow
  end ports
  transform use to_zone { zone = UTC+3 }
}

daily_peak_raw [raw] -> [raw] daily_peak_tz

