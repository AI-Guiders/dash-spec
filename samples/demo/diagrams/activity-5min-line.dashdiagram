@diagram demo_activity_5min_line

include presentation "../presentations/line-right-360.dashpresentation"

series {
  max = 6
  other = "Other"
}

line {
  render = "chartjs"
  x = bucket_start_utc
  x_format = time.short
  x_step = 5m
  y = event_count
  scale_y = integer
  series = app_name
}
