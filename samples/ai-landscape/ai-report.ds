module dashboard ai_report
    namespace Ai.Landscape.Report
    import diagrams from Ai.Landscape.Diagrams
    import types from Ai.Landscape.Types
    import flows from Ai.Landscape.Flows as ai_flows
    import presentations from DashSpec.Std
    import runtimes from Ai.Landscape.Runtime
    import defaults from Ai.Landscape.Defaults

    connect
        use flow ai_flows
    end connect

    report
        title = "AI Landscape 2023-2024 — Epoch AI open data"
        filters
            | id            | bind  | column        | label      | widget   |
            | domain        | field | domain        | Direction  | combobox |
            | accessibility | field | accessibility | Weights    | combobox |
            | models_top    | top   | -             | Rows (TOP) | -        |
        end filters
        toolbar chrome
            layout = bar
            sticky = line
            apply = auto
            debounce_ms = 400
        end chrome

        show flow
            domain -> [toolbar] chrome.dashboard
            accessibility -> [toolbar] chrome.dashboard
        end show flow

        section overview as "Обзор"
            cards
                kpi_cost
                kpi_params
                releases_line
            end cards
        end section

        section directions as "Что делают"
            cards
                domain_bar
                access_donut
            end cards
        end section

        section countries as "Кто делает"
            cards
                country_bar_2023
                country_bar_2024
            end cards
        end section

        section registry as "Реестр моделей"
            cards
                models_table
            end cards
        end section

        card kpi_cost as "Max training cost, $M"
            layout
                place
                    row = 1
                    col = 1
                    span = 6
                end place
            end layout
            when
                | state | message |
                | no data | Training cost is not disclosed for any model in this slice |
            end when
            data flow
                models [rows] -> [rows] __diagram__
            end data flow
            diagram ai_kpi_cost
                bind
                    domain, accessibility
                end bind
            end card

        card kpi_params as "Max parameters, B"
            layout
                place
                    row = 1
                    col = 7
                    span = 6
                end place
            end layout
            data flow
                models [rows] -> [rows] __diagram__
            end data flow
            diagram ai_kpi_params
                bind
                    domain, accessibility
                end bind
            end card

        card releases_line as "Releases per day"
            layout
                place
                    row = 2
                    col = 1
                    span = 12
                end place
            end layout
            data flow
                by_release_day [rows] -> [rows] __diagram__
            end data flow
            diagram ai_releases_line
                bind
                    domain, accessibility
                end bind
            end card

        card domain_bar as "Models by direction"
            layout
                place
                    row = 3
                    col = 1
                    span = 6
                end place
            end layout
            data flow
                by_domain [rows] -> [rows] __diagram__
            end data flow
            diagram ai_domain_bar
                bind
                    accessibility
                end bind
            end card

        card access_donut as "Open vs closed weights"
            layout
                place
                    row = 3
                    col = 7
                    span = 6
                end place
            end layout
            data flow
                by_access [rows] -> [rows] __diagram__
            end data flow
            diagram ai_access_donut
            end card

        card country_bar_2023 as "Models by country, 2023"
            layout
                place
                    row = 4
                    col = 1
                    span = 6
                end place
            end layout
            data flow
                by_country_2023 [rows] -> [rows] __diagram__
            end data flow
            diagram ai_country_bar_2023
            end card

        card country_bar_2024 as "Models by country, 2024"
            layout
                place
                    row = 4
                    col = 7
                    span = 6
                end place
            end layout
            data flow
                by_country_2024 [rows] -> [rows] __diagram__
            end data flow
            diagram ai_country_bar_2024
            end card

        card models_table as "Model registry"
            layout
                place
                    row = 5
                    col = 1
                    span = 12
                end place
            end layout
            show flow
                models_top -> [toolbar] chrome.card.models_table
            end show flow
            data flow
                models [rows] -> [rows] __diagram__
            end data flow
            diagram ai_models_table
                bind
                    domain, accessibility
                end bind
            end card
    end report