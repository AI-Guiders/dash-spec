@page "/help"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using DashSpec.Execution.Compilation
@using DashSpec.Modeling.Parse.Syntax
@using DashSpec.Presentation.Components
@using DashSpec.Surface.Blazor.Services.Presentation
@using DashSpec.Viz
@using Microsoft.FSharp.Core
@inject CatalogSourceState CatalogState
@inject DashSpec.Surface.Blazor.Commands.IDashboardCultureAmbient CultureAmbient
@inject DashSpec.Surface.Blazor.Services.Localization.DashboardLocalizer Loc
@inject ICardChromeControlsOverride ChromeControls

<PageTitle>@(_book?.Title ?? "Documentation") — DashSpec</PageTitle>

@if (_book is not null)
{
    @if (ChromeControls.ResolveDocPortal() is { } stackDocPortal)
    {
        <DynamicComponent Type="stackDocPortal"
                          Parameters="@(new Dictionary<string, object?>
                          {
                              ["Context"] = new StackDocPortalContext
                              {
                                  Book = _book,
                                  ActivePage = _activePage,
                                  ActiveSymbol = _activeSymbol,
                                  Search = _search,
                                  TreeCollapsed = _treeCollapsed,
                                  TocCollapsed = _tocCollapsed,
                                  ExpandedPages = _expandedPages,
                                  OnSearchChanged = EventCallback.Factory.Create<string>(this, val => _search = val),
                                  OnToggleTree = EventCallback.Factory.Create(this, ToggleTreePane),
                                  OnToggleToc = EventCallback.Factory.Create(this, ToggleTocPane),
                                  OnSelectChapter = EventCallback.Factory.Create<DashSpecCompiledBookPage>(this, SelectChapter),
                                  OnToggleChapter = EventCallback.Factory.Create<DashSpecCompiledBookPage>(this, ToggleOrSelectChapter),
                                  OnSelectSymbol = EventCallback.Factory.Create<(DashSpecCompiledBookPage? Page, DashSpecSymbolDoc Symbol)>(this, pair => SelectSymbol(pair.Page, pair.Symbol)),
                                  OnNavigateToSymbolId = EventCallback.Factory.Create<string>(this, NavigateToSymbolById),
                                  RenderRichText = RenderRichTextFragment,
                                  RenderEmbeddedReport = RenderEmbeddedReportFragment,
                              },
                          })" />
    }
    else
    {
    var chrome = _book.Template.Chrome;
    var hasTreeSlot = _book.ShellSlots.Contains("tree", StringComparer.OrdinalIgnoreCase);
    var hasTocSlot = chrome.ShowToc && _book.ShellSlots.Contains("toc", StringComparer.OrdinalIgnoreCase);
    var showTreePane = hasTreeSlot && !_treeCollapsed;
    var showTocPane = hasTocSlot && !_tocCollapsed;

    <section class="help-page">
        <header class="dox-topbar">
            <div class="dox-topbar-group">
                @if (hasTreeSlot)
                {
                    <button type="button"
                            class="dox-toggle-btn @(showTreePane ? "is-active" : null)"
                            title="@(showTreePane ? "Collapse navigation tree" : "Expand navigation tree")"
                            @onclick="ToggleTreePane">
                        <span>@(showTreePane ? "«" : "»")</span>
                        <span>Tree</span>
                    </button>
                }
                <strong style="font-size: 0.85rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 280px;" title="@_book.Title">@_book.Title</strong>
                <span class="badge" style="white-space: nowrap; flex-shrink: 0;">@_book.Template.Id</span>
            </div>

            @if (chrome.ShowSearch)
            {
                <div class="dox-topbar-center">
                    <input type="search"
                           class="dox-search"
                           placeholder="Search symbols, modules, transforms, types, rules…"
                           @bind="_search"
                           @bind:event="oninput" />
                </div>
            }

            <div class="dox-topbar-group" style="flex-shrink: 0;">
                @if (hasTocSlot)
                {
                    <button type="button"
                            class="dox-toggle-btn @(showTocPane ? "is-active" : null)"
                            title="@(showTocPane ? "Collapse On this page outline" : "Expand On this page outline")"
                            @onclick="ToggleTocPane">
                        <span>On this page</span>
                        <span>@(showTocPane ? "»" : "«")</span>
                    </button>
                }
            </div>
        </header>

        <div class="dox-shell" style="@($"grid-template-columns: {ComputeShellGridColumns(chrome, showTreePane, showTocPane)};")">
            @* 1. Left Doxygen Navigation Tree (tree slot) *@
            @if (showTreePane)
            {
            <aside class="dox-sidebar" aria-label="Documentation Tree">
                <div class="dox-nav-group">
                    @foreach (var pageItem in _book.Pages)
                    {
                        var units = FilteredPageUnits(pageItem);
                        if (!string.IsNullOrWhiteSpace(_search) && units.Count == 0 && !PageMatchesSearch(pageItem))
                        {
                            continue;
                        }

                        var isChapterActive = _activePage?.Id == pageItem.Id && _activeSymbol is null;
                        var isExpanded = _expandedPages.Contains(pageItem.Id) || !string.IsNullOrWhiteSpace(_search);

                        <button type="button"
                                class="dox-nav-chapter @(isChapterActive ? "is-active" : null)"
                                @onclick="() => ToggleOrSelectChapter(pageItem)">
                            <span style="display: inline-flex; align-items: center; gap: 0.4rem;">
                                <span class="muted" style="font-size: 0.72rem; width: 0.85rem; display: inline-block;">@(pageItem.SymbolSections.Count > 0 ? (isExpanded ? "▾" : "▸") : "•")</span>
                                <span>@pageItem.Title</span>
                            </span>
                            @if (units.Count > 0)
                            {
                                <span class="badge">@units.Count</span>
                            }
                        </button>

                        @if (isExpanded && pageItem.SymbolSections.Count > 0)
                        {
                            <ul class="dox-nav-items">
                                @foreach (var sec in pageItem.SymbolSections)
                                {
                                    var secUnits = FilterSymbolList(sec.Units);
                                    if (secUnits.Count == 0)
                                    {
                                        continue;
                                    }

                                    @if (pageItem.SymbolSections.Count > 1)
                                    {
                                        <li class="dox-nav-subgroup-label">@FormatNavGroupBadge(sec.CategoryId, sec.CategoryTitle) (@secUnits.Count)</li>
                                    }

                                    @foreach (var unit in secUnits)
                                    {
                                        var isSymActive = _activeSymbol is not null &&
                                                          string.Equals(_activeSymbol.Id, unit.Id, StringComparison.OrdinalIgnoreCase) &&
                                                          string.Equals(_activeSymbol.Kind, unit.Kind, StringComparison.OrdinalIgnoreCase);
                                        var badgeTag = GetSymbolPrimaryBadge(unit);
                                        <li>
                                            <button type="button"
                                                    class="dox-nav-item @(isSymActive ? "is-active" : null)"
                                                    title="@unit.Signature"
                                                    @onclick="() => SelectSymbol(pageItem, unit)">
                                                <span style="flex: 1; overflow: hidden; text-overflow: ellipsis;">@unit.Id</span>
                                                @if (!string.IsNullOrWhiteSpace(badgeTag))
                                                {
                                                    <span class="badge" style="font-size: 0.65rem; padding: 0.05rem 0.3rem;">@badgeTag</span>
                                                }
                                            </button>
                                        </li>
                                    }
                                }
                            </ul>
                        }
                    }
                </div>
            </aside>
            }

            @* 2. Center Doxygen Detail Pane (@article slot) *@
            <article class="dox-main">
                @if (_activeSymbol is not null)
                {
                    var sym = _activeSymbol;
                    var symTitle = FSharpOption<string>.get_IsSome(sym.Title) && !string.IsNullOrWhiteSpace(sym.Title.Value)
                        ? sym.Title.Value
                        : sym.Id;
                    var symNs = FSharpOption<string>.get_IsSome(sym.Namespace) ? sym.Namespace.Value : null;
                    var symPath = FSharpOption<string>.get_IsSome(sym.SourcePath) ? $"{sym.SourcePath.Value}:{sym.Line}" : null;

                    @if (chrome.ShowBreadcrumbs)
                    {
                    <nav class="dox-breadcrumbs" aria-label="Breadcrumbs">
                        <button type="button" class="dox-crumb-btn" @onclick="() => SelectChapter(_book.Pages[0])">@_book.Title</button>
                        @if (_activePage is not null)
                        {
                            <span>/</span>
                            <button type="button" class="dox-crumb-btn" @onclick="() => SelectChapter(_activePage)">@_activePage.Title</button>
                        }
                        @if (!string.IsNullOrWhiteSpace(symNs))
                        {
                            <span>/</span>
                            <span class="badge">@symNs</span>
                        }
                        <span>/</span>
                        <code>@sym.Id</code>
                    </nav>
                    }

                    <header class="dox-title-row">
                        <div>
                            <h1>@symTitle</h1>
                            @if (!string.Equals(symTitle, sym.Id, StringComparison.OrdinalIgnoreCase))
                            {
                                <div class="muted" style="font-family: ui-monospace, Consolas, monospace; font-size: 0.88rem; margin-top: 0.2rem;">@sym.Kind @sym.Id</div>
                            }
                        </div>
                        <div style="display: flex; align-items: center; gap: 0.35rem; flex-wrap: wrap;">
                            @foreach (var tag in sym.Tags)
                            {
                                <span class="badge">@tag.TagKey = @tag.TagValue</span>
                            }
                            <span class="badge">@sym.Kind</span>
                        </div>
                    </header>

                    <div class="dox-decl-box">
                        <code>@sym.Signature</code>
                        @if (!string.IsNullOrWhiteSpace(symPath))
                        {
                            <span class="badge">@symPath</span>
                        }
                    </div>

                    @if (!string.IsNullOrWhiteSpace(sym.Markdown))
                    {
                        <div class="dox-prose">
                            @foreach (var paragraph in SplitParagraphs(sym.Markdown))
                            {
                                <p style="margin: 0 0 0.65rem;"><RichTextView Text="@paragraph" /></p>
                            }
                        </div>
                    }

                    @* Group children by Doxygen member kind (block, clause, type, field, port, param, source, transformer, card, filter, row, property) *@
                    @foreach (var group in sym.Children.GroupBy(c => c.Kind))
                    {
                        <section>
                            <h2 class="dox-section-title">@FormatMemberGroupTitle(group.Key) (@group.Count())</h2>
                            <table class="dox-table">
                                <thead>
                                    <tr>
                                        <th style="width: 24%;">Identifier</th>
                                        <th style="width: 30%;">Declaration / Syntax</th>
                                        <th>Description</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var memberItem in group)
                                    {
                                        var memberTitle = FSharpOption<string>.get_IsSome(memberItem.Title) && !string.IsNullOrWhiteSpace(memberItem.Title.Value)
                                            ? memberItem.Title.Value
                                            : null;
                                        <tr>
                                            <td>
                                                @if (memberItem.Children.Length > 0 && memberItem.Kind is not "block")
                                                {
                                                    <button type="button"
                                                            class="dox-sym-link"
                                                            @onclick="() => SelectSymbol(_activePage, memberItem)">
                                                        @memberItem.Id
                                                    </button>
                                                }
                                                else
                                                {
                                                    <code>@memberItem.Id</code>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(memberTitle))
                                                {
                                                    <div class="muted" style="font-size: 0.78rem; margin-top: 0.15rem;">@memberTitle</div>
                                                }
                                            </td>
                                            <td>
                                                <code>@memberItem.Signature</code>
                                                @foreach (var linkedType in FindReferencedSymbols(memberItem))
                                                {
                                                    <div style="margin-top: 0.2rem;">
                                                        <span class="muted" style="font-size: 0.74rem;">→ </span>
                                                        <button type="button"
                                                                class="dox-sym-link"
                                                                style="font-size: 0.78rem;"
                                                                @onclick="() => NavigateToSymbolById(linkedType.Id)">
                                                            @linkedType.Id
                                                        </button>
                                                    </div>
                                                }
                                            </td>
                                            <td>
                                                @if (!string.IsNullOrWhiteSpace(memberItem.Markdown))
                                                {
                                                    <RichTextView Text="@memberItem.Markdown" />
                                                }
                                                @if (memberItem.Children.Length > 0)
                                                {
                                                    <div style="margin-top: 0.35rem; display: flex; flex-direction: column; gap: 0.2rem;">
                                                        @foreach (var sub in memberItem.Children.Take(16))
                                                        {
                                                            <div style="font-size: 0.8rem;">
                                                                <code>@sub.Signature</code>
                                                                @if (!string.IsNullOrWhiteSpace(sub.Markdown))
                                                                {
                                                                    <span class="muted"> — <RichTextView Text="@sub.Markdown" /></span>
                                                                }
                                                            </div>
                                                        }
                                                        @if (memberItem.Children.Length > 16)
                                                        {
                                                            <div class="muted" style="font-size: 0.76rem;">+@(memberItem.Children.Length - 16) more grammar clauses/properties</div>
                                                        }
                                                    </div>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </section>
                    }
                }
                else if (_activePage is not null)
                {
                    var chapter = _activePage;
                    <nav class="dox-breadcrumbs" aria-label="Breadcrumbs">
                        <span>@_book.Title</span>
                        <span>/</span>
                        <code>@chapter.Id</code>
                    </nav>

                    <header class="dox-title-row">
                        <h1>@chapter.Title</h1>
                        <span class="badge">page @chapter.Id</span>
                    </header>

                    @if (!string.IsNullOrWhiteSpace(chapter.Markdown))
                    {
                        <div class="dox-prose">
                            @foreach (var paragraph in SplitParagraphs(chapter.Markdown))
                            {
                                <p style="margin: 0 0 0.75rem;"><RichTextView Text="@paragraph" /></p>
                            }
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(chapter.EmbeddedReportUnit))
                    {
                        <section>
                            <DashSpecEmbeddedReport CatalogEntryId="@chapter.EmbeddedReportUnit"
                                                    SourceLabel="@($"doc:{chapter.Id}")" />
                        </section>
                    }

                    @foreach (var sub in chapter.SubSections)
                    {
                        var subUnits = FilteredPageUnits(sub);
                        if (!string.IsNullOrWhiteSpace(_search) && subUnits.Count == 0 && !PageMatchesSearch(sub))
                        {
                            continue;
                        }

                        <section>
                            <h2 class="dox-section-title">
                                @sub.Title
                                @if (subUnits.Count > 0)
                                {
                                    <span class="muted" style="font-weight: 400; font-size: 0.92rem;"> (@subUnits.Count)</span>
                                }
                            </h2>
                            @if (!string.IsNullOrWhiteSpace(sub.Markdown))
                            {
                                <div class="dox-prose">
                                    @foreach (var paragraph in SplitParagraphs(sub.Markdown))
                                    {
                                        <p style="margin: 0 0 0.65rem;"><RichTextView Text="@paragraph" /></p>
                                    }
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(sub.EmbeddedReportUnit))
                            {
                                <DashSpecEmbeddedReport CatalogEntryId="@sub.EmbeddedReportUnit"
                                                        SourceLabel="@($"doc:{chapter.Id}.{sub.Id}")" />
                            }
                            @foreach (var subSec in sub.SymbolSections)
                            {
                                var secUnits = FilterSymbolList(subSec.Units);
                                if (secUnits.Count == 0)
                                {
                                    continue;
                                }
                                @RenderSymbolTable(chapter, secUnits)
                            }
                        </section>
                    }

                    @if (!chapter.SubSections.Any(s => s.SymbolSections.Count > 0))
                    {
                        @foreach (var sec in chapter.SymbolSections)
                        {
                            var units = FilterSymbolList(sec.Units);
                            if (units.Count == 0)
                            {
                                continue;
                            }

                            <section>
                                <h2 class="dox-section-title">@sec.CategoryTitle (@units.Count)</h2>
                                @RenderSymbolTable(chapter, units)
                            </section>
                        }
                    }
                }
            </article>

            @* 3. Right On-This-Page Outline (toc slot) *@
            @if (showTocPane)
            {
            <aside class="dox-toc" aria-label="On this page">
                <p class="dox-toc-heading">On this page</p>
                @if (_activeSymbol is not null)
                {
                    <ul class="dox-toc-list">
                        <li><code>@_activeSymbol.Id</code></li>
                        @foreach (var grp in _activeSymbol.Children.GroupBy(c => c.Kind))
                        {
                            <li class="muted" style="margin-top: 0.25rem; font-weight: 600;">@FormatMemberGroupTitle(grp.Key) (@grp.Count())</li>
                            @foreach (var item in grp.Take(14))
                            {
                                <li style="padding-left: 0.55rem;">
                                    @if (item.Children.Length > 0 && item.Kind is not "block")
                                    {
                                        <button type="button"
                                                class="dox-crumb-btn"
                                                style="font-family: ui-monospace, Consolas, monospace; font-size: 0.76rem;"
                                                @onclick="() => SelectSymbol(_activePage, item)">
                                            @item.Id
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="muted" style="font-family: ui-monospace, Consolas, monospace; font-size: 0.76rem;">@item.Id</span>
                                    }
                                </li>
                            }
                        }
                    </ul>
                }
                else if (_activePage is not null)
                {
                    <ul class="dox-toc-list">
                        <li><strong>@_activePage.Title</strong></li>
                        @foreach (var sec in _activePage.SymbolSections)
                        {
                            @if (_activePage.SymbolSections.Count > 1)
                            {
                                <li class="muted" style="margin-top: 0.25rem; font-weight: 600;">@FormatNavGroupBadge(sec.CategoryId, sec.CategoryTitle)</li>
                            }
                            @foreach (var u in FilterSymbolList(sec.Units).Take(16))
                            {
                                <li style="padding-left: 0.35rem;">
                                    <button type="button"
                                            class="dox-crumb-btn"
                                            style="font-family: ui-monospace, Consolas, monospace; font-size: 0.76rem;"
                                            @onclick="() => SelectSymbol(_activePage, u)">
                                        @u.Id
                                    </button>
                                </li>
                            }
                        }
                        @if (_activePage.SymbolSections.Count == 0)
                        {
                            @foreach (var sub in _activePage.SubSections)
                            {
                                <li class="muted">@sub.Title</li>
                            }
                        }
                    </ul>
                }
                <div style="margin-top: 0.75rem; padding-top: 0.65rem; border-top: 1px solid var(--border); font-size: 0.74rem;" class="muted">
                    CLI: <code>dsc doc --stdlib</code>
                </div>
            </aside>
            }
        </div>
    </section>
    }
}
else
{
    <div class="page-loading">
        <div class="spinner" aria-hidden="true"></div>
        <span>Loading documentation book…</span>
    </div>
}

@code {
    private DashSpecCompiledBook? _book;
    private DashSpecCompiledBookPage? _activePage;
    private DashSpecSymbolDoc? _activeSymbol;
    private readonly HashSet<string> _expandedPages = new(StringComparer.OrdinalIgnoreCase);
    private string _search = "";
    private bool _treeCollapsed;
    private bool _tocCollapsed;

    private void ToggleTreePane() => _treeCollapsed = !_treeCollapsed;
    private void ToggleTocPane() => _tocCollapsed = !_tocCollapsed;

    private RenderFragment RenderRichTextFragment(string text) => __builder =>
    {
        <RichTextView Text="@text" />
    };

    private RenderFragment RenderEmbeddedReportFragment(string entryId, string sourceLabel) => __builder =>
    {
        <DashSpecEmbeddedReport CatalogEntryId="@entryId" SourceLabel="@sourceLabel" />
    };

    private static string ComputeShellGridColumns(
        DashSpec.Modeling.Parse.Template.TemplateChromeOptions chrome,
        bool showTree,
        bool showToc)
    {
        var cols = new List<string>();
        if (showTree)
        {
            cols.Add($"clamp(220px, 24vw, {chrome.TreeWidthPx}px)");
        }
        cols.Add("minmax(0, 1fr)");
        if (showToc)
        {
            cols.Add($"clamp(185px, 20vw, {chrome.TocWidthPx}px)");
        }
        return string.Join(" ", cols);
    }

    protected override async Task OnInitializedAsync()
    {
        await Task.Yield();
        var lang = CultureAmbient.Culture.Name;
        var catalogDir = Path.GetDirectoryName(CatalogState.Current.FullPath);
        _book = await Task.Run(() => DashSpecDocGenerator.BuildDocumentationBook(catalogDir, lang));
        foreach (var p in _book.Pages)
        {
            _expandedPages.Add(p.Id);
        }
        if (_book.Pages.Count > 0)
        {
            _activePage = _book.Pages[0];
        }
    }

    private RenderFragment RenderSymbolTable(DashSpecCompiledBookPage chapter, IReadOnlyList<DashSpecSymbolDoc> units) => __builder =>
    {
        <table class="dox-table">
            <thead>
                <tr>
                    <th style="width: 24%;">Symbol / Unit</th>
                    <th style="width: 28%;">Declaration / Class</th>
                    <th>Description</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var unit in units)
                {
                    var uTitle = FSharpOption<string>.get_IsSome(unit.Title) && !string.IsNullOrWhiteSpace(unit.Title.Value)
                        ? unit.Title.Value
                        : null;
                    var uSrc = FSharpOption<string>.get_IsSome(unit.SourcePath) ? $"{unit.SourcePath.Value}:{unit.Line}" : null;
                    <tr>
                        <td>
                            <button type="button"
                                    class="dox-sym-link"
                                    @onclick="() => SelectSymbol(chapter, unit)">
                                @unit.Id
                            </button>
                            <div style="display: flex; align-items: center; gap: 0.25rem; flex-wrap: wrap; margin-top: 0.2rem;">
                                <span class="muted" style="font-size: 0.74rem; font-family: ui-monospace, Consolas, monospace;">@unit.Kind</span>
                                @foreach (var tag in unit.Tags)
                                {
                                    <span class="badge" style="font-size: 0.67rem; padding: 0.05rem 0.35rem;">@tag.TagKey: @tag.TagValue</span>
                                }
                            </div>
                        </td>
                        <td>
                            <code style="font-size: 0.78rem;">@unit.Signature</code>
                            @if (!string.IsNullOrWhiteSpace(uSrc))
                            {
                                <div class="muted" style="font-size: 0.72rem; margin-top: 0.15rem;">@uSrc</div>
                            }
                        </td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(uTitle) && !string.Equals(uTitle, unit.Id, StringComparison.OrdinalIgnoreCase))
                            {
                                <div style="font-weight: 600; margin-bottom: 0.2rem;">@uTitle</div>
                            }
                            @if (!string.IsNullOrWhiteSpace(unit.Markdown))
                            {
                                <RichTextView Text="@unit.Markdown" />
                            }
                            @if (unit.Children.Length > 0)
                            {
                                <div class="muted" style="font-size: 0.76rem; margin-top: 0.25rem;">
                                    Grammar / Members: @string.Join(", ", unit.Children.Take(8).Select(c => c.Id))@(unit.Children.Length > 8 ? $" (+{unit.Children.Length - 8})" : "")
                                </div>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    };

    private void ToggleOrSelectChapter(DashSpecCompiledBookPage page)
    {
        if (_activePage?.Id == page.Id && _activeSymbol is null)
        {
            if (!_expandedPages.Remove(page.Id))
            {
                _expandedPages.Add(page.Id);
            }
        }
        else
        {
            _activePage = page;
            _activeSymbol = null;
            _expandedPages.Add(page.Id);
        }
    }

    private void SelectChapter(DashSpecCompiledBookPage page)
    {
        _activePage = page;
        _activeSymbol = null;
    }

    private void SelectSymbol(DashSpecCompiledBookPage? parentPage, DashSpecSymbolDoc symbol)
    {
        if (parentPage is not null)
        {
            _activePage = parentPage;
            _expandedPages.Add(parentPage.Id);
        }
        _activeSymbol = symbol;
    }

    private void NavigateToSymbolById(string symbolId)
    {
        if (_book is null)
        {
            return;
        }

        foreach (var page in _book.Pages)
        {
            foreach (var sec in page.SymbolSections)
            {
                foreach (var unit in sec.Units)
                {
                    if (string.Equals(unit.Id, symbolId, StringComparison.OrdinalIgnoreCase))
                    {
                        SelectSymbol(page, unit);
                        return;
                    }

                    var child = unit.Children.FirstOrDefault(c =>
                        string.Equals(c.Id, symbolId, StringComparison.OrdinalIgnoreCase));
                    if (child is not null)
                    {
                        SelectSymbol(page, child.Children.Length > 0 ? child : unit);
                        return;
                    }
                }
            }
        }
    }

    private IReadOnlyList<DashSpecSymbolDoc> FilteredPageUnits(DashSpecCompiledBookPage page) =>
        page.SymbolSections
            .SelectMany(s => FilterSymbolList(s.Units))
            .ToList();

    private IReadOnlyList<DashSpecSymbolDoc> FilterSymbolList(IReadOnlyList<DashSpecSymbolDoc> units)
    {
        if (string.IsNullOrWhiteSpace(_search))
        {
            return units;
        }

        var q = _search.Trim();
        return units.Where(u => SymbolMatches(u, q)).ToList();
    }

    private bool PageMatchesSearch(DashSpecCompiledBookPage page)
    {
        if (string.IsNullOrWhiteSpace(_search))
        {
            return true;
        }

        var q = _search.Trim();
        return page.Title.Contains(q, StringComparison.OrdinalIgnoreCase) ||
               page.Markdown.Contains(q, StringComparison.OrdinalIgnoreCase) ||
               page.SubSections.Any(s => s.Title.Contains(q, StringComparison.OrdinalIgnoreCase) || s.Markdown.Contains(q, StringComparison.OrdinalIgnoreCase));
    }

    private static bool SymbolMatches(DashSpecSymbolDoc doc, string q) =>
        doc.Id.Contains(q, StringComparison.OrdinalIgnoreCase) ||
        doc.Signature.Contains(q, StringComparison.OrdinalIgnoreCase) ||
        doc.Markdown.Contains(q, StringComparison.OrdinalIgnoreCase) ||
        (FSharpOption<string>.get_IsSome(doc.Title) && doc.Title.Value.Contains(q, StringComparison.OrdinalIgnoreCase)) ||
        doc.Tags.Any(t => t.TagValue.Contains(q, StringComparison.OrdinalIgnoreCase)) ||
        doc.Children.Any(c => SymbolMatches(c, q));

    private static IReadOnlyList<string> SplitParagraphs(string markdown) =>
        markdown
            .Split(["\r\n\r\n", "\n\n"], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

    private static string? GetSymbolPrimaryBadge(DashSpecSymbolDoc unit) =>
        DashSpecDocGenerator.TryGetSymbolTag(unit, "locality")
        ?? DashSpecDocGenerator.TryGetSymbolTag(unit, "role")
        ?? DashSpecDocGenerator.TryGetSymbolTag(unit, "severity");

    private static string FormatNavGroupBadge(string categoryId, string categoryTitle) =>
        categoryId.ToLowerInvariant() switch
        {
            "declaration" => "Declaration",
            "consumer" => "Consumer",
            "root" => "Root",
            "database" => "Database (SQL)",
            "runtime" => "Runtime (In-Memory)",
            "error" => "Errors",
            "warning" => "Warnings",
            "info" => "Info",
            _ => categoryTitle.Length > 28 ? categoryId : categoryTitle,
        };

    private static string FormatMemberGroupTitle(string kind) =>
        kind.ToLowerInvariant() switch
        {
            "block" => "Grammar Blocks (<block> … end <block>)",
            "clause" => "Grammar Clauses & Statements",
            "type" => "Data Types (type)",
            "field" => "Fields",
            "port" => "Ports",
            "param" => "Parameters",
            "property" => "Properties",
            "source" => "Data Sources (source)",
            "transformer" => "Transformers (transformer)",
            "card" => "Report Cards (card)",
            "filter" => "Filters (filter)",
            "row" => "Registry Entries",
            _ => kind,
        };

    private IReadOnlyList<DashSpecSymbolDoc> FindReferencedSymbols(DashSpecSymbolDoc memberItem)
    {
        if (_book is null || memberItem.ReferencedSymbols.Length == 0)
        {
            return [];
        }

        var results = new List<DashSpecSymbolDoc>();
        foreach (var symRef in memberItem.ReferencedSymbols)
        {
            if (string.Equals(symRef, memberItem.Id, StringComparison.OrdinalIgnoreCase))
            {
                continue;
            }

            if (_book.GlobalSymbolIndex.TryGetValue(symRef, out var target) &&
                !string.Equals(target.Id, memberItem.Id, StringComparison.OrdinalIgnoreCase) &&
                target.Kind is "type" or "unit" or "module diagram" or "module presentation" or "module transform")
            {
                if (!results.Any(r => string.Equals(r.Id, target.Id, StringComparison.OrdinalIgnoreCase)))
                {
                    results.Add(target);
                }
            }
        }

        return results;
    }
}
