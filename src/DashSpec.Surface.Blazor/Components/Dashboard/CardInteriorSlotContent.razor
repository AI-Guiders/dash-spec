@namespace DashSpec.Surface.Blazor.Components.Dashboard
@using DashSpec.Execution.Runtime
@using DashSpec.Viz
@using DashSpec.Core.Interaction
@using DashSpec.Abstractions.Plugins
@using DashSpec.Composition.Plugins
@using DashSpec.Modeling.Core
@using DashSpec.Modeling.Parse.Layout
@using DashSpec.Surface.Blazor.Services.Presentation
@using DashSpec.Surface.Blazor.Services.Localization
@inject ILayoutSlotRendererRegistry SlotRegistry
@inject DashSpecContributorRegistry Contributors
@inject DashboardLocalizer Loc
@inject DashSpec.Viz.ICardChromeControlsOverride ChromeControls

@if (Owner is not null && !SlotRegistry.Supports(Slot.Scope, Slot.Node.Kind))
{
    <span class="layout-slot-unsupported muted">@Slot.Scope / @Slot.Node.Kind</span>
}
else if (Owner is not null)
{
    @if (Slot.Node.Kind == WiringNodeKind.Filter)
    {
        <div class="card-interior-filter-slot">
            @Owner.RenderLocalFilter(Slot.Node.Id, Owner.InteriorSlotStyle(Slot.Node.Id))
        </div>
    }
    else
    {
        @* Per-slot maximize is author intent (chrome slot_expand = on|off; default on):
           the hover button opens this slot alone in the card's fullscreen panel. *@
        <div class="card-slot-shell">
            @if (ShowSlotHeader)
            {
                <div class="card-slot-head">
                    @if (!string.IsNullOrWhiteSpace(SlotTitle))
                    {
                        <div class="card-slot-title">@SlotTitle</div>
                    }
                    <div class="card-slot-actions">
                        @if (DrillLoaded)
                        {
                            @* Drill UX (ADR-0107): the ✕ dismisses the loaded drill table — the
                               slot returns to its awaiting-click hint; without it a drill could
                               only be replaced by another click, never closed. *@
                            var stackClear = ChromeControls.ResolveButton();
                            if (stackClear is not null)
                            {
                                <DynamicComponent Type="stackClear"
                                                  Parameters="@(new Dictionary<string, object?>
                                                  {
                                                      ["Context"] = new StackButtonContext
                                                      {
                                                          Label = Loc.T("Close drill table"),
                                                          Disabled = false,
                                                          Clicked = EventCallback.Factory.Create(this, () => Owner.CloseCellDrillAsync()),
                                                          TestId = $"drill-clear-{Owner.Card.Id}",
                                                          Icon = CloseDrillIcon(),
                                                      },
                                                  })" />
                            }
                            else
                            {
                                <button type="button"
                                        class="secondary card-icon-btn slot-drill-clear-btn"
                                        title="@Loc.T("Close drill table")"
                                        aria-label="@(Loc.T("Close drill table") + ": " + Slot.Node.Id)"
                                        data-testid="drill-clear-@(Owner.Card.Id)"
                                        @onclick="() => Owner.CloseCellDrillAsync()"
                                        @onclick:stopPropagation="true">
                                    @CloseDrillIcon()
                                </button>
                            }
                        }
                        @if (CanExpandSlot)
                        {
                            var stackExpand = ChromeControls.ResolveButton();
                            if (stackExpand is not null)
                            {
                                <DynamicComponent Type="stackExpand"
                                                  Parameters="@(new Dictionary<string, object?>
                                                  {
                                                      ["Context"] = new StackButtonContext
                                                      {
                                                          Label = Loc.T("Expand diagram"),
                                                          Disabled = false,
                                                          Clicked = EventCallback.Factory.Create(this, () => Owner.OpenSlotFullscreen(Slot.Node.Id)),
                                                          Icon = ExpandSlotIcon(),
                                                      },
                                                  })" />
                            }
                            else
                            {
                                <button type="button"
                                        class="secondary card-icon-btn slot-maximize-btn"
                                        title="@Loc.T("Expand diagram")"
                                        aria-label="@(Loc.T("Expand diagram") + ": " + Slot.Node.Id)"
                                        @onclick="() => Owner.OpenSlotFullscreen(Slot.Node.Id)"
                                        @onclick:stopPropagation="true">
                                    <CardIcon Kind="CardIconKind.Expand" />
                                </button>
                            }
                        }
                    </div>
                </div>
            }
            else if (CanExpandSlot)
            {
                <div class="card-slot-floating-actions">
                    <button type="button"
                            class="secondary card-icon-btn slot-maximize-btn"
                            title="@Loc.T("Expand diagram")"
                            aria-label="@(Loc.T("Expand diagram") + ": " + Slot.Node.Id)"
                            @onclick="() => Owner.OpenSlotFullscreen(Slot.Node.Id)"
                            @onclick:stopPropagation="true">
                        <CardIcon Kind="CardIconKind.Expand" />
                    </button>
                </div>
            }
            @if (_diagramType is not null)
            {
                <div class="card-viz-stack">
                    <div data-testid="viz-@(Owner.Card.Id):@(Slot.Node.Id)" style="display:contents">
                        <DynamicComponent Type="_diagramType" Parameters="_diagramParameters" />
                    </div>
                    @Owner.RenderSlotLegend(SlotPayload)
                    @if (IsMatrixOrPrimarySlot)
                    {
                        @Owner.RenderSelectionDetail()
                    }
                </div>
            }
        </div>
    }
}

@code {
    [Parameter, EditorRequired] public Slot Slot { get; set; } = default!;
    [Parameter] public bool DetailView { get; set; }
    [CascadingParameter] public DashboardCardView? Owner { get; set; }

    private Type? _diagramType;
    private Dictionary<string, object?> _diagramParameters = new();

    private CardSlotRenderResult? SlotPayload =>
        Slot.Node.Kind == WiringNodeKind.Slot &&
        Owner?.Card.InteriorSlotRenders is not null &&
        Owner.Card.InteriorSlotRenders.TryGetValue(Slot.Node.Id, out var slot)
            ? slot
            : null;

    private bool HasSlotPayload => SlotPayload is not null;

    private bool IsMatrixOrPrimarySlot =>
        SlotPayload is { DataFamily: DiagramDataFamily.Matrix } ||
        (!HasSlotPayload && Owner?.Card.Matrix is not null);

    /// <summary>This slot shows a loaded cell-drill table (ADR-0107) — it gets the ✕.
    /// A table payload plus an active cell overlay on the card; awaiting-click and
    /// non-drill tables keep their hint/no chrome.</summary>
    private bool DrillLoaded =>
        Owner is not null
        && SlotPayload is { DataFamily: DiagramDataFamily.Table, Table: not null }
        && Owner.CellDrillActive
        && Owner.Card.InteriorSlotRenders is { Count: > 1 };

    private bool CanExpandSlot =>
        Owner is not null && Owner.Card.Chrome?.SlotExpand is not CardSlotExpand.Off;

    private string? SlotTitle =>
        SlotPayload is { AwaitingClick: false } slot && !string.IsNullOrWhiteSpace(slot.SlotTitle)
            ? slot.SlotTitle
            : null;

    private bool ShowSlotHeader =>
        !string.IsNullOrWhiteSpace(SlotTitle) || DrillLoaded;

    private RenderFragment CloseDrillIcon() => __builder =>
    {
        <svg class="card-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M18 6 6 18" />
            <path d="m6 6 12 12" />
        </svg>
    };

    private RenderFragment ExpandSlotIcon() => __builder =>
    {
        <CardIcon Kind="CardIconKind.Expand" />
    };

    protected override void OnParametersSet()
    {
        Contributors.PluginComponents.TryGetValue(DashSpecPluginComponents.CardDiagram, out _diagramType);

        if (Owner is null || _diagramType is null)
        {
            _diagramParameters = new Dictionary<string, object?>();
            return;
        }

        var slot = SlotPayload;
        _diagramParameters = new Dictionary<string, object?>
        {
            ["Request"] = new CardVizHostRequest
            {
                Card = Owner.Card,
                Slot = slot,
                DetailView = DetailView,
                MatrixMin = slot?.Matrix?.Min ?? Owner.Card.Matrix?.Min ?? 0,
                MatrixMax = slot?.Matrix?.Max ?? Owner.Card.Matrix?.Max ?? 0,
                OnHeatmapCellSelected = EventCallback.Factory.Create<HeatmapCellContext>(
                    this,
                    Owner.HandleHeatmapCellSelectedAsync),
                OnHeatmapCategoryItemSelected = EventCallback.Factory.Create<HeatmapCellContext>(
                    this,
                    Owner.HandleHeatmapCategoryItemSelectedAsync),
                OnCardAction = EventCallback.Factory.Create<CardActionRequest>(
                    this,
                    Owner.HandleCardActionAsync),
            },
        };
    }
}
