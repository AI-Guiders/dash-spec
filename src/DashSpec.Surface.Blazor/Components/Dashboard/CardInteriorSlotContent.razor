@namespace DashSpec.Surface.Blazor.Components.Dashboard
@using DashSpec.Execution.Runtime
@using DashSpec.Core.Interaction
@using DashSpec.Abstractions.Plugins
@using DashSpec.Viewer.Plugins
@using DashSpec.Surface.Blazor.Services.Presentation
@inject ILayoutSlotRendererRegistry SlotRegistry
@inject DashSpecContributorRegistry Contributors

@if (Owner is not null && !SlotRegistry.Supports(Slot.Scope, Slot.ContentKind))
{
    <span class="layout-slot-unsupported muted">@Slot.Scope / @Slot.ContentKind</span>
}
else if (Owner is not null)
{
    @if (Slot.ContentKind is LayoutSlotContentKind.Filter)
    {
        <div class="card-interior-filter-slot">
            @Owner.RenderLocalFilter(Slot.Token, Owner.InteriorSlotStyle(Slot.Token))
        </div>
    }
    else if (_diagramType is not null)
    {
        // Any diagram is one plugin component; it draws what it is given (the card, plus a slot payload when there is one).
        @if (Slot.ContentKind is LayoutSlotContentKind.PrimaryDiagram)
        {
            <div class="card-viz-stack">
                <DynamicComponent Type="_diagramType" Parameters="_diagramParameters" />
                @Owner.RenderSelectionDetail()
            </div>
        }
        else
        {
            <DynamicComponent Type="_diagramType" Parameters="_diagramParameters" />
        }
    }
}

@code {
    [Parameter, EditorRequired] public LayoutSlotDescriptor Slot { get; set; } = default!;
    [CascadingParameter] public DashboardCardView? Owner { get; set; }

    private Type? _diagramType;
    private Dictionary<string, object?> _diagramParameters = new();

    protected override void OnParametersSet()
    {
        Contributors.PluginComponents.TryGetValue(DashSpecPluginComponents.CardDiagram, out _diagramType);

        if (Owner is null || _diagramType is null)
        {
            _diagramParameters = new Dictionary<string, object?>();
            return;
        }

        var parameters = new Dictionary<string, object?>
        {
            ["Card"] = Owner.Card,
            ["MatrixMin"] = Owner.Card.Matrix?.Min ?? 0,
            ["MatrixMax"] = Owner.Card.Matrix?.Max ?? 0,
            ["OnHeatmapCellSelected"] = EventCallback.Factory.Create<HeatmapCellContext>(
                this,
                Owner.HandleHeatmapCellSelectedAsync),
        };

        if (Slot.ContentKind is LayoutSlotContentKind.SecondaryDiagram)
        {
            parameters["Slot"] = Owner.Card.InteriorSlotRenders![Slot.Token];
        }

        _diagramParameters = parameters;
    }
}
