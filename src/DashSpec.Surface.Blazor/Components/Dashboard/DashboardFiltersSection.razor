@namespace DashSpec.Surface.Blazor.Components.Dashboard
@using DashSpec.Core.Layout
@using DashSpec.Core.Model
@using DashSpec.Core.Runtime
@using DashSpec.Surface.Blazor.Commands
@using DashSpec.Surface.Blazor.Services.Presentation
@using DashSpec.Plugin.Filter.Builtins.Components.Shared
@using DashSpec.Presentation.Components

@if (ShowDashboardFilters)
{
<section class="@SectionClass"
         data-toolbar-layout="@(BarLayout ? "bar" : null)"
         data-toolbar-cells="@(ToolbarLabeledCells ? "labeled" : null)"
         aria-label="Фильтры дашборда">

    <PlacementSlotGrid CssClass="@GridClass"
                       Scope="LayoutSlotScope.HostPageToolbar"
                       HostLayout="Layout"
                       GridStyle="@(string.IsNullOrWhiteSpace(GridStyle) ? null : GridStyle)">
        @{
            var lastPlacementRow = 0;
        }
        @foreach (var slot in ToolbarSlots)
        {
            if (BarLayout &&
                lastPlacementRow > 0 &&
                slot.Placement.Row > lastPlacementRow)
            {
                <div class="toolbar-filter-row-break" aria-hidden="true"></div>
            }

            if (BarLayout)
            {
                lastPlacementRow = slot.Placement.Row;
            }

            var filter = FilterIndex[slot.Token];
            <PlacementSlot Placement="slot.Placement" GridColumns="Layout.Columns">
                <CommandTargetShell TargetId="@slot.Token"
                                    Kind="CommandTargetKind.Filter"
                                    CssClass="@FilterCellClass(filter)">
                    <FilterWidgetHost @key="@($"{filter.Name}:{FieldOptionsRevision}:{GetFieldOptions(filter.Name).Count}")"
                                      Filter="filter"
                                      Label="@FilterUiHelpers.DisplayLabel(filter, FilterIndex, SelectedFields)"
                                      Hint="@ScopeHintFor(filter)"
                                      HintAriaLabel="@ScopeHintAriaFor(filter)"
                                      ToolbarLabeledCells="@ToolbarLabeledCells"
                                      Disabled="@Busy"
                                      Options="GetFieldOptions(filter.Name)"
                                      Selected="@FilterUiHelpers.SelectedFieldValues(filter, SelectedFields)"
                                      SelectedChanged="values => OnFieldChanged.InvokeAsync((filter.Name, values))"
                                      DateFrom="DateFrom"
                                      DateTo="DateTo"
                                      FilterIndex="FilterIndex"
                                      SelectedFields="SelectedFields"
                                      OnDayChanged="OnDayChanged"
                                      OnRangeChanged="OnScheduleApply"
                                      TopValue="@FilterUiHelpers.ResolveTopValue(filter, TopLimits)"
                                      TopValueChanged="value => OnTopChangedForFilter(filter, value)" />
                </CommandTargetShell>
            </PlacementSlot>
        }

        @if (BarLayout)
        {
            @RenderToolbarActions
        }
    </PlacementSlotGrid>

    @if (!BarLayout)
    {
        @RenderToolbarActions
    }

</section>
}

@code {
    private bool ShowDashboardFilters =>
        FilterNames.Count > 0 || (AutoApply && Busy);

    private IReadOnlyList<LayoutSlotDescriptor> ToolbarSlots =>
        LayoutSlotEngine.PlanHostPageToolbar(FilterNames, FilterPlacements);

    [Parameter] public IReadOnlyList<string> FilterNames { get; set; } = [];
    [Parameter] public IReadOnlyDictionary<string, FilterDefinition> FilterIndex { get; set; } =
        new Dictionary<string, FilterDefinition>();
    [Parameter] public IReadOnlyDictionary<string, IReadOnlyList<string>> FiltersToCards { get; set; } =
        new Dictionary<string, IReadOnlyList<string>>();
    [Parameter] public Dictionary<string, DateOnly> DateFrom { get; set; } = new(StringComparer.OrdinalIgnoreCase);
    [Parameter] public Dictionary<string, DateOnly> DateTo { get; set; } = new(StringComparer.OrdinalIgnoreCase);
    [Parameter] public Dictionary<string, HashSet<string>> SelectedFields { get; set; } = new(StringComparer.OrdinalIgnoreCase);
    [Parameter] public Dictionary<string, int> TopLimits { get; set; } = new(StringComparer.OrdinalIgnoreCase);
    [Parameter] public Func<string, IReadOnlyList<string>> GetFieldOptions { get; set; } = _ => [];
    [Parameter] public int FieldOptionsRevision { get; set; }
    [Parameter] public LayoutDefinition Layout { get; set; } = LayoutDefinition.Default;
    [Parameter] public IReadOnlyDictionary<string, PlacementDefinition> FilterPlacements { get; set; } =
        new Dictionary<string, PlacementDefinition>();
    [Parameter] public bool BarLayout { get; set; }
    [Parameter] public bool ToolbarLabeledCells { get; set; }
    [Parameter] public bool AutoApply { get; set; }
    [Parameter] public bool ApplyIconControl { get; set; } = true;
    [Parameter] public bool Busy { get; set; }
    [Parameter] public string SectionClass { get; set; } = "filters filters-card";
    [Parameter] public string GridClass { get; set; } = "filters-grid";
    [Parameter] public string GridStyle { get; set; } = string.Empty;
    [Parameter] public EventCallback OnApply { get; set; }
    [Parameter] public EventCallback OnScheduleApply { get; set; }
    [Parameter] public EventCallback<string> OnDayChanged { get; set; }
    [Parameter] public EventCallback<(string Name, HashSet<string> Values)> OnFieldChanged { get; set; }
    [Parameter] public EventCallback<(string Name, int Value)> OnTopChanged { get; set; }

    private string FilterCellClass(FilterDefinition filter) =>
        BarLayout
            ? filter.Kind is FilterKind.Date && !filter.IsDayWidget
                ? "toolbar-filter-cell toolbar-filter-date"
                : "toolbar-filter-cell"
            : filter.Kind is FilterKind.Field ? "filter-field-cell" : string.Empty;

    private Task OnTopChangedForFilter(FilterDefinition filter, int value) =>
        filter.Kind is FilterKind.Top
            ? OnTopChanged.InvokeAsync((filter.Name, value))
            : Task.CompletedTask;

    private string? ScopeHintFor(FilterDefinition filter)
    {
        if (filter.IsBindScopeHidden)
        {
            return null;
        }

        if (filter.Kind is FilterKind.Top || !BarLayout)
        {
            return FilterUiHelpers.ScopeHint(filter.Name, FiltersToCards);
        }

        return null;
    }

    private string? ScopeHintAriaFor(FilterDefinition filter) =>
        string.IsNullOrWhiteSpace(ScopeHintFor(filter))
            ? null
            : FilterUiHelpers.ScopeHintAriaLabel(filter.Name, FiltersToCards);

    private RenderFragment RenderApplyButton => __builder =>
    {
        if (ApplyIconControl)
        {
            <FilterApplyIconButton AriaLabel="Применить"
                                   CssClass="secondary card-icon-btn filter-apply-icon"
                                   Busy="@Busy"
                                   Disabled="@Busy"
                                   OnClick="OnApply" />
        }
        else
        {
            <button class="primary"
                    disabled="@Busy"
                    @onclick="OnApply">
                @if (Busy)
                {
                    <span class="spinner spinner-inline" aria-hidden="true"></span>
                    <span>Загрузка…</span>
                }
                else
                {
                    <span>Применить</span>
                }
            </button>
        }
    };

    private RenderFragment RenderToolbarActions => __builder =>
    {
        if (AutoApply)
        {
            if (!Busy)
            {
                return;
            }

            if (BarLayout)
            {
                <div class="toolbar-filter-cell toolbar-filter-apply">
                    <span class="muted filters-busy"><span class="spinner spinner-inline" aria-hidden="true"></span> обновление…</span>
                </div>
            }
            else
            {
                <div class="filters-actions">
                    <span class="muted filters-busy"><span class="spinner spinner-inline" aria-hidden="true"></span> обновление…</span>
                </div>
            }

            return;
        }

        if (BarLayout)
        {
            <div class="toolbar-filter-cell toolbar-filter-apply">
                @RenderApplyButton
            </div>
        }
        else
        {
            <div class="filters-actions">
                @RenderApplyButton
            </div>
        }
    };
}
