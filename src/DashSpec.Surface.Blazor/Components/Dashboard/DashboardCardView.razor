@namespace DashSpec.Surface.Blazor.Components.Dashboard
@using DashSpec.Execution.Runtime
@using DashSpec.Abstractions.Plugins
@using DashSpec.Core.Interaction
@using DashSpec.Filters
@using DashSpec.Viz
@using DashSpec.Composition.Plugins
@using DashSpec.Surface.Blazor.Composition
@using DashSpec.Surface.Blazor.Services.Presentation
@using DashSpec.Surface.Blazor.Services.Localization
@using DashSpec.Plugin.Filter.Builtins.Components
@using DashSpec.Presentation.Components
@using Radzen
@using Radzen.Blazor
@inject DashboardLocalizer Loc
@inject DashSpec.Viz.ICardChromeControlsOverride ChromeControls
@inject ICardCellDrillState CellDrill
@implements IDisposable

<RadzenCard Variant="Variant.Filled" Class="@CardCssClass" Style="@PlacementStyle" data-testid="@(($"card-{Card.Id}"))">
    <div class="card-head">
        @if (Card.ShowChromeTitle || !string.IsNullOrWhiteSpace(Card.FilterLinkHint))
        {
            <div class="card-head-title">
                @if (CanFoldBody)
                {
                    // ADR-0112: the fold chevron is a chrome role — the stack paints the
                    // button, the surface owns the fold state and the glyph.
                    var stackFold = ChromeControls.ResolveButton();
                    var foldLabel = BodyFolded ? Loc.T("Expand") : Loc.T("Collapse");
                    if (stackFold is not null)
                    {
                        <DynamicComponent Type="stackFold"
                                          Parameters="@(new Dictionary<string, object?>
                                          {
                                              ["Label"] = foldLabel,
                                              ["Disabled"] = false,
                                              ["Clicked"] = EventCallback.Factory.Create(this, ToggleBodyFoldAsync),
                                              ["Icon"] = (RenderFragment)(builder =>
                                              {
                                                  builder.OpenComponent<CardIcon>(0);
                                                  builder.AddAttribute(1, nameof(CardIcon.Kind), CardIconKind.ChevronDown);
                                                  builder.AddAttribute(2, nameof(CardIcon.Collapsed), BodyFolded);
                                                  builder.CloseComponent();
                                              }),
                                          })" />
                    }
                    else
                    {
                        <button type="button"
                                class="secondary card-icon-btn card-fold-btn"
                                title="@foldLabel"
                                aria-expanded="@(!BodyFolded)"
                                aria-label="@foldLabel"
                                @onclick="ToggleBodyFoldAsync"
                                @onclick:stopPropagation="true">
                            <svg class="card-icon card-fold-icon @(BodyFolded ? "card-fold-icon--collapsed" : null)" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <polyline points="6 9 12 15 18 9" />
                            </svg>
                        </button>
                    }
                }
                @if (Card.ShowChromeTitle)
                {
                    <h2 class="card-title"><RichTextView Text="@Card.Title" /></h2>
                }
                @if (!string.IsNullOrWhiteSpace(Card.FilterLinkHint))
                {
                    <p class="card-link-hint muted">@Card.FilterLinkHint</p>
                }
            </div>
        }
        @if (HasHeadToolbar && !BodyFolded)
        {
            @CardToolbarChrome(showFullscreenToggle: true)
        }
        @if (HasHeadMeta && !BodyFolded)
        {
            <div class="card-head-meta">
                @if (!UsesInteriorLayout && Card.LocalFilters is { Count: > 0 })
                {
                    <CardLocalFilterChrome Card="Card"
                                           GridColumns="GridColumns"
                                           FieldOptionsRevision="FieldOptionsRevision"
                                           HeadMetaLayout="true"
                                           ApplyLabel="@Loc.T("Apply")"
                                           FilterIndex="FilterIndex"
                                           DateFrom="CardLocalDateFrom"
                                           DateTo="CardLocalDateTo"
                                           SelectedFields="CardLocalSelectedFields"
                                           TopLimits="CardLocalTopLimits"
                                           GetFieldOptions="GetFieldOptions"
                                           AutoApply="AutoApply"
                                           OnApplyCard="OnApplyCard"
                                           OnScheduleCardApply="OnScheduleCardApply"
                                           OnCardDayChanged="OnCardDayChanged"
                                           OnCardFieldChanged="OnCardFieldChanged" />
                }
                @if (DashboardBoundFilters.Count > 0)
                {
                    <div class="card-filters">
                        @foreach (var filterName in DashboardBoundFilters)
                        {
                            <span class="scope-chip">@FilterUiHelpers.FormatActiveChip(filterName, FilterIndex, DateFrom, DateTo, SelectedFields)</span>
                        }
                    </div>
                }
            </div>
        }
    </div>

    @if (Card.IsVisibilityPlaceholder)
    {
        <div class="card-placeholder muted">
            <p>@Card.VisibilityMessage</p>
        </div>
    }
    else if (!BodyFolded)
    {
        @InteriorPlan()
    }
</RadzenCard>

@if (_fullscreen && CanFullscreen)
{
    <div class="card-fullscreen-backdrop" @onclick="CloseFullscreen">
        <div class="card-fullscreen-panel"
             role="dialog"
             aria-modal="true"
             aria-label="@Card.Title"
             tabindex="-1"
             @ref="_fullscreenPanel"
             @onclick:stopPropagation="true"
             @onkeydown="OnFullscreenKeyDown">
            <header class="card-fullscreen-head">
                <h2><RichTextView Text="@Card.Title" /></h2>
                @if (_fullscreenSlotId is not null)
                {
                    <span class="muted card-fullscreen-slot-hint">@_fullscreenSlotId</span>
                }
                <button type="button"
                        class="secondary card-icon-btn card-fullscreen-close"
                        title="@Loc.T("Collapse")"
                        aria-label="@Loc.T("Collapse")"
                        @onclick="CloseFullscreen">
                    <CardIcon Kind="CardIconKind.Collapse" />
                </button>
            </header>
            @* The maximized card IS the card (ADR-0111 P1): toolbar and interior plan
               ride along — the same fragments the inline card renders, only the frame
               grows. Slot-maximize (the hover button) still shows that slot alone. *@
            <CascadingValue Value="this" IsFixed="true">
                @if (_fullscreenSlotId is null)
                {
                    @CardToolbarChrome(showFullscreenToggle: false)
                }
                <div class="card-fullscreen-body">
                    @if (_fullscreenSlotId is { } slotId &&
                        InteriorSlots.FirstOrDefault(slot => slot.Node.Id == slotId) is { } fsSlot)
                    {
                        <CardInteriorSlotContent Slot="fsSlot" DetailView="true" />
                    }
                    else
                    {
                        @InteriorPlan(detailView: true)
                    }
                </div>
            </CascadingValue>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public CardRenderResult Card { get; set; } = default!;
    [Parameter] public string PlacementStyle { get; set; } = string.Empty;
    [Parameter] public int GridColumns { get; set; } = 12;
    [Parameter] public IReadOnlyList<string> DashboardBoundFilters { get; set; } = [];
    [Parameter] public IReadOnlyDictionary<string, FilterDefinition> FilterIndex { get; set; } =
        new Dictionary<string, FilterDefinition>();
    [Parameter] public Dictionary<string, DateOnly> DateFrom { get; set; } = new(StringComparer.OrdinalIgnoreCase);
    [Parameter] public Dictionary<string, DateOnly> DateTo { get; set; } = new(StringComparer.OrdinalIgnoreCase);
    [Parameter] public Dictionary<string, HashSet<string>> SelectedFields { get; set; } = new(StringComparer.OrdinalIgnoreCase);
    [Parameter] public Dictionary<string, int> TopLimits { get; set; } = new(StringComparer.OrdinalIgnoreCase);
    [Parameter, EditorRequired] public Dictionary<string, DateOnly> CardLocalDateFrom { get; set; } = default!;
    [Parameter, EditorRequired] public Dictionary<string, DateOnly> CardLocalDateTo { get; set; } = default!;
    [Parameter, EditorRequired] public Dictionary<string, HashSet<string>> CardLocalSelectedFields { get; set; } = default!;
    [Parameter, EditorRequired] public Dictionary<string, int> CardLocalTopLimits { get; set; } = default!;
    [Parameter] public Func<string, IReadOnlyList<string>> GetFieldOptions { get; set; } = _ => [];
    [Parameter] public int FieldOptionsRevision { get; set; }
    [Parameter] public bool AutoApply { get; set; }
    [Parameter] public string? ActiveViewId { get; set; }
    /// <summary>[ADR-0111] P1: the assembled interior slice from the plane's CardInteriors.</summary>
    [Parameter] public IReadOnlyList<DashSpec.Modeling.Parse.Layout.Slot>? InteriorSlotPlan { get; set; }
    [Parameter] public EventCallback<string> OnApplyCard { get; set; }
    [Parameter] public EventCallback<string> OnScheduleCardApply { get; set; }
    [Parameter] public EventCallback<(string CardId, string FilterName)> OnCardDayChanged { get; set; }
    [Parameter] public EventCallback<(string CardId, string FilterName, HashSet<string> Values)> OnCardFieldChanged { get; set; }
    [Parameter] public EventCallback<(CardRenderResult Card, HeatmapCellContext Context)> OnCellClickNavigate { get; set; }
    /// <summary>Drill UX (ADR-0107): the drill slot's ✕ — the page drops the cell overlay
    /// and refreshes the interior slots.</summary>
    [Parameter] public EventCallback<CardRenderResult> OnDrillClear { get; set; }
    [Parameter] public EventCallback<CardActionRequest> OnCardAction { get; set; }
    [Parameter] public bool BodyFolded { get; set; }
    [Parameter] public EventCallback OnToggleBodyFold { get; set; }

    private bool CanFoldBody =>
        Card.Chrome is { Fold: not CardFoldMode.None } && !Card.IsVisibilityPlaceholder;

    private Task ToggleBodyFoldAsync() =>
        OnToggleBodyFold.HasDelegate ? OnToggleBodyFold.InvokeAsync() : Task.CompletedTask;

    private HeatmapCellContext? _selection;
    private RenderSnapshot _renderSnapshot;
    private bool _fullscreen;
    private string? _fullscreenSlotId;
    private ElementReference _fullscreenPanel;

    /// <summary>The card's action row — local filters, viz toolbar (view switch),
    /// chrome, fullscreen toggle, extension blocks. One fragment, two frames: the
    /// inline card and the fullscreen panel render the same row.</summary>
    private RenderFragment CardToolbarChrome(bool showFullscreenToggle) => __builder =>
    {
        @* Chrome is the stack's (ADR-0112): the action row is a Radzen stack —
           layout and rhythm from the theme, content stays ours. *@
        <RadzenStack Orientation="Orientation.Horizontal"
                     AlignItems="AlignItems.Center"
                     Wrap="FlexWrap.Wrap"
                     Gap="0.4rem"
                     class="card-head-toolbar"
                     role="toolbar"
                     aria-label="@Loc.T("Card actions")">
            @if (UsesInteriorLayout && Card.LocalFilters is { Count: > 0 })
            {
                <CardLocalFilterChrome Card="Card"
                                       GridColumns="GridColumns"
                                       FieldOptionsRevision="FieldOptionsRevision"
                                       ApplyLabel="@Loc.T("Apply")"
                                       FilterIndex="FilterIndex"
                                       DateFrom="CardLocalDateFrom"
                                       DateTo="CardLocalDateTo"
                                       SelectedFields="CardLocalSelectedFields"
                                       TopLimits="CardLocalTopLimits"
                                       GetFieldOptions="GetFieldOptions"
                                       AutoApply="AutoApply"
                                       OnApplyCard="OnApplyCard"
                                       OnScheduleCardApply="OnScheduleCardApply"
                                       OnCardDayChanged="OnCardDayChanged"
                                       OnCardFieldChanged="OnCardFieldChanged" />
            }
            @if (_vizToolbarType is not null)
            {
                <DynamicComponent Type="_vizToolbarType" Parameters="_vizToolbarParameters" />
            }
            @foreach (var chromeType in _cardChromeTypes)
            {
                <DynamicComponent Type="chromeType" Parameters="_cardChromeParameters" />
            }
            @if (showFullscreenToggle && CanFullscreen)
            {
                var stackFullscreen = ChromeControls.ResolveButton();
                if (stackFullscreen is not null)
                {
                    @* ADR-0112: the stack paints the button; the role (expand) and the
                       action stay surface-owned. *@
                    <DynamicComponent Type="stackFullscreen"
                                      Parameters="@(new Dictionary<string, object?>
                                      {
                                          ["Label"] = Loc.T("Expand diagram"),
                                          ["Disabled"] = Card.Loading,
                                          ["Pressed"] = _fullscreen,
                                          ["Clicked"] = EventCallback.Factory.Create(this, ToggleFullscreen),
                                          ["Icon"] = (RenderFragment)(builder =>
                                          {
                                              builder.OpenComponent<CardIcon>(0);
                                              builder.AddAttribute(1, nameof(CardIcon.Kind), CardIconKind.Expand);
                                              builder.CloseComponent();
                                          }),
                                      })" />
                }
                else
                {
                    <button type="button"
                            class="secondary card-icon-btn card-fullscreen-btn"
                            title="@Loc.T("Expand diagram")"
                            disabled="@Card.Loading"
                            aria-pressed="@_fullscreen"
                            aria-label="@Loc.T("Expand diagram")"
                            @onclick="ToggleFullscreen">
                        <CardIcon Kind="CardIconKind.Expand" />
                    </button>
                }
            }
            <CardExtensionChrome Blocks="Card.ExtensionBlocks"
                                   Card="Card"
                                   ActiveViewId="@ActiveViewId"
                                   OnAction="OnCardAction" />
            @if (Card.Loading)
            {
                <span class="card-status muted">@Loc.T("Loading…")</span>
            }
            else if (!string.IsNullOrEmpty(Card.Error))
            {
                <span class="card-status card-status-error">@Loc.T("Error")</span>
            }
        </RadzenStack>
    };

    /// <summary>The interior slot plan — the SSOT render (ADR-0111 P1). The inline
    /// card and the fullscreen panel render the same grid; only the frame differs.</summary>
    private RenderFragment InteriorPlan(bool detailView = false) => __builder =>
    {
        <CascadingValue Value="this" IsFixed="true">
            <CardInteriorGrid GridColumns="GridColumns" ExtraStyle="@InteriorGridFillStyle()">
                @foreach (var slot in InteriorSlots)
                {
                    <PlacementSlot Placement="slot.Placement"
                                   CssClass="@InteriorSlotCssClass(slot)"
                                   ExtraStyle="@InteriorSlotExtraStyle(slot)">
                        <CardInteriorSlotContent Slot="slot" DetailView="detailView" />
                    </PlacementSlot>
                }
            </CardInteriorGrid>
            @if (CardLegendVisible)
            {
                @* The card's own legend slot (ADR-0073 chrome): the diagram pane never
                   shares space with the legend — the legend lives below the interior,
                   at the card level, and keeps that place whether the matrix scrolls,
                   folds or fills. *@
                <div class="card-legend-slot" data-testid="legend-@Card.Id"
                     data-color-scale="@HeatmapColorScale.Normalize(Card.MatrixPresentation?.ColorScale)">
                    @if (!string.IsNullOrWhiteSpace(CardLegendMinText))
                    {
                        <span><RichTextView Text="@CardLegendMinText" /></span>
                    }
                    <span class="card-legend-bar" aria-hidden="true"></span>
                    @if (!string.IsNullOrWhiteSpace(CardLegendMaxText))
                    {
                        <span><RichTextView Text="@CardLegendMaxText" /></span>
                    }
                </div>
            }
        </CascadingValue>
    };

    /// <summary>The card's own legend slot: visible when the matrix declares a
    /// gradient legend and the viewer has not toggled it off (ADR-0062 state).
    /// Lives at the card level — the viz component no longer owns legend space.</summary>
    private MatrixPresentation? LegendPresentation =>
        Card.Matrix is not null ? Card.MatrixPresentation : null;

    private bool CardLegendVisible =>
        LegendPresentation is not null &&
        VizLabelDisplayResolver.EffectiveLegendVisible(
            LegendPresentation.ShowsGradientLegend,
            VizDisplayState.GetLegendOverride(Card.Id));

    private string? CardLegendMinText =>
        LegendPresentation is not null
            ? LegendPresentation.FormatLegendMin(Card.Matrix!.Min, Card.Matrix!.Max)
            : null;

    private string? CardLegendMaxText =>
        LegendPresentation is not null
            ? LegendPresentation.FormatLegendMax(Card.Matrix!.Min, Card.Matrix!.Max)
            : null;

    private bool HasHeadToolbar =>
        _vizToolbarType is not null ||
        CanFullscreen ||
        Card.ExtensionBlocks is { Count: > 0 } ||
        (UsesInteriorLayout && Card.LocalFilters is { Count: > 0 }) ||
        Card.Loading ||
        !string.IsNullOrEmpty(Card.Error);

    private bool HasHeadMeta =>
        (!UsesInteriorLayout && Card.LocalFilters is { Count: > 0 }) ||
        DashboardBoundFilters.Count > 0;


    private bool CanFullscreen =>
        !Card.IsVisibilityPlaceholder &&
        InteriorSlots.Count > 0 &&
        Card.DataFamily is DiagramDataFamily.Chart or DiagramDataFamily.Matrix or DiagramDataFamily.Table or DiagramDataFamily.Gantt;

    [Inject] private VizCardToolbarRegistry VizToolbars { get; set; } = default!;

    [Inject] private ICardVizDisplayState VizDisplayState { get; set; } = default!;

    [Inject] private DashSpecContributorRegistry Contributors { get; set; } = default!;

    private Type? _vizToolbarType;
    private Dictionary<string, object?> _vizToolbarParameters = new();
    private IReadOnlyList<Type> _cardChromeTypes = [];
    private Dictionary<string, object?> _cardChromeParameters = new();
    private Type? _filterWidgetType;

    private void ToggleFullscreen()
    {
        _fullscreen = !_fullscreen;
        _fullscreenSlotId = null;
        if (_fullscreen)
        {
            _ = FocusFullscreenAsync();
        }
    }

    /// <summary>Per-slot maximize (hover button on a slot): the panel shows only this slot.</summary>
    internal void OpenSlotFullscreen(string slotId)
    {
        _fullscreenSlotId = slotId;
        _fullscreen = true;
        _ = FocusFullscreenAsync();
    }

    private void CloseFullscreen()
    {
        _fullscreen = false;
        _fullscreenSlotId = null;
    }

    private async Task FocusFullscreenAsync()
    {
        await InvokeAsync(StateHasChanged);
        try
        {
            await _fullscreenPanel.FocusAsync();
        }
        catch
        {
            // Focus is best-effort for keyboard dismiss.
        }
    }

    private void OnFullscreenKeyDown(KeyboardEventArgs args)
    {
        if (string.Equals(args.Key, "Escape", StringComparison.OrdinalIgnoreCase))
        {
            CloseFullscreen();
        }
    }

    private int LocalFieldOptionsToken()
    {
        if (Card.LocalFilters is not { Count: > 0 })
        {
            return 0;
        }

        var token = 0;
        foreach (var name in Card.LocalFilters)
        {
            token = HashCode.Combine(token, GetFieldOptions(name).Count);
        }

        return token;
    }

    protected override bool ShouldRender()
    {
        var snapshot = new RenderSnapshot(
            Card,
            ActiveViewId,
            Card.Loading,
            Card.DataFamily,
            Card.Matrix is not null,
            Card.Title,
            Card.FilterLinkCssClass,
            _selection?.Xi,
            _selection?.Yi,
            _fullscreen,
            _fullscreenSlotId,
            BodyFolded,
            LocalFieldOptionsToken(),
            FieldOptionsRevision,
            VizDisplayState.GetValueLabelsOverride(Card.Id),
            VizDisplayState.GetAxisLabelsXOverride(Card.Id),
            VizDisplayState.GetAxisLabelsYOverride(Card.Id),
            VizDisplayState.GetLegendOverride(Card.Id));
        if (_renderSnapshot.Equals(snapshot))
        {
            return false;
        }

        _renderSnapshot = snapshot;
        return true;
    }

    readonly record struct RenderSnapshot(
        CardRenderResult Card,
        string? ActiveViewId,
        bool Loading,
        DiagramDataFamily DataFamily,
        bool HasMatrix,
        string Title,
        string? FilterLinkCssClass,
        int? SelectionXi,
        int? SelectionYi,
        bool Fullscreen,
        string? FullscreenSlotId,
        bool BodyFolded,
        int LocalFieldOptionsToken,
        int FieldOptionsRevision,
        bool? MatrixValueLabelsOverride,
        bool? MatrixAxisLabelsXOverride,
        bool? MatrixAxisLabelsYOverride,
        bool? MatrixLegendOverride);

    protected override void OnInitialized()
    {
        VizDisplayState.Changed += OnVizDisplayStateChanged;
    }

    public void Dispose()
    {
        VizDisplayState.Changed -= OnVizDisplayStateChanged;
    }

    private void OnVizDisplayStateChanged(string cardId)
    {
        if (!string.Equals(cardId, Card.Id, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        _ = InvokeAsync(StateHasChanged);
    }

    protected override void OnParametersSet()
    {
        if (Card.Loading)
        {
            _selection = null;
        }

        _vizToolbarType = Card.IsVisibilityPlaceholder ||
                          Card.Loading ||
                          !string.IsNullOrEmpty(Card.Error)
            ? null
            : VizToolbars.TryGet(Card.RenderPluginId);
        _vizToolbarParameters = _vizToolbarType is null
            ? new Dictionary<string, object?>()
            : new Dictionary<string, object?>
            {
                ["Context"] = new VizCardToolbarContext
                {
                    Card = Card,
                    OnCardAction = OnCardAction,
                },
            };

        Contributors.PluginComponents.TryGetValue(DashSpecPluginComponents.FilterWidget, out _filterWidgetType);

        _cardChromeTypes = Card.IsVisibilityPlaceholder ||
                           Card.Loading ||
                           !string.IsNullOrEmpty(Card.Error)
            ? []
            : Contributors.CardChromeComponents.Values.ToList();
        _cardChromeParameters = _cardChromeTypes.Count == 0
            ? new Dictionary<string, object?>()
            : new Dictionary<string, object?>
            {
                ["Context"] = new CardChromeContext
                {
                    Card = Card,
                    OnCardAction = OnCardAction,
                },
            };
    }

    private bool UsesInteriorLayout => Card.InteriorPlacements is { Count: > 0 };

    private string CardCssClass
    {
        get
        {
            var parts = new List<string> { "card" };
            if (Card.DataFamily is DiagramDataFamily.Scalar)
            {
                parts.Add("card-kpi");
            }

            if (!string.IsNullOrWhiteSpace(Card.FilterLinkCssClass))
            {
                parts.Add(Card.FilterLinkCssClass);
            }

            if (BodyFolded)
            {
                parts.Add("card--folded");
            }

            return string.Join(' ', parts);
        }
    }

    [Inject] private IOnClickInteractionService Interactions { get; set; } = default!;

    private ShowSelectionEffect? ShowSelection =>
        Interactions.ResolveShowEffect(Card.ClickBehaviour);

    private ShowSelectionEffect? EffectiveShowSelection =>
        ShowSelection ?? (Card.Matrix is not null && !HasInlineDrillTableSlot()
            ? MatrixDefaultShowSelection
            : null);

    private bool HasInlineDrillTableSlot() =>
        Card.InteriorSlotRenders?.Values.Any(static slot => slot.DataFamily is DiagramDataFamily.Table) == true;

    private static readonly ShowSelectionEffect MatrixDefaultShowSelection =
        CardClickEffect.NewShowSelection(
            ShowPlacement.Below,
            ShowFormat.Kv,
            ShowSource.Cell,
            true,
            Microsoft.FSharp.Core.FSharpOption<string>.None);

    /// <summary>A cell-drill overlay is active on this card — its drill slot shows the ✕.</summary>
    internal bool CellDrillActive => CellDrill.Get(Card.Id) is not null;

    /// <summary>The drill slot's ✕ — the page clears the overlay and refreshes interiors.</summary>
    internal Task CloseCellDrillAsync() => OnDrillClear.InvokeAsync(Card);

    /// <summary>Viz-originated card actions (ADR-0062): the slot's table grouping button and
    /// other in-viz requests ride the page action pipeline.</summary>
    internal Task HandleCardActionAsync(CardActionRequest request) => OnCardAction.InvokeAsync(request);

    internal async Task HandleHeatmapCellSelectedAsync(HeatmapCellContext context)
    {
        if (EffectiveShowSelection is not null)
        {
            _selection = context;
        }

        // ADR-0107: legacy generic behaviour, or the sourced handler for this click's source
        // (an `on click` table card keeps its cell effects in the "cell"-sourced handler).
        if (OnCellClickNavigate.HasDelegate &&
            ((Card.ClickBehaviour is not null && Interactions.HasNavigationEffects(Card.ClickBehaviour)) ||
             (Card.ClickHandlers is { Count: > 0 } handlers &&
              handlers.Any(h => string.Equals(h.Source, context.ClickSource, StringComparison.OrdinalIgnoreCase)))))
        {
            await OnCellClickNavigate.InvokeAsync((Card, context));
        }

        if (EffectiveShowSelection is not null)
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>Category-item (axis label) click — ADR-0107: the sourced handler must exist.</summary>
    internal async Task HandleHeatmapCategoryItemSelectedAsync(HeatmapCellContext context)
    {
        if (OnCellClickNavigate.HasDelegate &&
            Card.ClickHandlers is { Count: > 0 } handlers &&
            handlers.Any(h => string.Equals(h.Source, context.ClickSource, StringComparison.OrdinalIgnoreCase)))
        {
            await OnCellClickNavigate.InvokeAsync((Card, context));
            await InvokeAsync(StateHasChanged);
        }
    }

    internal RenderFragment RenderSelectionDetail() => __builder =>
    {
        if (EffectiveShowSelection is null || _selection is null)
        {
            return;
        }

        <CardSelectionDetail Effect="EffectiveShowSelection"
                             Context="_selection"
                             Presentation="Card.MatrixPresentation" />;
    };

    /// <summary>
    /// [ADR-0111] P1: the interior slice comes from the assembled plane — passed down
    /// as a parameter; no per-render planning.
    /// </summary>
    private IReadOnlyList<DashSpec.Modeling.Parse.Layout.Slot> InteriorSlots =>
        InteriorSlotPlan ?? [];

    private static string InteriorSlotClass(DashSpec.Modeling.Core.WiringNodeKind kind) =>
        kind == DashSpec.Modeling.Core.WiringNodeKind.Filter
            ? "card-interior-slot card-filter-slot"
            : "card-interior-slot card-diagram-slot";

    /// <summary>stretch_mode = fill diagram slot: the card is the frame — the authored px
    /// height fixes the slot, the content fills it and scrolls inside; siblings stretch
    /// to the same frame instead of dictating heights to each other (ADR-0116 flex row).</summary>
    private bool IsFillDiagramSlot(DashSpec.Modeling.Parse.Layout.Slot slot)
    {
        if (slot.Node.Kind == DashSpec.Modeling.Core.WiringNodeKind.Filter ||
            Card.InteriorSlotRenders?.ContainsKey(slot.Node.Id) == true)
        {
            return false;
        }

        return Card.ChartPresentation is { StretchMode: VizStretchMode.Fill } ||
               Card.MatrixPresentation is { StretchMode: VizStretchMode.Fill };
    }

    private string InteriorSlotExtraStyle(DashSpec.Modeling.Parse.Layout.Slot slot) =>
        IsFillDiagramSlot(slot)
            ? $"--fill-h:{EffectiveFillFloorPx}px;"
            : string.Empty;

    /// <summary>The fill height rides the grid container too: sibling slots cap to it
    /// (ADR-0073 — the card is the frame; a drill table paginates/scrolls inside its
    /// slot instead of growing the card).</summary>
    private string InteriorGridFillStyle() =>
        InteriorSlots.Any(IsFillDiagramSlot)
            ? $"--fill-h:{EffectiveFillFloorPx}px;"
            : string.Empty;

    private int EffectiveFillFloorPx =>
        Card.ChartPresentation is { StretchMode: VizStretchMode.Fill } chart ? chart.HeightPx
        : Card.MatrixPresentation is { StretchMode: VizStretchMode.Fill } matrix ? matrix.HeightPx
        : 320;

    private string InteriorSlotCssClass(DashSpec.Modeling.Parse.Layout.Slot slot)
    {
        var kindClass = InteriorSlotClass(slot.Node.Kind);
        return IsFillDiagramSlot(slot) ? $"{kindClass} card-diagram-slot--fill" : kindClass;
    }

    internal string InteriorSlotStyle(string slotKey) =>
        Card.InteriorPlacements?.TryGetValue(slotKey, out var placement) == true
            ? Services.Presentation.DashboardLayoutHelper.CardInteriorSlotStyle(placement!, GridColumns)
            : string.Empty;

    private bool LocalFiltersAutoApply =>
        AutoApply && !Card.LocalFiltersManualApply;

    private Task OnLocalTopChanged(FilterDefinition filter, int value)
    {
        if (filter.Kind is not FilterKind.Top)
        {
            return Task.CompletedTask;
        }

        CardLocalTopLimits[filter.Name] = value;
        return LocalFiltersAutoApply
            ? OnScheduleCardApply.InvokeAsync(Card.Id)
            : Task.CompletedTask;
    }

    internal RenderFragment RenderLocalFilter(string filterName, string? placementStyle) => __builder =>
    {
        var filter = FilterIndex[filterName];
        if (_filterWidgetType is null)
        {
            return;
        }

        var filterWidgetParameters = new Dictionary<string, object?>
        {
            ["Filter"] = filter,
            ["Label"] = FilterWidgetPresentation.DisplayLabel(filter, FilterIndex, CardLocalSelectedFields),
            ["Hint"] = filter.Kind is FilterKind.Top ? Card.TopFilterScopeHint : null,
            ["PlacementStyle"] = placementStyle,
            ["Disabled"] = Card.Loading,
            ["Options"] = GetFieldOptions(filter.Name),
            ["Selected"] = FilterWidgetPresentation.SelectedFieldValues(filter, CardLocalSelectedFields),
            ["SelectedChanged"] = EventCallback.Factory.Create<HashSet<string>>(
                this,
                values => OnCardFieldChanged.InvokeAsync((Card.Id, filter.Name, values))),
            ["DateFrom"] = CardLocalDateFrom,
            ["DateTo"] = CardLocalDateTo,
            ["FilterIndex"] = FilterIndex,
            ["SelectedFields"] = CardLocalSelectedFields,
            ["OnDayChanged"] = EventCallback.Factory.Create<string>(
                this,
                args => OnCardDayChanged.InvokeAsync((Card.Id, args))),
            ["OnRangeChanged"] = EventCallback.Factory.Create(
                this,
                () => LocalFiltersAutoApply ? OnScheduleCardApply.InvokeAsync(Card.Id) : Task.CompletedTask),
            ["TopValue"] = FilterWidgetPresentation.ResolveTopValue(filter, CardLocalTopLimits),
            ["TopValueChanged"] = EventCallback.Factory.Create<int>(
                this,
                value => OnLocalTopChanged(filter, value)),
        };

        <DynamicComponent @key="@($"{filter.Name}:{FieldOptionsRevision}:{GetFieldOptions(filter.Name).Count}")"
                          Type="_filterWidgetType"
                          Parameters="filterWidgetParameters" />
    };
}
