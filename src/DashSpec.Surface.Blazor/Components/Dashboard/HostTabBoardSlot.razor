@namespace DashSpec.Surface.Blazor.Components.Dashboard
@using DashSpec.Execution.Runtime
@using DashSpec.Modeling.Core
@using DashSpec.Modeling.Parse.Layout
@using DashSpec.Surface.Blazor.Services.Presentation
@using DashSpec.Presentation.Components
@inject ILayoutSlotRendererRegistry SlotRegistry

@if (!SlotRegistry.Supports(Slot.Scope, Slot.Node.Kind))
{
    <div class="layout-slot-unsupported muted" role="status">@Slot.Scope / @Slot.Node.Kind</div>
}
else if (Slot.Node.Kind == WiringNodeKind.Card)
{
    if (Page.FindVisibleCard(Slot.Node.Id) is { } card)
    {
        <PlacementSlot Placement="Slot.Placement">
            <DashboardCardSlot Card="card"
                               Slot="Slot"
                               Page="Page"
                               AutoApply="AutoApply"
                               PlacementStyle="" />
        </PlacementSlot>
    }
}
else if (Slot.Node.Kind == WiringNodeKind.Nest && Slot.Inner?.Value is { } nestContainer)
{
    @* [ADR-0111] Recursive slot container: a Nest slot renders its Inner SlotContainer
       by recursively invoking HostTabBoardSlot on each child slot. *@
    <PlacementSlot Placement="Slot.Placement"
                   CssClass="card-nest">
        <div class="card-nest-cards" data-testid="@($"nest-{Slot.Node.Id}")" style="@PlacementGridCss.HostGridVariables(new LayoutDefinition(nestContainer.Columns))">
            @foreach (var innerSlot in nestContainer.Slots)
            {
                <HostTabBoardSlot Slot="innerSlot"
                                  Page="Page"
                                  Layout="Layout"
                                  AutoApply="AutoApply" />
            }
        </div>
    </PlacementSlot>
}
else if (Slot.Node.Kind == WiringNodeKind.Group && Slot.Inner?.Value is { } groupContainer)
{
    <section class="card-group" data-testid="@($"group-{Slot.Node.Id}")" style="@PlacementGridCss.GroupOuterStyle(Slot.Placement.Wide.Row)">
        @if (groupContainer.Title?.Value is { } groupTitle && !string.IsNullOrWhiteSpace(groupTitle))
        {
            <h3 class="card-group-title">@Page.ResolveDisplayTitle(groupTitle)</h3>
        }
        <div class="card-group-cards" style="@PlacementGridCss.HostGridVariables(new LayoutDefinition(groupContainer.Columns))">
            @foreach (var innerSlot in groupContainer.Slots)
            {
                <HostTabBoardSlot Slot="innerSlot"
                                  Page="Page"
                                  Layout="Layout"
                                  AutoApply="AutoApply" />
            }
        </div>
    </section>
}

@code {
    [Parameter, EditorRequired] public Slot Slot { get; set; } = default!;
    [Parameter, EditorRequired] public DashboardPageController Page { get; set; } = default!;
    [Parameter, EditorRequired] public LayoutDefinition Layout { get; set; } = default!;
    [Parameter] public bool AutoApply { get; set; }
}
