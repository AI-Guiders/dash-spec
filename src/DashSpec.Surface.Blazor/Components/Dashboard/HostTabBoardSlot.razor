@namespace DashSpec.Surface.Blazor.Components.Dashboard
@using DashSpec.Execution.Runtime
@using DashSpec.Modeling.Core
@using DashSpec.Modeling.Parse.Layout
@using DashSpec.Surface.Blazor.Services.Presentation
@using DashSpec.Presentation.Components
@inject ILayoutSlotRendererRegistry SlotRegistry

@if (!SlotRegistry.Supports(Slot.Scope, Slot.Node.Kind))
{
    <div class="layout-slot-unsupported muted" role="status">@Slot.Scope / @Slot.Node.Kind</div>
}
else if (Slot.Node.Kind == WiringNodeKind.Card)
{
    if (Page.FindVisibleCard(Slot.Node.Id) is { } card)
    {
        <PlacementSlot Placement="Slot.Placement" GridColumns="Layout.Columns">
            <DashboardCardSlot Card="card"
                               Page="Page"
                               AutoApply="AutoApply"
                               PlacementStyle="" />
        </PlacementSlot>
    }
}
else if (Slot.Node.Kind == WiringNodeKind.Nest)
{
    @* [ADR-0111] P1: the nested board slice — precomputed at assembly, read here. *@
    <PlacementSlot Placement="Slot.Placement"
                   GridColumns="Layout.Columns"
                   CssClass="card-nest">
        <div class="card-nest-cards" style="@PlacementGridCss.HostGridVariables(Layout)">
            @foreach (var (innerCard, innerPlacement) in Page.CardsForNest(Slot.Node.Id))
            {
                <PlacementSlot Placement="innerPlacement" GridColumns="Layout.Columns">
                    <DashboardCardSlot Card="innerCard"
                                       Page="Page"
                                       AutoApply="AutoApply"
                                       PlacementStyle="" />
                </PlacementSlot>
            }
        </div>
    </PlacementSlot>
}
else if (Slot.Node.Kind == WiringNodeKind.Group && Page.FindLayoutGroup(Slot.Node.Id) is { } group)
{
    <section class="card-group" style="@PlacementGridCss.GroupOuterStyle(Slot.Placement.Row)">
        @if (group.Title?.Value is { } groupTitle && !string.IsNullOrWhiteSpace(groupTitle))
        {
            <h3 class="card-group-title">@Page.ResolveDisplayTitle(groupTitle)</h3>
        }
        <div class="card-group-cards" style="@PlacementGridCss.HostGridVariables(Layout)">
            @foreach (var (innerCard, innerPlacement) in Page.CardsForGroup(group.Id))
            {
                <PlacementSlot Placement="innerPlacement" GridColumns="Layout.Columns">
                    <DashboardCardSlot Card="innerCard"
                                       Page="Page"
                                       AutoApply="AutoApply"
                                       PlacementStyle="" />
                </PlacementSlot>
            }
        </div>
    </section>
}

@code {
    [Parameter, EditorRequired] public Slot Slot { get; set; } = default!;
    [Parameter, EditorRequired] public DashboardPageController Page { get; set; } = default!;
    [Parameter, EditorRequired] public LayoutDefinition Layout { get; set; } = default!;
    [Parameter] public bool AutoApply { get; set; }
}
