@namespace DashSpec.Surface.Blazor.Components.Dashboard

@using DashSpec.Abstractions.Viewer
@using DashSpec.Surface.Blazor.Services.Localization
@using DashSpec.Surface.Blazor.Services.Presentation
@using DashSpec.Viz
@inject DashboardLocalizer Loc
@inject ICardChromeControlsOverride ChromeControls

@* ADR-0073 navigation surface: one tree — catalog groups → entries; the active entry
   carries its sections as children. The stack paints its own sidebar component when bound,
   or falls back to native semantic HTML. *@

@if (ChromeControls.ResolveSidebar() is { } stackSidebar)
{
    <DynamicComponent Type="stackSidebar"
                      Parameters="@(new Dictionary<string, object?>
                      {
                          ["Context"] = new StackSidebarContext
                          {
                              Entries = Entries,
                              Groups = Groups,
                              ActiveEntryId = ActiveEntryId,
                              Busy = Busy,
                              SidebarLabel = SidebarText,
                              Tabs = Tabs,
                              ResolveTabLabel = ResolveTabLabel,
                              ActiveTabId = ActiveTabId,
                              SectionsMode = SectionsMode,
                              CollapseDuplicateSection = CollapseDuplicateSection,
                              OnSelectEntry = OnSelectEntry,
                              OnSelectTab = OnSelectTab,
                          },
                      })" />
}
else
{
<aside class="dash-sidebar @(_desktopCollapsed ? "dash-sidebar--collapsed" : null)" aria-label="@SidebarText">
        <div class="dash-sidebar-header">
            @if (!_desktopCollapsed)
            {
                <span class="dash-sidebar-header-title">@SidebarText</span>
            }
            <button type="button"
                    class="dash-sidebar-collapse-btn"
                    title="@(_desktopCollapsed ? "Expand navigation" : "Collapse navigation")"
                    aria-label="@SidebarText"
                    @onclick="() => _desktopCollapsed = !_desktopCollapsed">
                @(_desktopCollapsed ? "»" : "«")
            </button>
        </div>
        @if (!_desktopCollapsed)
        {
        <ul class="dash-sidebar-menu" role="menu">
            @foreach (var group in Groups)
            {
                <li class="dash-sidebar-group" role="menuitem">
                    <span class="dash-sidebar-group-title">@DisplayResolutionHost.ResolveCatalogGroupTitle(group)</span>
                    <ul class="dash-sidebar-submenu" role="menu">
                        @foreach (var entry in EntriesOf(group))
                        {
                            @EntryNode(entry)
                        }
                    </ul>
                </li>
            }
            @foreach (var entry in Entries.Where(entry => string.IsNullOrWhiteSpace(entry.GroupId?.Value)))
            {
                @EntryNode(entry)
            }
        </ul>
        }
    </aside>
}

@code {
    private bool _desktopCollapsed;

    [Parameter] public IReadOnlyList<CatalogEntryDefinition> Entries { get; set; } = [];

    [Parameter] public IReadOnlyList<CatalogGroupDefinition> Groups { get; set; } = [];

    [Parameter] public string? ActiveEntryId { get; set; }

    [Parameter] public bool Busy { get; set; }

    [Parameter] public string? CatalogLabel { get; set; }

    [Parameter] public string? SectionsLabel { get; set; }

    [Parameter] public string? SidebarLabel { get; set; }

    /// <summary>UI copy SSOT (ADR-0077): labels come from the localizer, parameters override.</summary>
    private string SidebarText => SidebarLabel ?? Loc.T("Navigation");

    [Parameter] public IReadOnlyList<TabDefinition> Tabs { get; set; } = [];

    [Parameter] public Func<TabDefinition, string>? ResolveTabLabel { get; set; }

    [Parameter] public string? ActiveTabId { get; set; }

    [Parameter] public EventCallback<string> OnSelectEntry { get; set; }

    [Parameter] public EventCallback<string> OnSelectTab { get; set; }

    /// <summary>Menu policy (the host module's `menu` block, ADR-0073/0074: explicit,
    /// never host heuristics).</summary>
    [Parameter] public ViewerMenuSectionsMode SectionsMode { get; set; } = ViewerMenuSectionsMode.All;

    [Parameter] public bool CollapseDuplicateSection { get; set; }

    private RenderFragment EntryNode(CatalogEntryDefinition entry) => __builder =>
    {
        var entryId = entry.Id;
        var isActive = IsEntryActive(entry);
        var sections = SectionsFor(entry, isActive);
        <li class="dash-sidebar-entry @(isActive ? "is-active" : null)" role="menuitem">
            <button type="button"
                    class="dash-sidebar-link"
                    disabled="@Busy"
                    @onclick="() => OnSelectEntry.InvokeAsync(entryId)">
                @DisplayResolutionHost.ResolveCatalogEntryTitle(entry)
            </button>
            @if (sections.Count > 0)
            {
                <ul class="dash-sidebar-sections" role="menu">
                    @foreach (var tab in sections)
                    {
                        var tabId = tab.Id;
                        var tabActive = string.Equals(tab.Id, ActiveTabId, StringComparison.OrdinalIgnoreCase);
                        <li class="dash-sidebar-section @(tabActive ? "is-active" : null)" role="menuitem">
                            <button type="button"
                                    class="dash-sidebar-link"
                                    @onclick="() => OnSelectTab.InvokeAsync(tabId)">
                                @(ResolveTabLabel?.Invoke(tab) ?? tab.Label?.Value ?? tab.Id)
                            </button>
                        </li>
                    }
                </ul>
            }
        </li>
    };

    private IReadOnlyList<TabDefinition> SectionsFor(CatalogEntryDefinition entry, bool isActive)
    {
        if (!isActive || SectionsMode is ViewerMenuSectionsMode.None || Tabs is not { Count: > 0 })
        {
            return [];
        }

        var pinned = entry.InitialTabId?.Value;
        IEnumerable<TabDefinition> sections = Tabs;
        if (SectionsMode is ViewerMenuSectionsMode.Siblings && !string.IsNullOrWhiteSpace(pinned))
        {
            sections = sections.Where(tab =>
                !string.Equals(tab.Id, pinned, StringComparison.OrdinalIgnoreCase));
        }

        var list = sections.ToList();
        if (CollapseDuplicateSection &&
            list.Count == 1 &&
            string.Equals(
                ResolveTabLabel?.Invoke(list[0]) ?? list[0].Label?.Value ?? list[0].Id,
                DisplayResolutionHost.ResolveCatalogEntryTitle(entry),
                StringComparison.OrdinalIgnoreCase))
        {
            return [];
        }

        return list;
    }

    private bool IsEntryActive(CatalogEntryDefinition entry)
    {
        var active = string.IsNullOrWhiteSpace(ActiveEntryId)
            ? Entries.FirstOrDefault()?.Id
            : ActiveEntryId;
        return string.Equals(entry.Id, active, StringComparison.OrdinalIgnoreCase);
    }

    private IEnumerable<CatalogEntryDefinition> EntriesOf(CatalogGroupDefinition group) =>
        Entries.Where(entry => string.Equals(entry.GroupId?.Value, group.Id, StringComparison.OrdinalIgnoreCase));
}
