@namespace DashSpec.Surface.Blazor.Components.Dashboard
@using DashSpec.Abstractions.Viz
@using Radzen
@using Radzen.Blazor
@inject IRenderStackSettings RenderStackSettings

@* Tab chrome belongs to the stack (ADR-0112 §5): the Radzen stack speaks RadzenTabs
   (board lives below the bar, so items carry no content; SelectedIndexChanged is
   awaited so the controller switch lands before the re-render); the SelfMade stack
   renders the pre-Radzen dash-tabs exactly as they were. *@

@if (Tabs is { Count: > 0 })
{
    if (IsRadzenStack)
    {
        <RadzenTabs SelectedIndex="@SelectedTabIndex"
                    SelectedIndexChanged="@HandleTabIndexChanged">
            <Tabs>
                @foreach (var tab in Tabs)
                {
                    <RadzenTabsItem Text="@(ResolveLabel?.Invoke(tab) ?? tab.Label?.Value ?? tab.Id)" />
                }
            </Tabs>
        </RadzenTabs>
    }
    else
    {
        <nav class="dash-tabs @(Sticky ? "dash-tabs-sticky" : null)" aria-label="Вкладки дашборда">
            @foreach (var tab in Tabs)
            {
                var active = string.Equals(tab.Id, ActiveTabId, StringComparison.OrdinalIgnoreCase);
                <button type="button"
                        class="dash-tab @(active ? "dash-tab-active" : null)"
                        aria-selected="@active"
                        @onclick="() => OnSelect.InvokeAsync(tab.Id)">
                    @(ResolveLabel?.Invoke(tab) ?? tab.Label?.Value ?? tab.Id)
                </button>
            }
        </nav>
    }
}

@code {
    [Parameter] public IReadOnlyList<TabDefinition> Tabs { get; set; } = [];
    [Parameter] public Func<TabDefinition, string>? ResolveLabel { get; set; }
    [Parameter] public string? ActiveTabId { get; set; }
    [Parameter] public bool Sticky { get; set; }
    [Parameter] public EventCallback<string> OnSelect { get; set; }

    private bool IsRadzenStack =>
        string.Equals(RenderStackSettings?.HostStack?.Trim(), "radzen", StringComparison.OrdinalIgnoreCase);

    private int SelectedTabIndex
    {
        get
        {
            for (var i = 0; i < Tabs.Count; i++)
            {
                if (string.Equals(Tabs[i].Id, ActiveTabId, StringComparison.OrdinalIgnoreCase))
                {
                    return i;
                }
            }

            return 0;
        }
    }

    private async Task HandleTabIndexChanged(int index)
    {
        if (index >= 0 && index < Tabs.Count)
        {
            await OnSelect.InvokeAsync(Tabs[index].Id);
        }
    }
}
