@inherits LayoutComponentBase
@using DashSpec.Abstractions.Viewer
@using DashSpec.Presentation.Filters
@using DashSpec.Surface.Blazor.Services.Presentation
@inject IViewerPresentationOptions Bootstrap
@inject IViewerShellChrome HostShell
@inject HostPresentationSignals PresentationSignals
@inject NavigationManager Navigation
@implements IDisposable

@* Shell ([ADR-0111] §2 experiment): the host renders its own ds shell first. Chrome rows
   read as cells: chrome slots fit content, a `.` dot is a rubber spacer sharing free
   space by weight, the content slot is greedy — it takes the row entirely. *@

@code {
    private bool ShowCommandBar =>
        HostShell.ShowsSurface("command_bar") && IsDashboardRoute();

    private bool IsDashboardRoute()
    {
        if (!Uri.TryCreate(Navigation.Uri, UriKind.Absolute, out var uri))
        {
            return true;
        }

        var path = uri.AbsolutePath.TrimEnd('/');
        return path.Length == 0 || path.Equals("/", StringComparison.Ordinal);
    }

    private string Scheme => Bootstrap.ColorScheme is "light" or "contrast"
        ? "scheme-" + Bootstrap.ColorScheme
        : string.Empty;

    private string LargeFilterLayoutClass =>
        DashSpec.Presentation.Filters.FilterLargeListOptions.IsExpand(Bootstrap.LargeFieldFilterLayout)
            ? "filter-large-expand"
            : string.Empty;

    protected override void OnInitialized() =>
        PresentationSignals.Changed += OnPresentationChanged;

    private void OnPresentationChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => PresentationSignals.Changed -= OnPresentationChanged;
}

<div class="page @Scheme @LargeFilterLayoutClass">
    @{
        var contentSlot = HostShell.ShellSlots.FirstOrDefault(
            slot => slot.SlotId == ViewerShellSlotIds.Content);
        var chromeRows = HostShell.ShellSlots
            .Where(slot => slot.SlotId != ViewerShellSlotIds.Content)
            .GroupBy(slot => slot.Row)
            .OrderBy(group => group.Key);
    }
    @foreach (var row in chromeRows)
    {
        var cells = row.OrderBy(slot => slot.Col).ToList();
        <div class="shell-row">
            @foreach (var cell in cells)
            {
                @if (cell.SlotId == ".")
                {
                    <span class="shell-spacer" style="flex-grow:@cell.Span"></span>
                }
                else
                {
                    <nav class="topbar-nav shell-slot">
                        <HostShellSlot Slot="cell" />
                    </nav>
                }
            }
        </div>
    }
    @if (contentSlot is not null)
    {
        <main class="shell-content">
            @if (ShowCommandBar)
            {
                <HostCommandBar />
            }
            @Body
        </main>
    }
</div>
