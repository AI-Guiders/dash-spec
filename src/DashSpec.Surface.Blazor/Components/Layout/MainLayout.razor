@inherits LayoutComponentBase
@using DashSpec.Abstractions.Viewer
@using DashSpec.Presentation.Filters
@using DashSpec.Surface.Blazor.Services.Presentation
@inject IViewerPresentationOptions Bootstrap
@inject IViewerShellChrome HostShell
@inject HostPresentationSignals PresentationSignals
@inject NavigationManager Navigation
@implements IDisposable

@* Shell grid ([ADR-0111] §2): the host renders its own ds shell first — chrome slots plus the
   content slot, placed as recorded in the host module board (or the embedded default). *@

@code {
    private bool ShowCommandBar =>
        HostShell.ShowsSurface("command_bar") && IsDashboardRoute();

    private bool IsDashboardRoute()
    {
        if (!Uri.TryCreate(Navigation.Uri, UriKind.Absolute, out var uri))
        {
            return true;
        }

        var path = uri.AbsolutePath.TrimEnd('/');
        return path.Length == 0 || path.Equals("/", StringComparison.Ordinal);
    }

    private string Scheme => Bootstrap.ColorScheme is "light" or "contrast"
        ? "scheme-" + Bootstrap.ColorScheme
        : string.Empty;

    private string LargeFilterLayoutClass =>
        DashSpec.Presentation.Filters.FilterLargeListOptions.IsExpand(Bootstrap.LargeFieldFilterLayout)
            ? "filter-large-expand"
            : string.Empty;

    private static string SlotGridStyle(ViewerShellSlot slot) =>
        $"grid-column:{slot.Col} / span {slot.Span};grid-row:{slot.Row};";

    protected override void OnInitialized() =>
        PresentationSignals.Changed += OnPresentationChanged;

    private void OnPresentationChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => PresentationSignals.Changed -= OnPresentationChanged;
}

<div class="page @Scheme @LargeFilterLayoutClass">
    @foreach (var slot in HostShell.ShellSlots)
    {
        @if (slot.SlotId == ViewerShellSlotIds.Content)
        {
            <main class="shell-content" style="@SlotGridStyle(slot)">
                @if (ShowCommandBar)
                {
                    <HostCommandBar />
                }
                @Body
            </main>
        }
        else
        {
            <HostShellSlot Slot="slot" />
        }
    }
</div>
