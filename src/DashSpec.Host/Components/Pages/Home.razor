@implements IDisposable
@page "/"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using DashSpec.Core.Model
@using DashSpec.Host.Components.Dashboard
@using DashSpec.Host.Commands
@using DashSpec.Host.Services.Presentation
@using DashSpec.Execution.Runtime
@inject IWebHostEnvironment HostEnvironment
@inject DashSpec.Host.Services.Localization.DashboardLocalizer Loc

<PageTitle>@Page.ResolvedReportTitle</PageTitle>

<div class="dash-home">
<DashboardToolbar Busy="Page.Switching"
                  ShowUpload="HostEnvironment.IsDevelopment()"
                  OnUpload="Page.OnSpecUploadedAsync" />

@if (!string.IsNullOrEmpty(Page.Error))
{
    <div class="alert" role="alert">
        <strong>@Loc.T("Failed to load dashboard")</strong>
        @{
            var errorLines = Page.Error.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        }
        @if (errorLines.Length <= 1)
        {
            <p>@Page.Error</p>
        }
        else
        {
            <ul class="dash-load-errors">
                @foreach (var line in errorLines)
                {
                    <li>@line</li>
                }
            </ul>
        }
    </div>
}
else if (!Page.Loaded)
{
    <div class="page-loading">
        <div class="spinner" aria-hidden="true"></div>
        <span>@Loc.T("Loading specification…")</span>
    </div>
}
else
{
    var chrome = Page.Session.Document.FiltersChrome;

    @if (Page.Session.Document.Tabs.Count > 1)
    {
        <DashboardTabBar Tabs="Page.Session.Document.Tabs"
                         ActiveTabId="Page.ActiveTabId"
                         ResolveLabel="Page.ResolveTabLabel"
                         Sticky="chrome.IsSticky"
                         OnSelect="Page.SelectTab" />
    }

    @if (Page.HasPages)
    {
        <DashboardPagePicker Pages="Page.ActiveTabPages()"
                             ActivePageId="Page.ActivePageId"
                             ResolveLabel="Page.ResolvePageNavTitle"
                             OnSelect="Page.SelectPageAsync" />
    }

    @if (!string.IsNullOrEmpty(Page.CommandError))
    {
        <div class="dash-command-error" role="alert">@Page.CommandError</div>
    }

    <DashboardFiltersSection FilterNames="Page.VisibleToolbarFilters()"
                             FilterIndex="Page.Session.FilterIndex"
                             FiltersToCards="Page.FiltersToCards"
                             DateFrom="Page.DateFrom"
                             DateTo="Page.DateTo"
                             SelectedFields="Page.SelectedFields"
                             TopLimits="Page.TopLimits"
                             GetFieldOptions="Page.Session.GetFieldOptions"
                             FieldOptionsRevision="Page.FieldOptionsRevision"
                             Layout="Page.Session.Document.Layout"
                             FilterPlacements="Page.ToolbarPlacements"
                             BarLayout="chrome.IsBarLayout"
                             ToolbarLabeledCells="chrome.IsToolbarLabeledCells"
                             AutoApply="chrome.IsAutoApply"
                             ApplyIconControl="chrome.IsApplyIconControl"
                             Busy="Page.Busy"
                             SectionClass="@Page.FiltersSectionClass()"
                             GridClass="@Page.FiltersGridClass()"
                             GridStyle="@Page.FiltersGridStyle()"
                             OnApply="Page.ApplyFiltersAsync"
                             OnScheduleApply="Page.OnDashboardRangeChanged"
                             OnDayChanged="Page.OnDashboardDayChanged"
                             OnFieldChanged="Page.OnDashboardFieldChanged"
                             OnTopChanged="Page.OnDashboardTopChanged" />

    @if (chrome.ShowsFormatGuide)
    {
        <div class="report-format-guide muted" aria-label="@Loc.T("Date and time formats")">
            <table class="report-format-table">
                <thead>
                    <tr>
                        <th scope="col">@Loc.T("Kind")</th>
                        <th scope="col">@Loc.T("Format")</th>
                        <th scope="col">@Loc.T("Example")</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Page.FormatReadingGuide.Rows)
                    {
                        <tr>
                            <th scope="row">@row.Label</th>
                            <td><code>@row.Pattern</code></td>
                            <td>@row.Example</td>
                        </tr>
                    }
                    <tr>
                        <th scope="row">@Loc.T("Time zone")</th>
                        <td colspan="2">@Page.FormatReadingGuide.TimeZoneLabel</td>
                    </tr>
                </tbody>
            </table>
        </div>
    }

    <DashboardTabBoard Slots="Page.HostTabBoardSlots()"
                       Page="Page"
                       Layout="Page.Session.Document.Layout"
                       AutoApply="chrome.IsAutoApply" />
}
</div>
