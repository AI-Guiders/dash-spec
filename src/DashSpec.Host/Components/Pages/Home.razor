@implements IDisposable
@page "/"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using DashSpec.Core.Compilation
@using DashSpec.Core.Runtime
@inject DashboardSessionService Dashboard

<PageTitle>@(_loaded ? Dashboard.Document.Title : "DashSpec")</PageTitle>

<section class="dash-toolbar">
    <label class="dash-upload-btn secondary @( _switching ? "dash-upload-btn-busy" : null)">
        @if (_switching)
        {
            <span class="spinner spinner-inline" aria-hidden="true"></span>
            <span>Загрузка…</span>
        }
        else
        {
            <span>Загрузить .dashspec</span>
        }
        <InputFile OnChange="OnSpecUploadedAsync" accept=".dashspec" disabled="@_switching" />
    </label>
    @if (!string.IsNullOrEmpty(_loadedSpecSource))
    {
        <span class="badge">@_loadedSpecSource</span>
    }
</section>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert" role="alert">
        <strong>Не удалось загрузить dashboard</strong>
        <p>@_error</p>
    </div>
}
else if (!_loaded)
{
    <div class="page-loading">
        <div class="spinner" aria-hidden="true"></div>
        <span>Загрузка спецификации…</span>
    </div>
}
else
{
    <header class="dash-header">
        <div>
            <h1>@Dashboard.Document.Title</h1>
            <p class="muted dash-meta">
                <span class="badge">@Dashboard.Document.Id</span>
                <span class="badge">@Dashboard.ActiveConnectorId</span>
            </p>
        </div>
    </header>

    var chrome = Dashboard.Document.FiltersChrome;
    var filtersClass = chrome.IsBarLayout ? "filters filters-bar" : "filters filters-card";
    if (chrome.IsStickyCard)
    {
        filtersClass += " filters-sticky-card";
    }

    var filtersGridClass = chrome.IsStickyLine
        ? "filters-grid filters-grid-sticky"
        : "filters-grid";

    @if (Dashboard.Document.Tabs is { Count: > 0 })
    {
        <nav class="dash-tabs @(chrome.IsSticky ? "dash-tabs-sticky" : null)" aria-label="Вкладки дашборда">
            @foreach (var tab in Dashboard.Document.Tabs)
            {
                var active = string.Equals(tab.Id, _activeTabId, StringComparison.OrdinalIgnoreCase);
                <button type="button"
                        class="dash-tab @(active ? "dash-tab-active" : null)"
                        aria-selected="@active"
                        @onclick="() => SelectTab(tab.Id)">
                    @(tab.Label ?? tab.Id)
                </button>
            }
        </nav>
    }

    <section class="@filtersClass" aria-label="Фильтры дашборда">
        <div class="@filtersGridClass">
            @foreach (var filterName in Dashboard.Document.DashboardFilters)
            {
                var filter = Dashboard.FilterIndex[filterName];
                if (filter.Kind is FilterKind.Date)
                {
                    <div class="filter filter-date @(chrome.IsBarLayout ? "filter-inline" : null)">
                        @if (!chrome.IsBarLayout)
                        {
                            <span class="filter-label">@FilterDisplayLabel(filter)</span>
                            <span class="filter-scope">@FilterScopeHint(filter.Name)</span>
                        }
                        <div class="date-range @(filter.IsDayWidget ? "date-range-day" : null)">
                            @if (chrome.IsBarLayout)
                            {
                                <span class="filter-inline-label">@FilterDisplayLabel(filter)</span>
                            }
                            @if (filter.IsDayWidget)
                            {
                                <input type="date"
                                       aria-label="@FilterDisplayLabel(filter)"
                                       @bind="_dateFrom[filter.Name]"
                                       @bind:format="yyyy-MM-dd"
                                       @bind:after="() => OnDashboardDayChanged(filter.Name)" />
                            }
                            else
                            {
                                <input type="date"
                                       aria-label="@($"{filter.Name} from")"
                                       @bind="_dateFrom[filter.Name]"
                                       @bind:format="yyyy-MM-dd"
                                       @bind:after="ScheduleDashboardApplyAsync" />
                                <span class="date-sep">—</span>
                                <input type="date"
                                       aria-label="@($"{filter.Name} to")"
                                       @bind="_dateTo[filter.Name]"
                                       @bind:format="yyyy-MM-dd"
                                       @bind:after="ScheduleDashboardApplyAsync" />
                            }
                        </div>
                    </div>
                }
                else if (filter.Kind is FilterKind.Field)
                {
                    <FieldMultiSelect Label="@FilterDisplayLabel(filter)"
                                      Hint="@(chrome.IsBarLayout ? null : FilterScopeHint(filter.Name))"
                                      Compact="@chrome.IsBarLayout"
                                      Combobox="@filter.IsComboboxWidget"
                                      Options="Dashboard.GetFieldOptions(filter.Name)"
                                      Selected="_selectedFields[filter.Name]"
                                      SelectedChanged="values => OnDashboardFieldChanged(filter.Name, values)" />
                }
            }
        </div>
        @if (!chrome.IsAutoApply)
        {
            <div class="filters-actions">
                <button class="primary"
                        disabled="@_busy"
                        @onclick="ApplyFiltersAsync">
                    @if (_busy)
                    {
                        <span class="spinner spinner-inline" aria-hidden="true"></span>
                        <span>Загрузка…</span>
                    }
                    else
                    {
                        <span>Применить</span>
                    }
                </button>
            </div>
        }
        else if (_busy)
        {
            <div class="filters-actions">
                <span class="muted filters-busy"><span class="spinner spinner-inline" aria-hidden="true"></span> обновление…</span>
            </div>
        }
    </section>

    <section class="cards" style="@CardsGridStyle()" aria-live="polite">
        @foreach (var card in VisibleCards())
        {
            <article class="card" style="@CardPlacementStyle(card)">
                <div class="card-head">
                    <div>
                        <h2><RichTextView Text="@card.Title" /></h2>
                        @if (card.LocalFilters is { Count: > 0 })
                        {
                            <div class="card-filters card-filters-local">
                                @foreach (var filterName in card.LocalFilters)
                                {
                                    var filter = Dashboard.FilterIndex[filterName];
                                    if (filter.Kind is FilterKind.Date)
                                    {
                                        <div class="filter filter-date filter-compact">
                                            <span class="filter-label">@FilterDisplayLabel(filter)</span>
                                            <div class="date-range @(filter.IsDayWidget ? "date-range-day" : null)">
                                                @if (filter.IsDayWidget)
                                                {
                                                    <input type="date"
                                                           aria-label="@FilterDisplayLabel(filter)"
                                                           @bind="_dateFrom[filter.Name]"
                                                           @bind:format="yyyy-MM-dd"
                                                           @bind:after="() => OnCardDayChanged(card.Id, filter.Name)" />
                                                }
                                                else
                                                {
                                                    <input type="date"
                                                           aria-label="@($"{filter.Name} from")"
                                                           @bind="_dateFrom[filter.Name]"
                                                           @bind:format="yyyy-MM-dd"
                                                           @bind:after="() => ScheduleCardApplyAsync(card.Id)" />
                                                    <span class="date-sep">—</span>
                                                    <input type="date"
                                                           aria-label="@($"{filter.Name} to")"
                                                           @bind="_dateTo[filter.Name]"
                                                           @bind:format="yyyy-MM-dd"
                                                           @bind:after="() => ScheduleCardApplyAsync(card.Id)" />
                                                }
                                            </div>
                                        </div>
                                    }
                                    else if (filter.Kind is FilterKind.Field)
                                    {
                                        <FieldMultiSelect Label="@FilterDisplayLabel(filter)"
                                                          Combobox="@filter.IsComboboxWidget"
                                                          Options="Dashboard.GetFieldOptions(filter.Name)"
                                                          Selected="_selectedFields[filter.Name]"
                                                          SelectedChanged="values => OnCardFieldChanged(card.Id, filter.Name, values)" />
                                    }
                                    else if (filter.Kind is FilterKind.Top)
                                    {
                                        <div class="filter filter-top filter-compact">
                                            <span class="filter-label">@FilterDisplayLabel(filter)</span>
                                            <input type="number"
                                                   class="filter-number"
                                                   aria-label="@FilterDisplayLabel(filter)"
                                                   min="@(filter.MinValue ?? 1)"
                                                   max="@(filter.MaxValue ?? TopLimitDefaults.DefaultMax)"
                                                   @bind="_topLimits[filter.Name]"
                                                   @bind:after="() => ScheduleCardApplyAsync(card.Id)" />
                                        </div>
                                    }
                                }
                                @if (!Dashboard.Document.FiltersChrome.IsAutoApply)
                                {
                                    <button class="secondary card-filter-apply"
                                            disabled="@card.Loading"
                                            @onclick="() => ApplyCardFiltersAsync(card.Id)">
                                        Применить
                                    </button>
                                }
                            </div>
                        }
                        @{
                            var dashboardBound = (card.BoundFilters ?? [])
                                .Where(name => Dashboard.Document.DashboardFilters.Contains(name, StringComparer.OrdinalIgnoreCase))
                                .ToList();
                        }
                        @if (dashboardBound.Count > 0)
                        {
                            <div class="card-filters">
                                @foreach (var filterName in dashboardBound)
                                {
                                    <span class="scope-chip">@FormatActiveFilterChip(filterName)</span>
                                }
                            </div>
                        }
                    </div>
                    @if (card.Loading)
                    {
                        <span class="card-status muted">загрузка…</span>
                    }
                    else if (!string.IsNullOrEmpty(card.Error))
                    {
                        <span class="card-status card-status-error">ошибка</span>
                    }
                </div>

                @if (card.Loading)
                {
                    <div class="card-skeleton">
                        <div class="spinner" aria-hidden="true"></div>
                    </div>
                }
                else if (!string.IsNullOrEmpty(card.Error))
                {
                    <div class="card-error">@card.Error</div>
                }
                else if (card.DataFamily is DiagramDataFamily.Chart)
                {
                    @if (card.Chart is null || card.Chart.Labels.Count == 0)
                    {
                        <p class="empty-state">Нет данных за выбранный период</p>
                    }
                    else
                    {
                        <div class="chart-wrap" style="@ChartHeightStyle(card)">
                            <ChartCanvas ChartId="@ChartId(card.Id)"
                                         ChartType="@(string.Equals(card.DiagramKind, "bar", StringComparison.OrdinalIgnoreCase) ? "bar" : "line")"
                                         Payload="card.Chart"
                                         Legend="@(card.ChartPresentation?.Legend ?? "bottom")"
                                         Stacked="@(card.ChartPresentation?.Stacked ?? false)" />
                        </div>
                    }
                }
                else if (card.DataFamily is DiagramDataFamily.Table && card.Table is not null)
                {
                    @if (card.Table.Rows.Count == 0)
                    {
                        <p class="empty-state">Нет строк</p>
                    }
                    else
                    {
                        <div class="table-wrap">
                            <table>
                                <thead>
                                    <tr>
                                        @foreach (var column in card.Table.Columns)
                                        {
                                            <th>@column</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in card.Table.Rows)
                                    {
                                        <tr>
                                            @foreach (var cell in row)
                                            {
                                                <td>@cell</td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <p class="table-foot muted">Показано @card.Table.Rows.Count строк</p>
                    }
                }
                else if (card.DataFamily is DiagramDataFamily.Scalar)
                {
                    <div class="number">@(card.Number ?? "—")</div>
                }
                else if (card.DataFamily is DiagramDataFamily.Matrix && card.Matrix is not null)
                {
                    <HeatmapView Payload="card.Matrix"
                                 HeightPx="@(card.MatrixPresentation?.HeightPx ?? 320)"
                                 XAxisLabel="@card.MatrixPresentation?.XLabel"
                                 YAxisLabel="@card.MatrixPresentation?.YLabel"
                                 ValueLabel="@card.MatrixPresentation?.ValueLabel"
                                 TooltipLabel="@card.MatrixPresentation?.TooltipLabel"
                                 TooltipFormat="@(card.MatrixPresentation?.TooltipFormat ?? TooltipFormat.Inline)"
                                 TooltipSplit="@(card.MatrixPresentation?.TooltipSplit ?? ", ")"
                                 XFormat="@(card.MatrixPresentation?.XFormat ?? "date.short")"
                                 YFormat="@(card.MatrixPresentation?.YFormat ?? "user.short")"
                                 ColorScale="@(card.MatrixPresentation?.ColorScale ?? "heat")"
                                 LegendMinText="@card.MatrixPresentation?.FormatLegendMin(PayloadMin(card), PayloadMax(card))"
                                 LegendMaxText="@card.MatrixPresentation?.FormatLegendMax(PayloadMin(card), PayloadMax(card))" />
                }
            </article>
        }
    </section>
}

@code {
    private bool _loaded;
    private bool _busy;
    private bool _switching;
    private string? _error;
    private string? _loadedSpecSource;
    private List<CardRenderResult> _cards = [];
    private Dictionary<string, DateOnly> _dateFrom = new(StringComparer.OrdinalIgnoreCase);
    private Dictionary<string, DateOnly> _dateTo = new(StringComparer.OrdinalIgnoreCase);
    private Dictionary<string, HashSet<string>> _selectedFields = new(StringComparer.OrdinalIgnoreCase);
    private Dictionary<string, int> _topLimits = new(StringComparer.OrdinalIgnoreCase);

    private Dictionary<string, IReadOnlyList<string>> _filtersToCards = new(StringComparer.OrdinalIgnoreCase);
    private Dictionary<string, PlacementDefinition> _tabPlacements = new(StringComparer.OrdinalIgnoreCase);
    private string? _activeTabId;
    private CancellationTokenSource? _dashboardApplyCts;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await Dashboard.LoadAsync();
            _loadedSpecSource = Dashboard.LoadedSpecSource;
            await InitializeDashboardStateAsync();
            _loaded = true;
            await RefreshCardsAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task OnSpecUploadedAsync(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null)
        {
            return;
        }

        _switching = true;
        _loaded = false;
        _error = null;
        _dashboardApplyCts?.Cancel();
        StateHasChanged();

        try
        {
            const long maxBytes = 2 * 1024 * 1024;
            await using var stream = file.OpenReadStream(maxBytes);
            await Dashboard.LoadFromUploadAsync(stream, file.Name);
            _loadedSpecSource = Dashboard.LoadedSpecSource;
            await InitializeDashboardStateAsync();
            _loaded = true;
            await RefreshCardsAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _loaded = false;
        }
        finally
        {
            _switching = false;
        }
    }

    private async Task InitializeDashboardStateAsync()
    {
        _activeTabId = Dashboard.Document.Tabs.FirstOrDefault()?.Id;
        RecomputeTabPlacements();
        _filtersToCards = FilterBinding.MapFiltersToCards(Dashboard.Document, Dashboard.SpecLibrary)
            .ToDictionary(x => x.Key, x => x.Value, StringComparer.OrdinalIgnoreCase);

        _dateFrom.Clear();
        _dateTo.Clear();
        _selectedFields.Clear();
        _topLimits.Clear();

        foreach (var filterName in PlacedFilterNames())
        {
            var filter = Dashboard.FilterIndex[filterName];
            if (filter.Kind is FilterKind.Date)
            {
                var range = Dashboard.Filters.GetDate(filter.Name)
                    ?? DateDefaultRange.Resolve(filter.DefaultExpression!, DateOnly.FromDateTime(DateTime.UtcNow));
                _dateFrom[filter.Name] = range.From;
                _dateTo[filter.Name] = range.To;
            }
            else if (filter.Kind is FilterKind.Field)
            {
                _selectedFields[filter.Name] = [];
            }
            else if (filter.Kind is FilterKind.Top)
            {
                _topLimits[filter.Name] = TopLimitDefaults.Resolve(
                    filter,
                    Dashboard.Filters.GetTop(filter.Name));
            }
        }

        await Task.CompletedTask;
    }

    private void SelectTab(string tabId)
    {
        _activeTabId = tabId;
        RecomputeTabPlacements();
        StateHasChanged();
    }

    private void RecomputeTabPlacements()
    {
        _tabPlacements.Clear();
        if (Dashboard.Document.Tabs.Count == 0 || string.IsNullOrWhiteSpace(_activeTabId))
        {
            return;
        }

        foreach (var (title, placement) in TabLayoutCompactor.Compact(Dashboard.Document, _activeTabId, Dashboard.SpecLibrary))
        {
            _tabPlacements[title] = placement;
        }
    }

    private IEnumerable<CardRenderResult> VisibleCards()
    {
        if (Dashboard.Document.Tabs.Count == 0 || string.IsNullOrWhiteSpace(_activeTabId))
        {
            return _cards;
        }

        var tab = Dashboard.Document.Tabs.Single(t =>
            string.Equals(t.Id, _activeTabId, StringComparison.OrdinalIgnoreCase));

        return _cards.Where(card =>
            tab.CardIds.Contains(card.Id, StringComparer.OrdinalIgnoreCase));
    }

    private void OnDashboardFieldChanged(string name, HashSet<string> values)
    {
        _selectedFields[name] = values;
        ScheduleDashboardApplyAsync();
    }

    private void OnDashboardDayChanged(string name)
    {
        if (_dateFrom.TryGetValue(name, out var day))
        {
            _dateTo[name] = day;
        }

        ScheduleDashboardApplyAsync();
    }

    private void OnCardDayChanged(string cardId, string name)
    {
        if (_dateFrom.TryGetValue(name, out var day))
        {
            _dateTo[name] = day;
        }

        ScheduleCardApplyAsync(cardId);
    }

    private void OnCardFieldChanged(string cardId, string name, HashSet<string> values)
    {
        _selectedFields[name] = values;
        ScheduleCardApplyAsync(cardId);
    }

    private void ScheduleDashboardApplyAsync()
    {
        if (!Dashboard.Document.FiltersChrome.IsAutoApply)
        {
            return;
        }

        _dashboardApplyCts?.Cancel();
        _dashboardApplyCts?.Dispose();
        _dashboardApplyCts = new CancellationTokenSource();
        var token = _dashboardApplyCts.Token;
        _ = DebouncedDashboardApplyAsync(token);
    }

    private async Task DebouncedDashboardApplyAsync(CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(Dashboard.Document.FiltersChrome.DebounceMs, cancellationToken);
            await ApplyFiltersAsync();
        }
        catch (OperationCanceledException)
        {
        }
    }

    private void ScheduleCardApplyAsync(string cardId)
    {
        if (!Dashboard.Document.FiltersChrome.IsAutoApply)
        {
            return;
        }

        _ = ApplyCardFiltersAsync(cardId);
    }

    private async Task ApplyFiltersAsync()
    {
        foreach (var filterName in Dashboard.Document.DashboardFilters)
        {
            var filter = Dashboard.FilterIndex[filterName];
            if (filter.Kind is FilterKind.Date &&
                _dateFrom.TryGetValue(filter.Name, out var from) &&
                _dateTo.TryGetValue(filter.Name, out var to))
            {
                Dashboard.ApplyDateFilter(filter.Name, from, to);
            }
            else if (filter.Kind is FilterKind.Field &&
                     _selectedFields.TryGetValue(filter.Name, out var selected))
            {
                Dashboard.ApplyFieldFilter(filter.Name, selected);
            }
        }

        await RefreshCardsAsync();
    }

    private async Task ApplyCardFiltersAsync(string cardId)
    {
        var card = Dashboard.Document.Cards.Single(c =>
            string.Equals(c.Id, cardId, StringComparison.OrdinalIgnoreCase));

        foreach (var filterName in card.LocalFilters)
        {
            var filter = Dashboard.FilterIndex[filterName];
            if (filter.Kind is FilterKind.Date &&
                _dateFrom.TryGetValue(filter.Name, out var from) &&
                _dateTo.TryGetValue(filter.Name, out var to))
            {
                Dashboard.ApplyDateFilter(filter.Name, from, to);
            }
            else if (filter.Kind is FilterKind.Field &&
                     _selectedFields.TryGetValue(filter.Name, out var selected))
            {
                Dashboard.ApplyFieldFilter(filter.Name, selected);
            }
            else if (filter.Kind is FilterKind.Top &&
                     _topLimits.TryGetValue(filter.Name, out var topLimit))
            {
                Dashboard.ApplyTopFilter(filter.Name, TopLimitDefaults.Resolve(filter, topLimit));
            }
        }

        var index = Dashboard.Document.Cards
            .Select((definition, i) => (definition, i))
            .Single(x => string.Equals(x.definition.Id, cardId, StringComparison.OrdinalIgnoreCase))
            .i;

        try
        {
            var result = await Dashboard.RenderCardAsync(card);
            _cards[index] = result;
        }
        catch (Exception ex)
        {
            _cards[index] = _cards[index] with { Error = ex.Message, Loading = false };
        }

        StateHasChanged();
    }

    private IEnumerable<string> PlacedFilterNames() =>
        Dashboard.Document.DashboardFilters
            .Concat(Dashboard.Document.Cards.SelectMany(c => c.LocalFilters))
            .Distinct(StringComparer.OrdinalIgnoreCase);

    public void Dispose()
    {
        _dashboardApplyCts?.Cancel();
        _dashboardApplyCts?.Dispose();
    }

    private async Task RefreshCardsAsync()
    {
        _busy = true;
        _cards = Dashboard.Document.Cards
            .Select(card =>
            {
                var kind = DiagramKindRegistry.Resolve(card.Diagram.Kind);
                return new CardRenderResult(
                    card.Id,
                    card.Title,
                    card.Diagram.Kind,
                    kind.DataFamily,
                    Loading: true,
                    BoundFilters: card.BoundFilters,
                    LocalFilters: card.LocalFilters,
                    Placement: card.Placement,
                    ChartPresentation: kind.DataFamily is DiagramDataFamily.Chart
                        ? CardChromeResolver.ResolveChartPresentation(card, Dashboard.SpecLibrary)
                        : null,
                    MatrixPresentation: kind.DataFamily is DiagramDataFamily.Matrix
                        ? MatrixPresentation.FromCard(card, Dashboard.SpecLibrary)
                        : null);
            })
            .ToList();
        StateHasChanged();

        var cardDefs = Dashboard.Document.Cards.ToList();
        var results = new CardRenderResult[cardDefs.Count];

        await Task.WhenAll(cardDefs.Select(async (card, index) =>
        {
            try
            {
                results[index] = await Dashboard.RenderCardAsync(card);
            }
            catch (Exception ex)
            {
                var kind = DiagramKindRegistry.Resolve(card.Diagram.Kind);
                results[index] = new CardRenderResult(
                    card.Id,
                    card.Title,
                    card.Diagram.Kind,
                    kind.DataFamily,
                    Error: ex.Message,
                    BoundFilters: card.BoundFilters,
                    LocalFilters: card.LocalFilters,
                    Placement: card.Placement,
                    ChartPresentation: kind.DataFamily is DiagramDataFamily.Chart
                        ? CardChromeResolver.ResolveChartPresentation(card, Dashboard.SpecLibrary)
                        : null,
                    MatrixPresentation: kind.DataFamily is DiagramDataFamily.Matrix
                        ? MatrixPresentation.FromCard(card, Dashboard.SpecLibrary)
                        : null);
            }
        }));

        await InvokeAsync(() =>
        {
            _cards = results.ToList();
            _busy = false;
            StateHasChanged();
        });
    }

    private static string ChartId(string title) =>
        "chart-" + Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(System.Text.Encoding.UTF8.GetBytes(title)))[..12];

    private string CardsGridStyle()
    {
        var layout = Dashboard.Document.Layout;
        return $"--grid-columns:{layout.Columns};--grid-gap:{layout.GapPx}px;";
    }

    private string CardPlacementStyle(CardRenderResult card)
    {
        var layout = Dashboard.Document.Layout;
        var placement = ResolvePlacement(card);
        var span = Math.Min(placement.Span, layout.Columns);
        return placement.Row > 0
            ? $"grid-column:{placement.Col} / span {span};grid-row:{placement.Row};"
            : $"grid-column:span {span};";
    }

    private PlacementDefinition ResolvePlacement(CardRenderResult card)
    {
        if (_tabPlacements.TryGetValue(card.Id, out var compact))
        {
            return compact;
        }

        return card.Placement ?? DefaultPlacement(card.DataFamily, Dashboard.Document.Layout.Columns);
    }

    private static string ChartHeightStyle(CardRenderResult card) =>
        $"height:{card.ChartPresentation?.HeightPx ?? 280}px;";

    private static PlacementDefinition DefaultPlacement(DiagramDataFamily family, int columns) =>
        family is DiagramDataFamily.Table or DiagramDataFamily.Matrix
            ? new PlacementDefinition(Row: 1, Col: 1, Span: columns)
            : new PlacementDefinition(Span: columns / 2);

    private string FilterDisplayLabel(FilterDefinition filter) =>
        !string.IsNullOrWhiteSpace(filter.Label)
            ? filter.Label
            : filter.Name.Replace('_', ' ');

    private string FilterScopeHint(string filterName)
    {
        if (!_filtersToCards.TryGetValue(filterName, out var cards) || cards.Count == 0)
        {
            return "ни одна карточка";
        }

        return string.Join(", ", cards);
    }

    private string FormatActiveFilterChip(string filterName)
    {
        var filter = Dashboard.FilterIndex.GetValueOrDefault(filterName);
        if (filter is null)
        {
            return filterName;
        }

        var label = FilterDisplayLabel(filter);
        if (filter.Kind is FilterKind.Date &&
            _dateFrom.TryGetValue(filterName, out var from) &&
            _dateTo.TryGetValue(filterName, out var to))
        {
            return $"{label}: {from:yyyy-MM-dd}…{to:yyyy-MM-dd}";
        }

        if (filter.Kind is FilterKind.Field &&
            _selectedFields.TryGetValue(filterName, out var selected))
        {
            return selected.Count == 0
                ? $"{label}: все"
                : $"{label}: {string.Join(", ", selected.Take(3))}{(selected.Count > 3 ? $" +{selected.Count - 3}" : "")}";
        }

        return label;
    }

    private static double PayloadMin(CardRenderResult card) => card.Matrix?.Min ?? 0;

    private static double PayloadMax(CardRenderResult card) => card.Matrix?.Max ?? 0;
}
