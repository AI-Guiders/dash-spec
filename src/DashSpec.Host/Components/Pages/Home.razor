@implements IDisposable
@page "/"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using DashSpec.Host.Components.Dashboard
@using DashSpec.Host.Services.Presentation

<PageTitle>@(_loaded ? Dashboard.Document.Title : "DashSpec")</PageTitle>

<DashboardToolbar Busy="_switching"
                  SpecSource="_loadedSpecSource"
                  OnUpload="OnSpecUploadedAsync" />

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert" role="alert">
        <strong>Не удалось загрузить dashboard</strong>
        <p>@_error</p>
    </div>
}
else if (!_loaded)
{
    <div class="page-loading">
        <div class="spinner" aria-hidden="true"></div>
        <span>Загрузка спецификации…</span>
    </div>
}
else
{
    <header class="dash-header">
        <div>
            <h1>@Dashboard.Document.Title</h1>
            <p class="muted dash-meta">
                <span class="badge">@Dashboard.Document.Id</span>
                <span class="badge">@Dashboard.ActiveConnectorId</span>
            </p>
        </div>
    </header>

  var chrome = Dashboard.Document.FiltersChrome;

    <DashboardTabBar Tabs="Dashboard.Document.Tabs"
                     ActiveTabId="_activeTabId"
                     Sticky="chrome.IsSticky"
                     OnSelect="SelectTab" />

    <DashboardFiltersSection FilterNames="Dashboard.Document.DashboardFilters"
                             FilterIndex="Dashboard.FilterIndex"
                             FiltersToCards="_filtersToCards"
                             DateFrom="_dateFrom"
                             DateTo="_dateTo"
                             SelectedFields="_selectedFields"
                             GetFieldOptions="Dashboard.GetFieldOptions"
                             BarLayout="chrome.IsBarLayout"
                             AutoApply="chrome.IsAutoApply"
                             Busy="_busy"
                             SectionClass="@FiltersSectionClass()"
                             GridClass="@FiltersGridClass()"
                             OnApply="ApplyFiltersAsync"
                             OnScheduleApply="ScheduleDashboardApplyAsync"
                             OnDayChanged="OnDashboardDayChanged"
                             OnFieldChanged="OnDashboardFieldChanged" />

    <section class="cards" style="@DashboardLayoutHelper.CardsGridStyle(Dashboard.Document.Layout)" aria-live="polite">
        @foreach (var card in VisibleCards())
        {
            <DashboardCardView Card="card"
                               PlacementStyle="@DashboardLayoutHelper.CardPlacementStyle(card, Dashboard.Document.Layout, _tabPlacements)"
                               DashboardBoundFilters="DashboardBoundForCard(card)"
                               FilterIndex="Dashboard.FilterIndex"
                               DateFrom="_dateFrom"
                               DateTo="_dateTo"
                               SelectedFields="_selectedFields"
                               TopLimits="_topLimits"
                               GetFieldOptions="Dashboard.GetFieldOptions"
                               AutoApply="chrome.IsAutoApply"
                               OnApplyCard="ApplyCardFiltersAsync"
                               OnScheduleCardApply="ScheduleCardApplyAsync"
                               OnCardDayChanged="OnCardDayChanged"
                               OnCardFieldChanged="OnCardFieldChanged" />
        }
    </section>
}
