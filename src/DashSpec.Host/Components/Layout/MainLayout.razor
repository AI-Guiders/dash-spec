@inherits LayoutComponentBase
@using DashSpec.Host.Configuration
@inject DashSpecTomlRoot Bootstrap

@code {
    private string Scheme => Bootstrap.Presentation.ColorScheme is "light" or "contrast"
        ? "scheme-" + Bootstrap.Presentation.ColorScheme
        : string.Empty;
}

<div class="page @Scheme">
    <header class="topbar">
        <div>
            <strong>DashSpec</strong>
            <span class="muted">DashSpec</span>
        </div>
        <TopbarNav />
    </header>
    <HostCommandBar />
    <main class="content">
        @Body
    </main>
</div>
