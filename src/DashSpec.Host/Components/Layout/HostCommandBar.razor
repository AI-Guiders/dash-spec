@using DashSpec.Host.Commands
@using DashSpec.Host.Components.Dashboard
@using DashSpec.Host.Services.Presentation
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject DashboardHostCommandCoordinator Coordinator
@inject IJSRuntime Js
@implements IAsyncDisposable

<div class="dash-host-command-shell">
    <DashboardFilterCommandBar @ref="_bar"
                               CommandContext="@Coordinator.BuildContext()"
                               CommandError="@Coordinator.CommandError"
                               OnCommit="Coordinator.CommitAsync" />
</div>

@code {
    DashboardFilterCommandBar? _bar;
    DotNetObjectReference<HostCommandBar>? _selfRef;
    bool _bindingsBound;

    protected override void OnInitialized() => Coordinator.Changed += OnCoordinatorChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_bindingsBound)
        {
            return;
        }

        _bindingsBound = true;
        _selfRef = DotNetObjectReference.Create(this);
        var bindings = DashboardCatalogBindings.HostBindings()
            .Select(binding => new { gesture = binding.Gesture, methodName = binding.MethodName })
            .ToArray();
        await Js.InvokeVoidAsync("aiguidersInput.keyboard.bindHostBindings", _selfRef, bindings);
    }

    void OnCoordinatorChanged() => _ = InvokeAsync(StateHasChanged);

    [JSInvokable]
    public void OnChordRoot() => _bar?.OpenPaletteFromHost();

    [JSInvokable]
    public void OnSuggestDismiss() => _bar?.DismissSuggestionsFromHost();

    public async ValueTask DisposeAsync()
    {
        Coordinator.Changed -= OnCoordinatorChanged;
        if (_bindingsBound)
        {
            await Js.InvokeVoidAsync("aiguidersInput.keyboard.unbindHostBindings");
        }

        _selfRef?.Dispose();
    }
}
