@using DashSpec.Host.Components.Dashboard
@using DashSpec.Host.Services.Presentation
@inject IWebHostEnvironment Environment
@inject DashboardHostCommandCoordinator Coordinator
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@implements IDisposable

<nav class="topbar-nav">
    @if (Coordinator.HasCatalog)
    {
        <DashboardCatalogPicker Entries="Coordinator.CatalogEntries"
                                Groups="Coordinator.CatalogGroups"
                                ActiveEntryId="Coordinator.ActiveCatalogEntryId"
                                Busy="Coordinator.CatalogBusy"
                                OnSelect="Coordinator.SelectCatalogEntryAsync"
                                Inline="true"
                                ShowLabel="true" />
    }
    <a href="/">Dashboard</a>
    <a href="/admin/access">Control Center</a>
    @if (Environment.IsDevelopment())
    {
        <a href="/dev/spec">Spec</a>
    }
</nav>

@code {
    protected override void OnInitialized() => Coordinator.Changed += OnCoordinatorChanged;

    void OnCoordinatorChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Coordinator.Changed -= OnCoordinatorChanged;
}
