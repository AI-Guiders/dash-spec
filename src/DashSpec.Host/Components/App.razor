@inject DashSpec.Abstractions.Viz.IRenderStackSettings RenderStackSettings
@inject DashSpec.Abstractions.Viewer.IViewerPresentationOptions Bootstrap
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
<!DOCTYPE html>
<html lang="ru">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <title>DashSpec</title>
    @* ADR-0112 render stacks: the host links nothing itself — the active stack mounts
       its own head component dynamically, and plugins mount their own assets. *@
    @if (RenderStackSettings.HeadComponent is { } headType)
    {
        <DynamicComponent Type="headType"
                          Parameters="@(new Dictionary<string, object?> { ["Theme"] = ViewerTheme })" />
    }
    <FilterBuiltinsHead />
    <VizBuiltinsHead />
    <EChartsHead />
    <HeadOutlet />
</head>

<body>
    <Routes />
    @if (RenderStackSettings.ScriptsComponent is { } scriptsType)
    {
        <DynamicComponent Type="scriptsType" />
    }
    <FilterBuiltinsScripts />
    <VizBuiltinsScripts />
    <EChartsScripts />
    <script src="/js/aiguiders-input.js?v=4"></script>
    <script src="/js/dashspec-theme.js?v=1"></script>
    <script src="js/dashspec-download.js?v=2"></script>
    <script src="_framework/blazor.web.js"></script>
</body>

</html>

@code {
    /// <summary>Viewer override wins (cookie, set by the shell picker), else the live
    /// host default from admin. The root renders per request, so the cookie is read
    /// server-side on every load — no flash, no restart.</summary>
    private string ViewerTheme
    {
        get
        {
            var cookie = HttpContextAccessor?.HttpContext?.Request.Cookies[DashSpec.Abstractions.Viz.IRenderStackSettings.ViewerCookieName];
            return !string.IsNullOrWhiteSpace(cookie)
                && RenderStackSettings.Themes.Any(t => string.Equals(t.Token, cookie.Trim(), StringComparison.OrdinalIgnoreCase))
                ? cookie.Trim()
                : Bootstrap.ColorScheme;
        }
    }
}
