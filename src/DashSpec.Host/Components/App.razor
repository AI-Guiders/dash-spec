@inject DashSpec.Abstractions.Viz.IRenderStackSettings RenderStackSettings
@inject DashSpec.Abstractions.Viewer.IViewerPresentationOptions Bootstrap
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
<!DOCTYPE html>
<html lang="ru">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <title>DashSpec</title>
    @* ADR-0112 render stacks: the host links nothing itself — stacks and
       plugins mount their own assets, and the chosen stack mounts ONLY its
       own (§4/§5: the stack is the surface's visual language; no other
       stack's css loads beside it). Plugin css is mounted by the plugins
       themselves (ADR-0059/0060); flatpickr rides the Filter.Builtins head.
       The Radzen stack mounts only when it is the chosen stack (render =
       radzen); its theme reads the color_scheme token — its own reading. *@
    @if (IsRadzenStack)
    {
        <RadzenVizHead />
        @* The theme token is read LIVE (IViewerPresentationOptions): the admin save
           lands in WitDB immediately, the next page load re-renders this head — no
           host restart. The stack choice itself stays startup-frozen (RenderStackSettings). *@
        <RadzenStackHead Theme="@ViewerTheme" />
    }
    else
    {
        <SelfMadeStackHead />
    }
    <FilterBuiltinsHead />
    <VizBuiltinsHead />
    <EChartsHead />
    <HeadOutlet />
</head>

<body>
    <Routes />
    @if (IsRadzenStack)
    {
        <RadzenStackScripts />
        <RadzenVizScripts />
    }
    else
    {
        <SelfMadeStackScripts />
    }
    <FilterBuiltinsScripts />
    <VizBuiltinsScripts />
    <EChartsScripts />
    <script src="/js/aiguiders-input.js?v=4"></script>
    <script src="/js/dashspec-theme.js?v=1"></script>
    <script src="js/dashspec-download.js?v=2"></script>
    <script src="_framework/blazor.web.js"></script>
</body>

</html>

@code {
    // ADR-0112: the Radzen stack mounts itself only when chosen (render = radzen);
    // selfmade is the default — the surface looks exactly as it did before Radzen.
    private bool IsRadzenStack =>
        string.Equals(RenderStackSettings?.HostStack?.Trim(), "radzen", StringComparison.OrdinalIgnoreCase);

    /// <summary>Viewer override wins (cookie, set by the shell picker), else the live
    /// host default from admin. The root renders per request, so the cookie is read
    /// server-side on every load — no flash, no restart.</summary>
    private string ViewerTheme
    {
        get
        {
            var cookie = HttpContextAccessor?.HttpContext?.Request.Cookies[DashSpec.Stack.Radzen.RadzenColorSchemes.ViewerCookieName];
            // Find(null/empty) returns the default theme, not null — gate on the
            // cookie actually being present and known before using it.
            return !string.IsNullOrWhiteSpace(cookie)
                && DashSpec.Stack.Radzen.RadzenColorSchemes.Find(cookie) is not null
                ? cookie.Trim()
                : Bootstrap.ColorScheme;
        }
    }
}
