@namespace DashSpec.Host.Components.Dashboard
@using DashSpec.Host.Commands
@inject DashboardFilterCommandService CommandService

@if (ChildContent is not null)
{
    @ChildContent(_highlights)
}

@code {
    [Parameter] public DashboardFilterContext CommandContext { get; set; } = default!;
    [Parameter] public RenderFragment<CommandHighlightState>? ChildContent { get; set; }

    string _tail = "";
    CommandHighlightState _highlights = CommandHighlightState.Empty;

    protected override void OnParametersSet()
    {
        _highlights = CommandService.ResolveHighlights(_tail, CommandContext);
    }

    public Task NotifyTailChangedAsync(string tail)
    {
        _tail = tail ?? "";
        var next = CommandService.ResolveHighlights(_tail, CommandContext);
        if (HighlightEquals(_highlights, next))
        {
            return Task.CompletedTask;
        }

        _highlights = next;
        return InvokeAsync(StateHasChanged);
    }

    static bool HighlightEquals(CommandHighlightState left, CommandHighlightState right) =>
        left.FilterNames.SetEquals(right.FilterNames)
        && left.CardIds.SetEquals(right.CardIds);
}
