@namespace DashSpec.Host.Components.Dashboard
@using AIGuiders.Platform.CommandPlane
@inject DashSpec.Host.Commands.DashboardFilterCommandService CommandService

<div class="dash-filter-command-bar">
    <label class="dash-filter-command-label" for="dash-filter-command-input">/select</label>
    <button type="button"
            class="dash-filter-command-palette-trigger"
            title="Command palette (Ctrl+K)"
            @onclick="OpenPalette">
        Ctrl+K
    </button>
    <input id="dash-filter-command-input"
           class="dash-filter-command-input"
           placeholder="@_guidance.Placeholder"
           @bind="Line"
           @bind:event="oninput"
           @onkeydown="OnKeyDown" />
    <DashboardSlashGuidance Guidance="_guidance" />
    @if (_suggestions.Count > 0)
    {
        <ul class="dash-filter-command-suggestions" role="listbox">
            @for (var i = 0; i < _suggestions.Count; i++)
            {
                var item = _suggestions[i];
                var index = i;
                <li role="option"
                    class="dash-filter-command-item @(index == _selected ? "active" : null)"
                    @onclick="() => Accept(item)">
                    <span class="path">@item.InsertText.TrimEnd()</span>
                    <span class="help">@item.Help</span>
                </li>
            }
        </ul>
    }
</div>

<DashboardCommandPalette Visible="_paletteOpen"
                         ToolbarFilterNames="ToolbarFilterNames"
                         OnClose="ClosePalette"
                         OnCommit="OnCommit" />

@code {
    [Parameter] public IReadOnlyList<string> ToolbarFilterNames { get; set; } = [];
    [Parameter] public EventCallback<string> OnCommit { get; set; }
    [Parameter] public EventCallback OpenPaletteRequested { get; set; }

    string _line = "/";
    int _selected;
    bool _paletteOpen;
    IReadOnlyList<SlashCompletionItem> _suggestions = [];
    SlashInputGuidance _guidance = new(SlashInputMode.Path, "/", "Type a command path", "Start typing — Tab completes the next segment");

    string Line
    {
        get => _line;
        set
        {
            _line = value.StartsWith('/') ? value : "/" + value;
            RefreshSuggestions();
        }
    }

    public void OpenPaletteFromHost()
    {
        _paletteOpen = true;
    }

    void OpenPalette() => _paletteOpen = true;

    void ClosePalette() => _paletteOpen = false;

    void RefreshSuggestions()
    {
        var body = _line.Length <= 1 ? "" : _line[1..];
        var result = CommandService.GetCompletionResult(body, ToolbarFilterNames);
        _suggestions = result.Items;
        _guidance = result.Guidance;
        _selected = Math.Clamp(_selected, 0, Math.Max(0, _suggestions.Count - 1));
    }

    async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.CtrlKey && string.Equals(e.Key, "k", StringComparison.OrdinalIgnoreCase))
        {
            _paletteOpen = true;
            return;
        }

        if (e.Key == "ArrowDown" && _suggestions.Count > 0)
        {
            _selected = (_selected + 1) % _suggestions.Count;
            return;
        }

        if (e.Key == "ArrowUp" && _suggestions.Count > 0)
        {
            _selected = (_selected - 1 + _suggestions.Count) % _suggestions.Count;
            return;
        }

        if (e.Key == "Tab" && _suggestions.Count > 0)
        {
            Accept(_suggestions[_selected]);
            return;
        }

        if (e.Key == "Enter")
        {
            await OnCommit.InvokeAsync(_line.Trim());
        }
    }

    void Accept(SlashCompletionItem item)
    {
        _line = item.InsertText.TrimEnd();
        if (item.InsertText.EndsWith(' '))
        {
            _line += " ";
        }

        RefreshSuggestions();
    }
}
