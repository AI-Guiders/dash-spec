@namespace DashSpec.Host.Components.Dashboard
@using AIGuiders.Platform.IntermediateRepresentation.Invocation
@using AIGuiders.Platform.CommandPlane
@using DashSpec.Host.Commands
@using DashSpec.Host.Commands.Constructors
@inject DashboardFilterCommandService CommandService
@inject DashboardCommandSession CommandSession
@inject DashboardSlashConstructorHost ConstructorHost
@inject IJSRuntime Js
@implements IAsyncDisposable

<div class="dash-filter-command-bar">
    <button type="button"
            class="dash-filter-command-palette-trigger"
            title="Command palette (Ctrl+K)"
            @onclick="OpenPalette">
        Ctrl+K
    </button>
    <div class="dash-filter-command-editor">
        @if (_trail.Count > 0)
        {
            <div class="dash-filter-command-trail" aria-label="Command path">
                @foreach (var segment in _trail)
                {
                    <span class="dash-command-trail-segment">@segment.Label</span>
                }
            </div>
        }
        <form class="dash-filter-command-input-wrap"
              autocomplete="off"
              @onsubmit:preventDefault="true">
            <span class="dash-filter-command-prompt" aria-hidden="true">@DashboardFilterCommandDisplay.VisiblePrefix</span>
            <input type="text"
                   @ref="_inputRef"
                   id="dash-filter-command-input"
                   class="dash-filter-command-input"
                   placeholder="@InputPlaceholder"
                   aria-label="Filter command line"
                   role="combobox"
                   aria-autocomplete="list"
                   aria-haspopup="listbox"
                   aria-expanded="@(_focused && !_suggestionsDismissed && _suggestions.Count > 0)"
                   aria-controls="dash-filter-command-suggestions"
                   autocomplete="off"
                   autocapitalize="off"
                   autocorrect="off"
                   spellcheck="false"
                   data-command-line-suggest="@SuggestActive"
                   data-ccl-suggest="@SuggestActive"
                   @bind="Line"
                   @bind:event="oninput"
                   @onfocus="OnFocus"
                   @onblur="OnBlur"
                   @onkeydown="OnKeyDown" />
        </form>
    </div>
    @if (!string.IsNullOrEmpty(_validationError))
    {
        <div class="dash-command-error" role="alert">@_validationError</div>
    }
    @if (_focused)
    {
        <DashboardSlashGuidance Guidance="_guidance" />
    }
    @if (_focused && !_suggestionsDismissed && _suggestions.Count > 0)
    {
        <DashboardCommandSuggestionList Id="dash-filter-command-suggestions"
                                        CssClass="dash-filter-command-suggestions"
                                        AriaLabel="Filter commands"
                                        Items="_suggestions"
                                        CommandContext="CommandContext"
                                        TypedLine="_line"
                                        SelectedIndex="_selected"
                                        OnSelect="Accept" />
    }
</div>

<DashboardCommandPalette @ref="_palette"
                         Visible="_paletteOpen"
                         CommandContext="CommandContext"
                         OnClose="ClosePalette"
                         OnCommit="OnCommit" />

@code {
    [Parameter] public DashboardFilterContext CommandContext { get; set; } = default!;
    [Parameter] public string? CommandError { get; set; }
    [Parameter] public EventCallback<string> OnCommit { get; set; }

    DashboardCommandPalette? _palette;
    ElementReference _inputRef;
    bool _inputBound;
    string _line = "";
    int _selected;
    bool _paletteOpen;
    bool _focused;
    bool _suggestionsDismissed;
    CancellationTokenSource? _blurDelayCts;
    string? _validationError;
    IReadOnlyList<ArgCompletionItem> _suggestions = [];
    IReadOnlyList<CommandTrailSegment> _trail = [];
    SlashInputGuidance _guidance = new(
        "команда",
        DashboardFilterCommandDisplay.EmptyPlaceholder,
        "Начните ввод — Tab или Ctrl+Space дополняет сегмент",
        InvocationLinePhase.Path);

    string SuggestActive => _focused && !_suggestionsDismissed && _suggestions.Count > 0 ? "true" : "false";

    string InputPlaceholder =>
        string.IsNullOrWhiteSpace(_guidance.Placeholder)
            ? DashboardFilterCommandDisplay.EmptyPlaceholder
            : _guidance.Placeholder;

    string Line
    {
        get => _line;
        set
        {
            var next = DashboardFilterSlashCompletion.ToInputTail(value);
            if (_line != next)
            {
                var catalog = CommandService.BuildCatalog(CommandContext);
                if (DashboardFilterSlashCompletion.HasCommandPathChanged(catalog, _line, next))
                {
                    DashboardFilterCommandAcceptance.CancelConstructorIfActive(ConstructorHost);
                }
                else if (ConstructorHost.Session.IsActive
                         && DashboardFilterSlashCompletion.TrySplitPathAndArg(catalog, next, out _, out var argTail))
                {
                    ConstructorHost.Session.SetTypedArgTail(argTail);
                }
            }

            _line = next;
            _validationError = null;
            _suggestionsDismissed = false;
            RefreshSuggestions();
        }
    }

    DashboardFilterContext? _lastCommandContext;

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(_lastCommandContext, CommandContext))
        {
            _lastCommandContext = CommandContext;
            RefreshSuggestions();
        }
        else if (_focused)
        {
            RefreshSuggestions();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_inputBound)
        {
            _inputBound = true;
            await Js.InvokeVoidAsync("aiguidersInput.surfaces.commandLine.bindInput", _inputRef);
        }
    }

    public void OpenPaletteFromHost()
    {
        _paletteOpen = true;
        _ = InvokeAsync(StateHasChanged);
    }

    public void DismissSuggestionsFromHost()
    {
        if (!_focused)
        {
            return;
        }

        ApplySuggestDismiss();
        _ = InvokeAsync(StateHasChanged);
    }

    void OpenPalette() => _paletteOpen = true;

    void ClosePalette() => _paletteOpen = false;

    void OnBlur()
    {
        CancelBlurDelay();
        _blurDelayCts = new CancellationTokenSource();
        _ = CompleteBlurAfterDelayAsync(_blurDelayCts.Token);
    }

    void OnFocus()
    {
        CancelBlurDelay();
        _focused = true;
        _suggestionsDismissed = false;
        _validationError = null;
        CommandSession.SetBarActive(true, CommandContext);
        RefreshSuggestions();
    }

    void CancelBlurDelay()
    {
        _blurDelayCts?.Cancel();
        _blurDelayCts?.Dispose();
        _blurDelayCts = null;
    }

    async Task CompleteBlurAfterDelayAsync(CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(120, cancellationToken);
            _focused = false;
            CommandSession.SetBarActive(false, CommandContext);
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException)
        {
        }
    }

    void RefreshSuggestions()
    {
        var result = CommandService.GetCompletionResult(_line, CommandContext);
        _suggestions = result.Items;
        _guidance = result.Guidance;
        _trail = DashboardCommandTrailFormatter.Format(_line, CommandContext);
        _selected = Math.Clamp(_selected, 0, Math.Max(0, _suggestions.Count - 1));
        CommandSession.SetDraftTail(_line, CommandContext);
    }

    async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (DashboardCatalogBindings.MatchesGesture(e, DashboardCatalogBindings.ChordRootGesture))
        {
            _paletteOpen = true;
            return;
        }

        if (DashboardCatalogBindings.MatchesGesture(e, DashboardCatalogBindings.SuggestDismissGesture))
        {
            ApplySuggestDismiss();
            return;
        }

        if (e.Key == "Escape")
        {
            if (ConstructorHost.Session.IsActive)
            {
                ConstructorHost.Session.Cancel();
                RefreshSuggestions();
                return;
            }

            if (!_focused)
            {
                return;
            }

            CancelBlurDelay();
            _focused = false;
            _suggestionsDismissed = false;
            CommandSession.SetBarActive(false, CommandContext);
            return;
        }

        if (e.Key == "ArrowDown")
        {
            if (_suggestions.Count == 0)
            {
                RefreshSuggestions();
            }

            if (_suggestions.Count > 0)
            {
                _selected = (_selected + 1) % _suggestions.Count;
            }

            return;
        }

        if (e.Key == "ArrowUp" && _suggestions.Count > 0)
        {
            _selected = (_selected - 1 + _suggestions.Count) % _suggestions.Count;
            return;
        }

        if (DashboardFilterCommandKeys.IsAcceptCompletion(e))
        {
            if (_suggestions.Count == 0)
            {
                RefreshSuggestions();
            }

            if (_suggestions.Count > 0)
            {
                Accept(_suggestions[_selected]);
            }

            return;
        }

        if (e.Key == "Enter")
        {
            if (ConstructorHost.Session.IsActive)
            {
                if (ConstructorHost.Session.TryComplete(out var wire)
                    && DashboardFilterSlashCompletion.TryResolveCommandPath(
                        CommandService.BuildCatalog(CommandContext),
                        _line,
                        out var path))
                {
                    _line = $"{path} {wire}";
                    RefreshSuggestions();
                }

                return;
            }

            if (_guidance.Phase == InvocationLinePhase.Ready
                && !string.IsNullOrWhiteSpace(_guidance.ReadyWire)
                && DashboardFilterSlashCompletion.TryResolveCommandPath(
                    CommandService.BuildCatalog(CommandContext),
                    _line,
                    out var readyPath))
            {
                var readyLine = DashboardFilterSlashCompletion.ToCommandLine($"{readyPath} {_guidance.ReadyWire}");
                if (CommandService.TryValidateRunnable(readyLine, CommandContext, out _))
                {
                    _validationError = null;
                    await OnCommit.InvokeAsync(readyLine);
                    _line = "";
                    _selected = 0;
                    CommandSession.ClearDraft(CommandContext);
                    RefreshSuggestions();
                }

                return;
            }

            var line = DashboardFilterSlashCompletion.ToCommandLine(_line);
            if (DashboardFilterSlashCompletion.IsIncompleteRoot(_line))
            {
                return;
            }

            if (!CommandService.TryValidateRunnable(line, CommandContext, out var error))
            {
                _validationError = error;
                return;
            }

            _validationError = null;
            await OnCommit.InvokeAsync(line);
            _line = "";
            _selected = 0;
            CommandSession.ClearDraft(CommandContext);
            RefreshSuggestions();
        }
    }

    void Accept(ArgCompletionItem item)
    {
        CancelBlurDelay();
        if (DashboardFilterCommandAcceptance.TryAcceptItem(
                item,
                CommandService,
                CommandContext,
                ConstructorHost,
                ref _line))
        {
            _selected = 0;
            RefreshSuggestions();
        }
    }

    void ApplySuggestDismiss()
    {
        if (ConstructorHost.Session.IsActive)
        {
            ConstructorHost.Session.Cancel();
            RefreshSuggestions();
            return;
        }

        if (!_suggestionsDismissed && _suggestions.Count > 0)
        {
            _suggestionsDismissed = true;
            _selected = 0;
            return;
        }

        if (!string.IsNullOrWhiteSpace(_line))
        {
            _line = "";
            _selected = 0;
            _validationError = null;
            _suggestionsDismissed = true;
            CommandSession.ClearDraft(CommandContext);
            RefreshSuggestions();
        }
    }

    public ValueTask DisposeAsync()
    {
        CancelBlurDelay();
        return ValueTask.CompletedTask;
    }
}
