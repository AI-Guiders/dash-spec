@namespace DashSpec.Host.Components.Dashboard
@using AIGuiders.Platform.CommandPlane
@using DashSpec.Host.Commands
@inject DashSpec.Host.Commands.DashboardFilterCommandService CommandService

<div class="dash-filter-command-bar">
    <button type="button"
            class="dash-filter-command-palette-trigger"
            title="Command palette (Ctrl+K)"
            @onclick="OpenPalette">
        Ctrl+K
    </button>
    <div class="dash-filter-command-input-wrap">
        <span class="dash-filter-command-prompt" aria-hidden="true">@DashboardFilterCommandDisplay.Prompt</span>
        <input id="dash-filter-command-input"
               class="dash-filter-command-input"
               placeholder="@InputPlaceholder"
               aria-label="Filter command line"
               aria-expanded="@(_focused && _suggestions.Count > 0)"
               aria-controls="dash-filter-command-suggestions"
               @bind="Line"
               @bind:event="oninput"
               @onfocus="OnFocus"
               @onblur="OnBlur"
               @onkeydown="OnKeyDown" />
    </div>
    @if (!string.IsNullOrEmpty(_validationError))
    {
        <div class="dash-command-error" role="alert">@_validationError</div>
    }
    @if (_focused)
    {
        <DashboardSlashGuidance Guidance="_guidance" />
    }
    @if (_focused && _suggestions.Count > 0)
    {
        <ul id="dash-filter-command-suggestions"
            class="dash-filter-command-suggestions"
            role="listbox"
            aria-label="Filter commands"
            @onmousedown:preventDefault="true">
            @for (var i = 0; i < _suggestions.Count; i++)
            {
                var item = _suggestions[i];
                var index = i;
                <li role="option"
                    aria-selected="@(index == _selected)"
                    class="dash-filter-command-item @(index == _selected ? "active" : null)"
                    @onclick="() => Accept(item)">
                    <span class="path">@DashboardFilterCommandDisplay.FormatSuggestion(item)</span>
                    <span class="help">@item.Help</span>
                </li>
            }
        </ul>
    }
</div>

<DashboardCommandPalette @ref="_palette"
                         Visible="_paletteOpen"
                         ToolbarFilterNames="ToolbarFilterNames"
                         OnClose="ClosePalette"
                         OnCommit="OnCommit" />

@code {
    [Parameter] public IReadOnlyList<string> ToolbarFilterNames { get; set; } = [];
    [Parameter] public string? CommandError { get; set; }
    [Parameter] public EventCallback<string> OnCommit { get; set; }

    DashboardCommandPalette? _palette;
    string _line = "";
    int _selected;
    bool _paletteOpen;
    bool _focused;
    string? _validationError;
    IReadOnlyList<SlashCompletionItem> _suggestions = [];
    SlashInputGuidance _guidance = new(
        SlashInputMode.Path,
        DashboardFilterCommandDisplay.RootVerb,
        "Tab — выбрать фильтр",
        DashboardFilterCommandDisplay.EmptyPlaceholder);

    string InputPlaceholder =>
        string.IsNullOrWhiteSpace(_guidance.Placeholder)
            ? DashboardFilterCommandDisplay.EmptyPlaceholder
            : _guidance.Placeholder;

    string Line
    {
        get => _line;
        set
        {
            _line = DashboardFilterSlashCompletion.SanitizeLine(value);
            _validationError = null;
            RefreshSuggestions();
        }
    }

    protected override void OnParametersSet()
    {
        if (_focused)
        {
            RefreshSuggestions();
        }
    }

    public void OpenPaletteFromHost()
    {
        _paletteOpen = true;
    }

    void OpenPalette() => _paletteOpen = true;

    void ClosePalette() => _paletteOpen = false;

    void OnFocus()
    {
        _focused = true;
        _validationError = null;
        RefreshSuggestions();
    }

    void OnBlur() => _focused = false;

    void RefreshSuggestions()
    {
        var result = CommandService.GetCompletionResult(_line, ToolbarFilterNames);
        _suggestions = result.Items;
        _guidance = result.Guidance;
        _selected = Math.Clamp(_selected, 0, Math.Max(0, _suggestions.Count - 1));
    }

    async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.CtrlKey && string.Equals(e.Key, "k", StringComparison.OrdinalIgnoreCase))
        {
            _paletteOpen = true;
            return;
        }

        if (e.Key == "ArrowDown")
        {
            if (_suggestions.Count == 0)
            {
                RefreshSuggestions();
            }

            if (_suggestions.Count > 0)
            {
                _selected = (_selected + 1) % _suggestions.Count;
            }

            return;
        }

        if (e.Key == "ArrowUp" && _suggestions.Count > 0)
        {
            _selected = (_selected - 1 + _suggestions.Count) % _suggestions.Count;
            return;
        }

        if (e.Key == "Tab" && _suggestions.Count > 0)
        {
            Accept(_suggestions[_selected]);
            return;
        }

        if (e.Key == "Enter")
        {
            var line = DashboardFilterSlashCompletion.ToCommandLine(_line);
            if (line.Equals(DashboardFilterCommandDisplay.RootVerb, StringComparison.OrdinalIgnoreCase))
            {
                return;
            }

            if (!CommandService.TryValidateRunnable(line, ToolbarFilterNames, out var error))
            {
                _validationError = error;
                return;
            }

            _validationError = null;
            await OnCommit.InvokeAsync(line);
            _line = "";
            _focused = false;
        }
    }

    void Accept(SlashCompletionItem item)
    {
        _line = DashboardFilterSlashCompletion.LineFromInsert(item.InsertText);
        RefreshSuggestions();
    }
}
