@namespace DashSpec.Host.Components.Dashboard.Viz
@using DashSpec.Host.Services.Models

@if (Context.Card.Table is null || Context.Card.Table.Rows.Count == 0)
{
    <p class="empty-state">Нет строк</p>
}
else
{
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    @foreach (var column in Context.Card.Table.Columns)
                    {
                        <th>@column</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Context.Card.Table.Rows)
                {
                    <tr>
                        @foreach (var cell in row)
                        {
                            <td>@cell</td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p class="table-foot muted">Показано @Context.Card.Table.Rows.Count строк</p>
}

@code {
    [Parameter, EditorRequired] public CardVizRenderContext Context { get; set; } = default!;
}
