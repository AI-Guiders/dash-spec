@namespace DashSpec.Host.Components.Dashboard

@using DashSpec.Core.Model
@using DashSpec.Host.Services.Presentation



@if (Entries.Count > 1)

{

    <label class="dash-catalog @(Inline ? "dash-catalog-inline" : null)">

        @if (!Inline || ShowLabel)
        {
            <span class="filter-inline-label">@CatalogLabel</span>
        }

        <select class="dash-catalog-select"

                aria-label="Выбор отчёта"

                disabled="@Busy"

                value="@ResolvedEntryId"

                @onchange="OnChanged">

            @foreach (var group in Groups)

            {

                <optgroup label="@DisplayResolutionHost.ResolveCatalogGroupTitle(group)">

                    @foreach (var entry in Entries.Where(entry =>

                        string.Equals(entry.GroupId, group.Id, StringComparison.OrdinalIgnoreCase)))

                    {

                        <option value="@entry.Id">@DisplayResolutionHost.ResolveCatalogEntryTitle(entry)</option>

                    }

                </optgroup>

            }

            @foreach (var entry in Entries.Where(entry => string.IsNullOrWhiteSpace(entry.GroupId)))

            {

                <option value="@entry.Id">@DisplayResolutionHost.ResolveCatalogEntryTitle(entry)</option>

            }

        </select>

    </label>

}



@code {

    [Parameter] public IReadOnlyList<CatalogEntryDefinition> Entries { get; set; } = [];

    [Parameter] public IReadOnlyList<CatalogGroupDefinition> Groups { get; set; } = [];

    [Parameter] public string? ActiveEntryId { get; set; }

    private string ResolvedEntryId =>
        !string.IsNullOrWhiteSpace(ActiveEntryId)
        && Entries.Any(entry => string.Equals(entry.Id, ActiveEntryId, StringComparison.OrdinalIgnoreCase))
            ? ActiveEntryId
            : Entries[0].Id;

    [Parameter] public bool Busy { get; set; }

    [Parameter] public bool Inline { get; set; }

    [Parameter] public bool ShowLabel { get; set; }

    [Parameter] public string CatalogLabel { get; set; } = "Отчёт";

    [Parameter] public EventCallback<string> OnSelect { get; set; }



    private async Task OnChanged(ChangeEventArgs e)

    {

        var entryId = e.Value?.ToString();

        if (!string.IsNullOrWhiteSpace(entryId))

        {

            await OnSelect.InvokeAsync(entryId);

        }

    }

}


