@namespace DashSpec.Host.Components.Dashboard
@using DashSpec.Host.Services.Models
@using DashSpec.Host.Services.Presentation

<article class="card" style="@PlacementStyle">
    <div class="card-head">
        <div>
            <h2><RichTextView Text="@Card.Title" /></h2>
            @if (Card.LocalFilters is { Count: > 0 })
            {
                <div class="card-filters card-filters-local">
                    @foreach (var filterName in Card.LocalFilters)
                    {
                        var filter = FilterIndex[filterName];
                        if (filter.Kind is FilterKind.Date)
                        {
                            <div class="filter filter-date filter-compact">
                                <span class="filter-label">@FilterUiHelpers.DisplayLabel(filter)</span>
                                <div class="date-range @(filter.IsDayWidget ? "date-range-day" : null)">
                                    @if (filter.IsDayWidget)
                                    {
                                        <input type="date"
                                               aria-label="@FilterUiHelpers.DisplayLabel(filter)"
                                               @bind="DateFrom[filter.Name]"
                                               @bind:format="yyyy-MM-dd"
                                               @bind:after="() => OnCardDayChanged.InvokeAsync((Card.Id, filter.Name))" />
                                    }
                                    else
                                    {
                                        <input type="date"
                                               aria-label="@($"{filter.Name} from")"
                                               @bind="DateFrom[filter.Name]"
                                               @bind:format="yyyy-MM-dd"
                                               @bind:after="() => OnScheduleCardApply.InvokeAsync(Card.Id)" />
                                        <span class="date-sep">—</span>
                                        <input type="date"
                                               aria-label="@($"{filter.Name} to")"
                                               @bind="DateTo[filter.Name]"
                                               @bind:format="yyyy-MM-dd"
                                               @bind:after="() => OnScheduleCardApply.InvokeAsync(Card.Id)" />
                                    }
                                </div>
                            </div>
                        }
                        else if (filter.Kind is FilterKind.Field)
                        {
                            <FieldMultiSelect Label="@FilterUiHelpers.DisplayLabel(filter)"
                                              Combobox="@filter.IsComboboxWidget"
                                              NativeSelect="@filter.IsSelectWidget"
                                              SingleSelect="@filter.IsSingleSelectField"
                                              Options="GetFieldOptions(filter.Name)"
                                              Selected="SelectedFields[filter.Name]"
                                              SelectedChanged="values => OnCardFieldChanged.InvokeAsync((Card.Id, filter.Name, values))" />
                        }
                        else if (filter.Kind is FilterKind.Top)
                        {
                            <div class="filter filter-top filter-compact">
                                <span class="filter-label">@FilterUiHelpers.DisplayLabel(filter)</span>
                                <input type="number"
                                       class="filter-number"
                                       aria-label="@FilterUiHelpers.DisplayLabel(filter)"
                                       min="@(filter.MinValue ?? 1)"
                                       max="@(filter.MaxValue ?? TopLimitDefaults.DefaultMax)"
                                       @bind="TopLimits[filter.Name]"
                                       @bind:after="() => OnScheduleCardApply.InvokeAsync(Card.Id)" />
                            </div>
                        }
                    }
                    @if (!AutoApply)
                    {
                        <button class="secondary card-filter-apply"
                                disabled="@Card.Loading"
                                @onclick="() => OnApplyCard.InvokeAsync(Card.Id)">
                            Применить
                        </button>
                    }
                </div>
            }
            @if (DashboardBoundFilters.Count > 0)
            {
                <div class="card-filters">
                    @foreach (var filterName in DashboardBoundFilters)
                    {
                        <span class="scope-chip">@FilterUiHelpers.FormatActiveChip(filterName, FilterIndex, DateFrom, DateTo, SelectedFields)</span>
                    }
                </div>
            }
        </div>
        @if (Card.Loading)
        {
            <span class="card-status muted">загрузка…</span>
        }
        else if (!string.IsNullOrEmpty(Card.Error))
        {
            <span class="card-status card-status-error">ошибка</span>
        }
    </div>

    <CardVisualization Card="Card"
                       MatrixMin="@(Card.Matrix?.Min ?? 0)"
                       MatrixMax="@(Card.Matrix?.Max ?? 0)" />
</article>

@code {
    [Parameter, EditorRequired] public CardRenderResult Card { get; set; } = default!;
    [Parameter] public string PlacementStyle { get; set; } = string.Empty;
    [Parameter] public IReadOnlyList<string> DashboardBoundFilters { get; set; } = [];
    [Parameter] public IReadOnlyDictionary<string, FilterDefinition> FilterIndex { get; set; } =
        new Dictionary<string, FilterDefinition>();
    [Parameter] public Dictionary<string, DateOnly> DateFrom { get; set; } = new(StringComparer.OrdinalIgnoreCase);
    [Parameter] public Dictionary<string, DateOnly> DateTo { get; set; } = new(StringComparer.OrdinalIgnoreCase);
    [Parameter] public Dictionary<string, HashSet<string>> SelectedFields { get; set; } = new(StringComparer.OrdinalIgnoreCase);
    [Parameter] public Dictionary<string, int> TopLimits { get; set; } = new(StringComparer.OrdinalIgnoreCase);
    [Parameter] public Func<string, IReadOnlyList<string>> GetFieldOptions { get; set; } = _ => [];
    [Parameter] public bool AutoApply { get; set; }
    [Parameter] public EventCallback<string> OnApplyCard { get; set; }
    [Parameter] public EventCallback<string> OnScheduleCardApply { get; set; }
    [Parameter] public EventCallback<(string CardId, string FilterName)> OnCardDayChanged { get; set; }
    [Parameter] public EventCallback<(string CardId, string FilterName, HashSet<string> Values)> OnCardFieldChanged { get; set; }
}
