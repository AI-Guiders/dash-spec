@namespace DashSpec.Host.Components.Dashboard
@using DashSpec.Core.Model
@using DashSpec.Host.Plugins
@using DashSpec.Host.Services.Models
@using Microsoft.AspNetCore.Components

@if (Card.Loading)
{
    <div class="card-skeleton">
        <div class="spinner" aria-hidden="true"></div>
    </div>
}
else if (!string.IsNullOrEmpty(Card.Error))
{
    <div class="card-error">@Card.Error</div>
}
else if (_componentType is null)
{
    <div class="card-error">Неизвестный viz plugin: @Card.RenderPluginId</div>
}
else
{
    <DynamicComponent Type="_componentType" Parameters="_parameters" />
}

@code {
    [Parameter, EditorRequired] public CardRenderResult Card { get; set; } = default!;
    [Parameter] public double MatrixMin { get; set; }
    [Parameter] public double MatrixMax { get; set; }
    [Parameter] public EventCallback<HeatmapCellContext> OnHeatmapCellSelected { get; set; }

    [Inject] private CardVizComponentRegistry VizComponents { get; set; } = default!;

    private Type? _componentType;

    private Dictionary<string, object?> _parameters = new();

    protected override void OnParametersSet()
    {
        _componentType = VizComponents.TryGet(Card.RenderPluginId);
        _parameters = new Dictionary<string, object?>
        {
            ["Context"] = new CardVizRenderContext
            {
                Card = Card,
                MatrixMin = MatrixMin,
                MatrixMax = MatrixMax,
                OnHeatmapCellSelected = OnHeatmapCellSelected,
            },
        };
    }
}
