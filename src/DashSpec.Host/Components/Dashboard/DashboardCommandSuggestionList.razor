@namespace DashSpec.Host.Components.Dashboard
@using AIGuiders.Platform.CommandPlane
@using DashSpec.Host.Commands

@if (Items.Count > 0)
{
    <div class="dash-command-suggest-table" @onmousedown:preventDefault="true">
        <div class="dash-command-suggest-head" aria-hidden="true">
            <span class="col-name">id</span>
            <span class="col-human">Название</span>
            <span class="col-help">Подсказка</span>
        </div>
        <ul id="@Id"
            class="@CssClass"
            role="listbox"
            aria-label="@AriaLabel">
            @for (var i = 0; i < Items.Count; i++)
            {
                var item = Items[i];
                var index = i;
                var parts = DashboardFilterCommandDisplay.FormatSuggestionParts(item, CommandContext);
                <li role="option"
                    aria-selected="@(index == SelectedIndex)"
                    class="dash-command-suggest-row @(index == SelectedIndex ? "active" : null)"
                    @onclick="() => OnSelect.InvokeAsync(item)">
                    <span class="col-name">@(parts.Secondary ?? "")</span>
                    <span class="col-human">@parts.Primary</span>
                    <span class="col-help">@item.Help</span>
                </li>
            }
        </ul>
    </div>
}

@code {
    [Parameter] public string? Id { get; set; }
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter] public string AriaLabel { get; set; } = "Commands";
    [Parameter] public IReadOnlyList<SlashCompletionItem> Items { get; set; } = [];
    [Parameter] public DashboardFilterContext CommandContext { get; set; } = default!;
    [Parameter] public int SelectedIndex { get; set; }
    [Parameter] public EventCallback<SlashCompletionItem> OnSelect { get; set; }
}
