@namespace DashSpec.Host.Components.Filters

<div class="filter filter-chips @(Compact ? "filter-chips-compact" : null)">
    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <span class="filter-label">@Label</span>
    }
    @if (!string.IsNullOrWhiteSpace(Hint))
    {
        <span class="filter-scope">@Hint</span>
    }
    <div class="filter-chips-row" role="listbox" aria-label="@Label">
        @foreach (var option in Options)
        {
            var active = Selected.Contains(option);
            <button type="button"
                    class="filter-chip @(active ? "filter-chip-active" : null)"
                    role="option"
                    aria-selected="@active"
                    disabled="@Disabled"
                    @onclick="() => ToggleAsync(option)">
                @option
            </button>
        }
    </div>
</div>

@code {
    [Parameter] public string Label { get; set; } = string.Empty;

    [Parameter] public string? Hint { get; set; }

    [Parameter] public bool Compact { get; set; }

    [Parameter] public bool Disabled { get; set; }

    [Parameter] public bool SingleSelect { get; set; }

    [Parameter, EditorRequired] public IReadOnlyList<string> Options { get; set; } = [];

    [Parameter, EditorRequired] public HashSet<string> Selected { get; set; } = [];

    [Parameter] public EventCallback<HashSet<string>> SelectedChanged { get; set; }

    private async Task ToggleAsync(string option)
    {
        if (Disabled)
        {
            return;
        }

        HashSet<string> next;
        if (SingleSelect)
        {
            next = Selected.Contains(option)
                ? new HashSet<string>(StringComparer.OrdinalIgnoreCase)
                : new HashSet<string>([option], StringComparer.OrdinalIgnoreCase);
        }
        else if (Selected.Contains(option))
        {
            next = new HashSet<string>(Selected, StringComparer.OrdinalIgnoreCase);
            next.Remove(option);
        }
        else
        {
            next = new HashSet<string>(Selected, StringComparer.OrdinalIgnoreCase) { option };
        }

        await SelectedChanged.InvokeAsync(next);
    }
}
