@namespace DashSpec.Host.Components.Filters
@using DashSpec.Core.Runtime

<div class="filter filter-top filter-compact">
    <span class="filter-label">@Label</span>
    <input type="number"
           class="filter-number"
           aria-label="@Label"
           min="@Min"
           max="@Max"
           disabled="@Disabled"
           @bind="Value"
           @bind:after="OnChanged" />
</div>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;

    [Parameter] public int Min { get; set; } = 1;

    [Parameter] public int Max { get; set; } = TopLimitDefaults.DefaultMax;

    [Parameter] public bool Disabled { get; set; }

    [Parameter] public int Value { get; set; }

    [Parameter] public EventCallback<int> ValueChanged { get; set; }

    private Task OnChanged() => ValueChanged.InvokeAsync(Value);
}
