@namespace DashSpec.Host.Components.Filters
@using DashSpec.Core.Model
@using DashSpec.Filters
@using DashSpec.Host.Plugins
@inject FilterWidgetRegistry WidgetRegistry

@if (_componentType is not null)
{
    <DynamicComponent Type="_componentType" Parameters="_parameters" />
}

@code {
    [Parameter, EditorRequired] public FilterDefinition Filter { get; set; } = default!;

    [Parameter] public string Label { get; set; } = string.Empty;

    [Parameter] public string? Hint { get; set; }

    [Parameter] public bool Compact { get; set; }

    [Parameter] public bool Disabled { get; set; }

    [Parameter] public string? PlacementStyle { get; set; }

    [Parameter] public bool ShowDateLabel { get; set; }

    [Parameter] public string DateLabelClass { get; set; } = "filter-label";

    [Parameter] public IReadOnlyList<string> Options { get; set; } = [];

    [Parameter] public HashSet<string> Selected { get; set; } = [];

    [Parameter] public EventCallback<HashSet<string>> SelectedChanged { get; set; }

    [Parameter] public IReadOnlyDictionary<string, DateOnly> DateFrom { get; set; } =
        new Dictionary<string, DateOnly>(StringComparer.OrdinalIgnoreCase);

    [Parameter] public IReadOnlyDictionary<string, DateOnly> DateTo { get; set; } =
        new Dictionary<string, DateOnly>(StringComparer.OrdinalIgnoreCase);

    [Parameter] public IReadOnlyDictionary<string, FilterDefinition> FilterIndex { get; set; } =
        new Dictionary<string, FilterDefinition>(StringComparer.OrdinalIgnoreCase);

    [Parameter] public IReadOnlyDictionary<string, HashSet<string>> SelectedFields { get; set; } =
        new Dictionary<string, HashSet<string>>(StringComparer.OrdinalIgnoreCase);

    [Parameter] public EventCallback<string> OnDayChanged { get; set; }

    [Parameter] public EventCallback OnRangeChanged { get; set; }

    [Parameter] public int TopValue { get; set; }

    [Parameter] public EventCallback<int> TopValueChanged { get; set; }

    private Type? _componentType;
    private Dictionary<string, object?> _parameters = new();

    protected override void OnParametersSet()
    {
        _componentType = WidgetRegistry.ResolveComponentType(Filter);
        _parameters = new Dictionary<string, object?>
        {
            ["Context"] = new FilterWidgetRenderContext
            {
                Filter = Filter,
                Label = Label,
                Hint = Hint,
                Compact = Compact,
                Disabled = Disabled,
                PlacementStyle = PlacementStyle,
                ShowDateLabel = ShowDateLabel,
                DateLabelClass = DateLabelClass,
                Options = Options,
                Selected = Selected,
                SelectedChanged = SelectedChanged,
                DateFrom = AsMutableDateMap(DateFrom),
                DateTo = AsMutableDateMap(DateTo),
                FilterIndex = FilterIndex,
                SelectedFields = AsMutableFieldMap(SelectedFields),
                OnDayChanged = OnDayChanged,
                OnRangeChanged = OnRangeChanged,
                TopValue = TopValue,
                TopValueChanged = TopValueChanged,
            },
        };
    }

    private static Dictionary<string, DateOnly> AsMutableDateMap(IReadOnlyDictionary<string, DateOnly> source) =>
        source as Dictionary<string, DateOnly> ?? new Dictionary<string, DateOnly>(source, StringComparer.OrdinalIgnoreCase);

    private static Dictionary<string, HashSet<string>> AsMutableFieldMap(
        IReadOnlyDictionary<string, HashSet<string>> source) =>
        source as Dictionary<string, HashSet<string>>
        ?? source.ToDictionary(pair => pair.Key, pair => pair.Value, StringComparer.OrdinalIgnoreCase);
}
