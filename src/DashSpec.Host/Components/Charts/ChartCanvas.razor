@using DashSpec.Core.Runtime
@inject IJSRuntime Js
@implements IAsyncDisposable

<canvas id="@ChartId"></canvas>

@code {
    [Parameter, EditorRequired]
    public string ChartId { get; set; } = string.Empty;

    [Parameter]
    public string ChartType { get; set; } = "line";

    [Parameter]
    public string Legend { get; set; } = "bottom";

    [Parameter]
    public bool Stacked { get; set; }

    [Parameter]
    public ChartOrientation Orientation { get; set; } = ChartOrientation.Vertical;

    [Parameter]
    public ChartAxisScale ValueAxisScale { get; set; } = ChartAxisScale.Decimal;

    [Parameter]
    public ChartPayload? Payload { get; set; }

    private ChartPayload? _previousPayload;
    private string _previousLegend = string.Empty;
    private bool _previousStacked;
    private ChartOrientation _previousOrientation;
    private ChartAxisScale _previousValueAxisScale;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!RendererInfo.IsInteractive || Payload is null)
        {
            return;
        }

        if (ReferenceEquals(Payload, _previousPayload) &&
            string.Equals(Legend, _previousLegend, StringComparison.OrdinalIgnoreCase) &&
            Stacked == _previousStacked &&
            Orientation == _previousOrientation &&
            ValueAxisScale == _previousValueAxisScale)
        {
            return;
        }

        _previousPayload = Payload;
        _previousLegend = Legend;
        _previousStacked = Stacked;
        _previousOrientation = Orientation;
        _previousValueAxisScale = ValueAxisScale;
        await Js.InvokeVoidAsync(
            "dashSpecCharts.render",
            ChartId,
            ChartType,
            Payload.Labels,
            Payload.Series,
            new
            {
                legend = Legend,
                stacked = Stacked,
                horizontal = Orientation is ChartOrientation.Horizontal,
                valueAxisScale = ValueAxisScale switch
                {
                    ChartAxisScale.Integer => "integer",
                    _ => "decimal",
                },
            });
    }

    public async ValueTask DisposeAsync()
    {
        if (RendererInfo.IsInteractive)
        {
            try
            {
                await Js.InvokeVoidAsync("dashSpecCharts.destroy", ChartId);
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
