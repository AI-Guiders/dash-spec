@using DashSpec.Core.Runtime
@using Microsoft.JSInterop
@inject IJSRuntime Js
@implements IAsyncDisposable

<canvas id="@ChartId"></canvas>

@code {
    [Parameter, EditorRequired]
    public string ChartId { get; set; } = string.Empty;

    [Parameter]
    public string ChartType { get; set; } = "line";

    [Parameter]
    public string Legend { get; set; } = "bottom";

    [Parameter]
    public bool Stacked { get; set; }

    [Parameter]
    public bool FillArea { get; set; }

    [Parameter]
    public bool Sparkline { get; set; }

    [Parameter]
    public ChartOrientation Orientation { get; set; } = ChartOrientation.Vertical;

    [Parameter]
    public ChartAxisScale ValueAxisScale { get; set; } = ChartAxisScale.Decimal;

    [Parameter]
    public string? CategoryAxisLabel { get; set; }

    [Parameter]
    public string? ValueAxisLabel { get; set; }

    [Parameter]
    public double? ValueAxisMax { get; set; }

    [Parameter]
    public ChartPayload? Payload { get; set; }

    [Parameter]
    public bool CategoryClickEnabled { get; set; }

    [Parameter]
    public EventCallback<(int Index, string Label)> OnCategorySelected { get; set; }

    private DotNetObjectReference<ChartCanvas>? _dotNetRef;
    private ChartPayload? _previousPayload;
    private string _previousLegend = string.Empty;
    private bool _previousStacked;
    private bool _previousFillArea;
    private bool _previousSparkline;
    private ChartOrientation _previousOrientation;
    private ChartAxisScale _previousValueAxisScale;
    private string? _previousCategoryAxisLabel;
    private string? _previousValueAxisLabel;
    private double? _previousValueAxisMax;
    private bool _previousCategoryClickEnabled;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!RendererInfo.IsInteractive || Payload is null)
        {
            return;
        }

        if (CategoryClickEnabled && _dotNetRef is null)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
        }

        if (ReferenceEquals(Payload, _previousPayload) &&
            string.Equals(Legend, _previousLegend, StringComparison.OrdinalIgnoreCase) &&
            Stacked == _previousStacked &&
            FillArea == _previousFillArea &&
            Sparkline == _previousSparkline &&
            Orientation == _previousOrientation &&
            ValueAxisScale == _previousValueAxisScale &&
            string.Equals(CategoryAxisLabel, _previousCategoryAxisLabel, StringComparison.Ordinal) &&
            string.Equals(ValueAxisLabel, _previousValueAxisLabel, StringComparison.Ordinal) &&
            ValueAxisMax == _previousValueAxisMax &&
            CategoryClickEnabled == _previousCategoryClickEnabled)
        {
            return;
        }

        _previousPayload = Payload;
        _previousLegend = Legend;
        _previousStacked = Stacked;
        _previousFillArea = FillArea;
        _previousSparkline = Sparkline;
        _previousOrientation = Orientation;
        _previousValueAxisScale = ValueAxisScale;
        _previousCategoryAxisLabel = CategoryAxisLabel;
        _previousValueAxisLabel = ValueAxisLabel;
        _previousValueAxisMax = ValueAxisMax;
        _previousCategoryClickEnabled = CategoryClickEnabled;
        await Js.InvokeVoidAsync(
            "dashSpecCharts.render",
            ChartId,
            ChartType,
            Payload.Labels,
            Payload.Series,
            new
            {
                legend = Legend,
                stacked = Stacked,
                fill = FillArea,
                sparkline = Sparkline,
                horizontal = Orientation is ChartOrientation.Horizontal,
                valueAxisScale = ValueAxisScale switch
                {
                    ChartAxisScale.Integer => "integer",
                    ChartAxisScale.Percent => "percent",
                    _ => "decimal",
                },
                referenceValues = Payload.ReferenceValues,
                referenceLabel = Payload.ReferenceLabel,
                points = Payload.Points,
                boxes = Payload.Boxes,
                treemap = Payload.Treemap,
                gauge = Payload.Gauge,
                categoryAxisLabel = CategoryAxisLabel,
                valueAxisLabel = ValueAxisLabel,
                valueAxisMax = ValueAxisMax,
                categoryClickEnabled = CategoryClickEnabled,
                dotNetRef = CategoryClickEnabled ? _dotNetRef : null,
            });
    }

    [JSInvokable]
    public Task OnCategoryClick(int index, string label) =>
        OnCategorySelected.InvokeAsync((index, label));

    public async ValueTask DisposeAsync()
    {
        _dotNetRef?.Dispose();
        if (RendererInfo.IsInteractive)
        {
            try
            {
                await Js.InvokeVoidAsync("dashSpecCharts.destroy", ChartId);
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
