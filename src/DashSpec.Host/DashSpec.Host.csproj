<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>14</LangVersion>
    <RootNamespace>DashSpec.Host</RootNamespace>
    <Version>0.2.3</Version>
    <GuidersPlatformRoot Condition="'$(GuidersPlatformRoot)' == ''">..\..\..\guiders-platform</GuidersPlatformRoot>
    <UseLocalGuidersPlatform Condition="'$(UseLocalGuidersPlatform)' == '' AND Exists('$(GuidersPlatformRoot)\AIGuiders.Platform.sln')">true</UseLocalGuidersPlatform>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DashSpec.Host.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AIGuiders.Platform.CommandPlane" Version="0.4.4" Condition="'$(UseLocalGuidersPlatform)' != 'true'" />
    <ProjectReference Include="$(GuidersPlatformRoot)\src\AIGuiders.Platform.CommandPlane\AIGuiders.Platform.CommandPlane.csproj" Condition="'$(UseLocalGuidersPlatform)' == 'true'" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.0" />
    <PackageReference Include="OutWit.Database.EntityFramework" Version="14.0.1" />
    <PackageReference Include="Tomlyn" Version="2.10.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DashSpec.Abstractions\DashSpec.Abstractions.csproj" />
    <ProjectReference Include="..\DashSpec.Core\DashSpec.Core.csproj" />
    <ProjectReference Include="..\..\connectors\DashSpec.Connector.SqlServer\DashSpec.Connector.SqlServer.csproj" />
    <ProjectReference Include="..\..\plugins\DashSpec.Plugin.Export\DashSpec.Plugin.Export.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\plugins\DashSpec.Plugin.ViewSwitch\DashSpec.Plugin.ViewSwitch.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <None Update="dash-spec.toml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="dash-spec.dev.toml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="dash-spec.local.toml.example">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="StageConnectorPlugins" AfterTargets="Build;Publish">
    <PropertyGroup>
      <_ConnectorOutDir>..\..\connectors\DashSpec.Connector.SqlServer\bin\$(Configuration)\$(TargetFramework)\</_ConnectorOutDir>
      <_ConnectorPluginDll>$(_ConnectorOutDir)DashSpec.Connector.SqlServer.dll</_ConnectorPluginDll>
      <_ExportOutDir>..\..\plugins\DashSpec.Plugin.Export\bin\$(Configuration)\$(TargetFramework)\</_ExportOutDir>
      <_ExportPluginDll>$(_ExportOutDir)DashSpec.Plugin.Export.dll</_ExportPluginDll>
      <_ViewSwitchOutDir>..\..\plugins\DashSpec.Plugin.ViewSwitch\bin\$(Configuration)\$(TargetFramework)\</_ViewSwitchOutDir>
      <_ViewSwitchPluginDll>$(_ViewSwitchOutDir)DashSpec.Plugin.ViewSwitch.dll</_ViewSwitchPluginDll>
    </PropertyGroup>
    <MakeDir Directories="$(OutputPath)connectors" />
    <MakeDir Directories="$(OutputPath)plugins" />
    <Copy SourceFiles="$(_ConnectorPluginDll)" DestinationFolder="$(OutputPath)connectors\" SkipUnchangedFiles="true" Condition="Exists('$(_ConnectorPluginDll)')" />
    <Copy SourceFiles="$(_ExportPluginDll)" DestinationFolder="$(OutputPath)plugins\" SkipUnchangedFiles="true" Condition="Exists('$(_ExportPluginDll)')" />
    <Copy SourceFiles="$(_ViewSwitchPluginDll)" DestinationFolder="$(OutputPath)plugins\" SkipUnchangedFiles="true" Condition="Exists('$(_ViewSwitchPluginDll)')" />
  </Target>

</Project>
