<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>14</LangVersion>
    <RootNamespace>DashSpec.Host</RootNamespace>
    <Version>0.2.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
    <PackageReference Include="Tomlyn" Version="2.9.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DashSpec.Abstractions\DashSpec.Abstractions.csproj" />
    <ProjectReference Include="..\DashSpec.Core\DashSpec.Core.csproj" />
    <ProjectReference Include="..\..\connectors\DashSpec.Connector.SqlServer\DashSpec.Connector.SqlServer.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <None Update="dash-spec.toml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="dash-spec.dev.toml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="dash-spec.local.toml.example">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="StageConnectorPlugins" AfterTargets="Build">
    <PropertyGroup>
      <_ConnectorOutDir>..\..\connectors\DashSpec.Connector.SqlServer\bin\$(Configuration)\$(TargetFramework)\</_ConnectorOutDir>
      <_ConnectorPluginDll>$(_ConnectorOutDir)DashSpec.Connector.SqlServer.dll</_ConnectorPluginDll>
    </PropertyGroup>
    <MakeDir Directories="$(OutputPath)connectors" />
    <Copy SourceFiles="$(_ConnectorPluginDll)"
          DestinationFolder="$(OutputPath)connectors\"
          SkipUnchangedFiles="true"
          Condition="Exists('$(_ConnectorPluginDll)')" />
  </Target>

</Project>
