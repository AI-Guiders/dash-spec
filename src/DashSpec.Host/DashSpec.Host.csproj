<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>14</LangVersion>
    <RootNamespace>DashSpec.Host</RootNamespace>
    <Version>0.4.1</Version>
    <GuidersPlatformRoot Condition="'$(GuidersPlatformRoot)' == ''">..\..\..\guiders-platform</GuidersPlatformRoot>
    <AuthoringToolchainRoot Condition="'$(AuthoringToolchainRoot)' == ''">..\..\..\authoring-toolchain\</AuthoringToolchainRoot>
    <UseLocalGuidersPlatform Condition="'$(UseLocalGuidersPlatform)' == '' AND (Exists('$(GuidersPlatformRoot)\AIGuiders.Platform.slnx') OR Exists('$(GuidersPlatformRoot)\AIGuiders.Platform.sln'))">true</UseLocalGuidersPlatform>
  </PropertyGroup>

  <!-- Catalog emit: GdlEmitProject → authoring/dashspec.gdlproj (Wave 2.5; requires authoring-toolchain main 3b8cd8b+) -->
  <Import Project="$(AuthoringToolchainRoot)\build\Platform.Gdl.Emit.props" Condition="Exists('$(AuthoringToolchainRoot)\build\Platform.Gdl.Emit.props')" />
  <Import Project="..\..\build\ValidateJavaScriptSyntax.targets" />

  <PropertyGroup Condition="Exists('$(AuthoringToolchainRoot)\build\Platform.Gdl.Emit.props')">
    <GdlEmitProject>$(MSBuildProjectDirectory)\authoring\dashspec.gdlproj</GdlEmitProject>
    <GdlEmitNamespace>DashSpec.Generated</GdlEmitNamespace>
    <GdlEmitOutputDir>$(MSBuildProjectDirectory)\Generated</GdlEmitOutputDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Generated\DashCatalog.g.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DashSpec.Host.Tests" />
    <InternalsVisibleTo Include="DashSpec.Host.E2E" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseLocalGuidersPlatform)' == 'true'">
    <Using Include="AIGuiders.Platform.Authoring.Command.Catalog" />
    <Using Include="AIGuiders.Platform.Modeling.Gdl.Command" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AIGuiders.Platform.CommandPlane" Version="0.30.0" Condition="'$(UseLocalGuidersPlatform)' != 'true'" />
    <PackageReference Include="AIGuiders.Platform.CommandPlane.Slash" Version="0.30.0" Condition="'$(UseLocalGuidersPlatform)' != 'true'" />
    <PackageReference Include="AIGuiders.Platform.CommandPlane.Catalog.Sources" Version="0.30.0" Condition="'$(UseLocalGuidersPlatform)' != 'true'" />
    <ProjectReference Include="$(GuidersPlatformRoot)\src\AIGuiders.Platform.Execution.CommandPlane\AIGuiders.Platform.Execution.CommandPlane.csproj" Condition="'$(UseLocalGuidersPlatform)' == 'true'" />
    <ProjectReference Include="$(GuidersPlatformRoot)\src\AIGuiders.Platform.Execution.CommandPlane.Slash\AIGuiders.Platform.Execution.CommandPlane.Slash.csproj" Condition="'$(UseLocalGuidersPlatform)' == 'true'" />
    <ProjectReference Include="$(GuidersPlatformRoot)\src\AIGuiders.Platform.Execution.CommandPlane.Constructors\AIGuiders.Platform.Execution.CommandPlane.Constructors.csproj" Condition="'$(UseLocalGuidersPlatform)' == 'true'" />
    <ProjectReference Include="$(GuidersPlatformRoot)\src\AIGuiders.Platform.Execution.CommandPlane.ArgSuggestions\AIGuiders.Platform.Execution.CommandPlane.ArgSuggestions.csproj" Condition="'$(UseLocalGuidersPlatform)' == 'true'" />
    <ProjectReference Include="$(GuidersPlatformRoot)\src\AIGuiders.Platform.Execution.CommandPlane.Catalog.Sources\AIGuiders.Platform.Execution.CommandPlane.Catalog.Sources.csproj" Condition="'$(UseLocalGuidersPlatform)' == 'true'" />
    <PackageReference Include="AIGuiders.Platform.Execution.CommandPlane.PrefixArmed.Locale" Version="0.30.0" Condition="'$(UseLocalGuidersPlatform)' != 'true'" />
    <ProjectReference Include="$(GuidersPlatformRoot)\src\AIGuiders.Platform.Execution.CommandPlane.PrefixArmed.Locale\AIGuiders.Platform.Execution.CommandPlane.PrefixArmed.Locale.csproj" Condition="'$(UseLocalGuidersPlatform)' == 'true'" />
    <ProjectReference Include="$(GuidersPlatformRoot)\src\AIGuiders.Platform.Authoring.Command.Catalog\AIGuiders.Platform.Authoring.Command.Catalog.csproj" Condition="'$(UseLocalGuidersPlatform)' == 'true'" />
    <ProjectReference Include="$(GuidersPlatformRoot)\src\AIGuiders.Platform.Authoring.Command.Bundles\AIGuiders.Platform.Authoring.Command.Bundles.csproj" Condition="'$(UseLocalGuidersPlatform)' == 'true'" />
    <ProjectReference Include="$(GuidersPlatformRoot)\src\AIGuiders.Platform.Execution.CommandPlane.Catalog.CodeGen\AIGuiders.Platform.Execution.CommandPlane.Catalog.CodeGen.csproj" Condition="'$(UseLocalGuidersPlatform)' == 'true'" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.12" />
    <PackageReference Include="OutWit.Database.EntityFramework" Version="14.0.1" />
    <PackageReference Include="Tomlyn" Version="2.10.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DashSpec.Analyzers\DashSpec.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\DashSpec.Abstractions\DashSpec.Abstractions.csproj" />
    <ProjectReference Include="..\DashSpec.Filters\DashSpec.Filters.csproj" />
    <ProjectReference Include="..\DashSpec.Viz\DashSpec.Viz.csproj" />
    <ProjectReference Include="..\..\plugins\viz\DashSpec.Plugin.Viz.Builtins\DashSpec.Plugin.Viz.Builtins.csproj" />
    <ProjectReference Include="..\..\plugins\filter\DashSpec.Plugin.Filter.Builtins\DashSpec.Plugin.Filter.Builtins.csproj" />
    <ProjectReference Include="..\DashSpec.Viewer\DashSpec.Viewer.csproj" />
    <ProjectReference Include="..\DashSpec.Surface.Blazor\DashSpec.Surface.Blazor.csproj" />
    <ProjectReference Include="..\DashSpec.Execution.Core\DashSpec.Execution.Core.csproj" />
    <ProjectReference Include="..\DashSpec.Execution.Runtime\DashSpec.Execution.Runtime.csproj" />
    <ProjectReference Include="..\DashSpec.Execution.Compilation\DashSpec.Execution.Compilation.csproj" />
    <ProjectReference Include="..\..\connectors\DashSpec.Connector.SqlServer\DashSpec.Connector.SqlServer.csproj" />
    <ProjectReference Include="..\..\connectors\DashSpec.Connector.Postgres\DashSpec.Connector.Postgres.csproj" />
    <ProjectReference Include="..\..\plugins\DashSpec.Plugin.Export\DashSpec.Plugin.Export.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\plugins\DashSpec.Plugin.ViewSwitch\DashSpec.Plugin.ViewSwitch.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embedded default shell board ([ADR-0111] §2): a regular ds file — no synthesized shell in code. -->
    <EmbeddedResource Include="Resources\host.ds" />
    <None Update="Catalog\dash.catalog.gdl">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
    <None Update="dash-spec.toml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="dash-spec.dev.toml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="dash-spec.local.toml.example">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="StageConnectorPlugins" AfterTargets="Build;Publish">
    <PropertyGroup>
      <_ConnectorOutDir>..\..\connectors\DashSpec.Connector.SqlServer\bin\$(Configuration)\$(TargetFramework)\</_ConnectorOutDir>
      <_ConnectorPluginDll>$(_ConnectorOutDir)DashSpec.Connector.SqlServer.dll</_ConnectorPluginDll>
      <_PostgresConnectorOutDir>..\..\connectors\DashSpec.Connector.Postgres\bin\$(Configuration)\$(TargetFramework)\</_PostgresConnectorOutDir>
      <_PostgresConnectorPluginDll>$(_PostgresConnectorOutDir)DashSpec.Connector.Postgres.dll</_PostgresConnectorPluginDll>
      <_ExportOutDir>..\..\plugins\DashSpec.Plugin.Export\bin\$(Configuration)\$(TargetFramework)\</_ExportOutDir>
      <_ExportPluginDll>$(_ExportOutDir)DashSpec.Plugin.Export.dll</_ExportPluginDll>
      <_ViewSwitchOutDir>..\..\plugins\DashSpec.Plugin.ViewSwitch\bin\$(Configuration)\$(TargetFramework)\</_ViewSwitchOutDir>
      <_ViewSwitchPluginDll>$(_ViewSwitchOutDir)DashSpec.Plugin.ViewSwitch.dll</_ViewSwitchPluginDll>
    </PropertyGroup>
    <MakeDir Directories="$(OutputPath)connectors" />
    <MakeDir Directories="$(OutputPath)plugins" />
    <Copy SourceFiles="$(_ConnectorPluginDll)" DestinationFolder="$(OutputPath)connectors\" SkipUnchangedFiles="true" Condition="Exists('$(_ConnectorPluginDll)')" />
    <Copy SourceFiles="$(_PostgresConnectorPluginDll)" DestinationFolder="$(OutputPath)connectors\" SkipUnchangedFiles="true" Condition="Exists('$(_PostgresConnectorPluginDll)')" />
    <Copy SourceFiles="$(_ExportPluginDll)" DestinationFolder="$(OutputPath)plugins\" SkipUnchangedFiles="true" Condition="Exists('$(_ExportPluginDll)')" />
    <Copy SourceFiles="$(_ViewSwitchPluginDll)" DestinationFolder="$(OutputPath)plugins\" SkipUnchangedFiles="true" Condition="Exists('$(_ViewSwitchPluginDll)')" />
    <!-- Plugins are vertical slices: copy their satellite assemblies (ADR-0077). -->
    <MakeDir Directories="$(OutputPath)plugins\ru" />
    <MakeDir Directories="$(OutputPath)connectors\ru" />
    <Copy SourceFiles="$(_ExportOutDir)ru\DashSpec.Plugin.Export.resources.dll" DestinationFolder="$(OutputPath)plugins\ru\" SkipUnchangedFiles="true" Condition="Exists('$(_ExportOutDir)ru\DashSpec.Plugin.Export.resources.dll')" />
    <Copy SourceFiles="$(_ViewSwitchOutDir)ru\DashSpec.Plugin.ViewSwitch.resources.dll" DestinationFolder="$(OutputPath)plugins\ru\" SkipUnchangedFiles="true" Condition="Exists('$(_ViewSwitchOutDir)ru\DashSpec.Plugin.ViewSwitch.resources.dll')" />
    <Copy SourceFiles="$(_ConnectorOutDir)ru\DashSpec.Connector.SqlServer.resources.dll" DestinationFolder="$(OutputPath)connectors\ru\" SkipUnchangedFiles="true" Condition="Exists('$(_ConnectorOutDir)ru\DashSpec.Connector.SqlServer.resources.dll')" />
    <Copy SourceFiles="$(_PostgresConnectorOutDir)ru\DashSpec.Connector.Postgres.resources.dll" DestinationFolder="$(OutputPath)connectors\ru\" SkipUnchangedFiles="true" Condition="Exists('$(_PostgresConnectorOutDir)ru\DashSpec.Connector.Postgres.resources.dll')" />
  </Target>

  <ItemGroup>
    <PackageReference Include="FSharp.Core" Version="10.1.401" PrivateAssets="build;analyzers" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

</Project>

