# Copy to dash-spec.local.toml for personal dev (gitignored).
# Loaded after dash-spec.toml and optional dash-spec.dev.toml.

[dashboard]
catalog_path = "D:/SSCADRepo/URSA.LicenseUsage/docs/dashspec/catalogs/lus-dev.dashcatalog"
# Stakeholder-only catalog: point catalog_path at a smaller .dashcatalog if needed.

# Or env: DASHSPEC_CATALOG_PATH

# Prod / git catalog (оператор на сервере — любой git remote, не коммитить секреты)
# [catalog_git]
# enabled = true
# url = "https://github.com/<org>/<repo>.git"
# url = "https://gitlab.example.com/<group>/<repo>.git"
# url = "http://<git-host>/<path>/<repo>.git"
# branch = "main"
# path = "catalogs/<prod>.dashcatalog"
# pull_interval_minutes = 720   # safety net; webhook is primary (ADR-0041)
# sync_webhook_secret = "..."   # HMAC for POST /v1/admin/catalog/sync
# sync_repo_slug = "ursa-license-usage"
# sync_allow_unsigned = false
# username = "<user>"
# password = "..."  # или env DASHSPEC_CATALOG_GIT_PASSWORD
# Env: DASHSPEC_CATALOG_SYNC_SECRET, DASHSPEC_CATALOG_SYNC_REPO_SLUG
# Optional: override connector if not using @runtime in .dashspec
# [connectors.sqlserver]
# connection_string = "Server=localhost;Database=UrsaLicenseUsage;Trusted_Connection=True;TrustServerCertificate=True"

# Prod: require X-Api-Key (or cookie after /access login). Dev: leave empty = open host.
# [access]
# api_key = "CHANGE_ME"
# Or env: DASHSPEC_API_KEY
