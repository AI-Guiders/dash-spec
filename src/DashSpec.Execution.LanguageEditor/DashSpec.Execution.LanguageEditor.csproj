<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DashSpec.Execution.LanguageEditor</RootNamespace>
    <AssemblyName>DashSpec.Execution.LanguageEditor</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <GuidersWpfRoot Condition="'$(GuidersWpfRoot)' == ''">..\..\..\guiders-wpf</GuidersWpfRoot>
    <GuidersFSharpRoot Condition="'$(GuidersFSharpRoot)' == ''">..\..\..\guiders-fsharp</GuidersFSharpRoot>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\DashSpec.Modeling.CodeCenter\DashSpec.Modeling.CodeCenter.fsproj" />
    <ProjectReference Include="..\DashSpec.Modeling.LanguageEditor\DashSpec.Modeling.LanguageEditor.fsproj" />
    <ProjectReference Include="$(GuidersWpfRoot)\src\AIGuiders.Surface.Wpf.Abstractions\AIGuiders.Surface.Wpf.Abstractions.csproj" />
    <ProjectReference Include="$(GuidersWpfRoot)\src\AIGuiders.Surface.Wpf.CodeCenter\AIGuiders.Surface.Wpf.CodeCenter.csproj" />
    <ProjectReference Include="$(GuidersFSharpRoot)\src\AIGuiders.Platform.Modeling.CodeCenter\AIGuiders.Platform.Modeling.CodeCenter.fsproj" />
  </ItemGroup>
</Project>
