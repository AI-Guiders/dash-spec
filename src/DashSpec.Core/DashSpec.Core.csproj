<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>14</LangVersion>
    <RootNamespace>DashSpec.Core</RootNamespace>
    <Version>0.1.0</Version>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <GuidersPlatformRoot Condition="'$(GuidersPlatformRoot)' == ''">..\..\..\guiders-platform</GuidersPlatformRoot>
    <UseLocalGuidersPlatform Condition="'$(UseLocalGuidersPlatform)' == '' AND (Exists('$(GuidersPlatformRoot)\AIGuiders.Platform.slnx') OR Exists('$(GuidersPlatformRoot)\AIGuiders.Platform.sln'))">true</UseLocalGuidersPlatform>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DashSpec.Abstractions\DashSpec.Abstractions.csproj" />
    <ProjectReference Include="$(GuidersPlatformRoot)\src\AIGuiders.Platform.Authoring.Core\AIGuiders.Platform.Authoring.Core.csproj" Condition="'$(UseLocalGuidersPlatform)' == 'true'" />
    <ProjectReference Include="$(GuidersPlatformRoot)\src\AIGuiders.Platform.Paths\AIGuiders.Platform.Paths.csproj" Condition="'$(UseLocalGuidersPlatform)' == 'true'" />
    <PackageReference Include="AIGuiders.Platform.Authoring.Core" Version="0.31.0" Condition="'$(UseLocalGuidersPlatform)' != 'true'" />
    <PackageReference Include="AIGuiders.Platform.Paths" Version="0.31.0" Condition="'$(UseLocalGuidersPlatform)' != 'true'" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DashSpec.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Tomlyn" Version="2.10.1" />
  </ItemGroup>

  <ItemGroup>
    <None Include="stdlib\**\*" CopyToOutputDirectory="PreserveNewest" LinkBase="stdlib" />
  </ItemGroup>

</Project>
