@namespace DashSpec.Presentation.Components
@using DashSpec.Execution.Runtime

<PlacementSlotGrid CssClass="card-interior-grid"
                   Scope="LayoutSlotScope.CardInterior"
                   GridColumns="@GridColumns">
    @ChildContent
</PlacementSlotGrid>

@code {
    [Parameter] public int GridColumns { get; set; } = 12;
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
