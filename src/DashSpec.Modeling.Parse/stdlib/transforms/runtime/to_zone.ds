/// Перевод колонок даты и времени (`datetime`, `time`) из UTC в гражданский часовой пояс с фиксированным смещением (`UTC+3` и т.п.).
module transform to_zone
namespace DashSpec.Std.Transformations.Runtime

type_effect = identity
locality = runtime
requires_block = true
/// Смещение часового пояса в формате `UTC±Ч` или `UTC±ЧЧ:ММ` (например, `UTC+3`).
param zone = timeshift
hint = "to_zone requires a TimeShift literal (UTC+…); for IANA zones use transform use iana_to_timeshift."
