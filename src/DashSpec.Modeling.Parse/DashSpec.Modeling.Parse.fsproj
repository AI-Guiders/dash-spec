<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>DashSpec.Modeling.Parse</RootNamespace>
    <AssemblyName>DashSpec.Modeling.Parse</AssemblyName>
    <Description>DashSpec Modeling parse spine (ADR-0048).</Description>
    <PackageId>DashSpec.Modeling.Parse</PackageId>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\DashSpec.Modeling.Core\DashSpec.Modeling.Core.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Lexing\TokenKind.fs" />
    <Compile Include="Lexing\Token.fs" />
    <Compile Include="Lexing\BlockCloseStyle.fs" />
    <Compile Include="Lexing\DashSpecLexer.fs" />
    <Compile Include="Lexing\TokenReader.fs" />
    <Compile Include="BlockSyntax.fs" />
    <Compile Include="PropertySchemas.fs" />
    <Compile Include="PropertyBlockParser.fs" />
    <Compile Include="ParserUtilities.fs" />
    <Compile Include="Layout\LayoutTypes.fs" />
    <Compile Include="Layout\LayoutParser.fs" />
    <Compile Include="Layout\LayoutModuleParser.fs" />
    <Compile Include="Tooltip\TooltipTypes.fs" />
    <Compile Include="Tooltip\TooltipModuleParser.fs" />
    <Compile Include="Catalog\CatalogTypes.fs" />
    <Compile Include="Catalog\CatalogParser.fs" />
    <Compile Include="Transform\TransformTypes.fs" />
    <Compile Include="Transform\TransformModuleParser.fs" />
    <Compile Include="Palette\PaletteTypes.fs" />
    <Compile Include="Palette\PaletteColorResolver.fs" />
    <Compile Include="Palette\PaletteModuleParser.fs" />
    <Compile Include="Presentation\PresentationTypes.fs" />
    <Compile Include="Presentation\PresentationModuleParser.fs" />
  </ItemGroup>
</Project>
