<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>DashSpec.Modeling.Parse</RootNamespace>
    <AssemblyName>DashSpec.Modeling.Parse</AssemblyName>
    <Description>DashSpec Modeling parse spine — layout pilot (ADR-0048 M2).</Description>
    <PackageId>DashSpec.Modeling.Parse</PackageId>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\DashSpec.Modeling.Core\DashSpec.Modeling.Core.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Lexing\TokenKind.fs" />
    <Compile Include="Lexing\Token.fs" />
    <Compile Include="Lexing\BlockCloseStyle.fs" />
    <Compile Include="Lexing\DashSpecLexer.fs" />
    <Compile Include="Lexing\TokenReader.fs" />
    <Compile Include="BlockSyntax.fs" />
    <Compile Include="ParserUtilities.fs" />
    <Compile Include="Layout\LayoutTypes.fs" />
    <Compile Include="Layout\LayoutParser.fs" />
    <Compile Include="Layout\LayoutModuleParser.fs" />
  </ItemGroup>
</Project>
