<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>14</LangVersion>
    <RootNamespace>DashSpec.Execution</RootNamespace>
    <Version>0.1.0</Version>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.7" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.7" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\DashSpec.Analyzers\DashSpec.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\DashSpec.Abstractions\DashSpec.Abstractions.csproj" />
    <ProjectReference Include="..\DashSpec.Core\DashSpec.Core.csproj" />
    <ProjectReference Include="..\DashSpec.Execution.Runtime\DashSpec.Execution.Runtime.csproj" />
    <ProjectReference Include="..\\DashSpec.Execution.Core\\DashSpec.Execution.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="DashSpec.Core.Tests" />
    <InternalsVisibleTo Include="DashSpec.Execution.Compilation.Tests" />
    <InternalsVisibleTo Include="DashSpec.Platform.Session.Tests" />
  </ItemGroup>
</Project>

