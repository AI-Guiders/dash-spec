<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <RootNamespace>DashSpec.Modeling.Core</RootNamespace>
    <AssemblyName>DashSpec.Modeling.Core</AssemblyName>
    <Description>DashSpec Modeling spine — diagnostics and source spans (ADR-0048 M0/M1).</Description>
    <PackageId>DashSpec.Modeling.Core</PackageId>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="stdlib\rules\rules.ds" LogicalName="stdlib/rules/rules.ds" WithCulture="false" />
    <EmbeddedResource Include="stdlib\texts\rules.en.ds" LogicalName="stdlib/texts/rules.en.ds" WithCulture="false" />
    <EmbeddedResource Include="stdlib\texts\rules.ru.ds" LogicalName="stdlib/texts/rules.ru.ds" WithCulture="false" />
    <EmbeddedResource Include="stdlib\units\units.ds" LogicalName="stdlib/units/units.ds" WithCulture="false" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Diagnostics.fs" />
    <Compile Include="DashSpecRules.fs" />
    <Compile Include="ParseErrors.fs" />
    <Compile Include="TypeSystem.fs" />
    <Compile Include="TypeInvariantLaws.fs" />
    <Compile Include="TypeCatalog.fs" />
    <Compile Include="FlowGraphKind.fs" />
    <Compile Include="ImportKind.fs" />
    <Compile Include="FlowPlacementAnchors.fs" />
    <Compile Include="DataFlowGraph.fs" />
    <Compile Include="WiringGraph.fs" />
    <Compile Include="UtcOffsetZoneLiteral.fs" />
    <Compile Include="IanaZoneConverter.fs" />
    <Compile Include="TimeShiftToIanaResolver.fs" />
    <Compile Include="ZoneResolveReference.fs" />
    <Compile Include="ValueTypes.fs" />
    <Compile Include="TransformDeclarations.fs" />
    <Compile Include="BuiltinScalarTransforms.fs" />
  </ItemGroup>
</Project>
