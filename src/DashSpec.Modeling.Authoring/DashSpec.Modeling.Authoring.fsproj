<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>DashSpec.Modeling.Authoring</RootNamespace>
    <AssemblyName>DashSpec.Modeling.Authoring</AssemblyName>
    <Description>DashSpec planet authoring graph, laws, and parse entry (no federation IDE).</Description>
    <PackageId>DashSpec.Modeling.Authoring</PackageId>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\DashSpec.Modeling.Core\DashSpec.Modeling.Core.fsproj" />
    <ProjectReference Include="..\DashSpec.Modeling.Parse\DashSpec.Modeling.Parse.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="DashSpecConceptOntology.fs" />
    <Compile Include="DashSpecConceptGraphBuilder.fs" />
    <Compile Include="DashSpecDiagnosticRules.fs" />
    <Compile Include="DashSpecRuleEngine.fs" />
    <Compile Include="DashSpecInvariantLaws.fs" />
    <Compile Include="DashSpecAuthoringEntry.fs" />
    <Compile Include="DashSpecSerializeRules.fs" />
  </ItemGroup>
</Project>
