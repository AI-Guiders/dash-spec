<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>DashSpec.Modeling.LanguageEditor</RootNamespace>
    <AssemblyName>DashSpec.Modeling.LanguageEditor</AssemblyName>
    <Description>Model-first DashSpec document session (syntax/anchor SSOT).</Description>
    <PackageId>DashSpec.Modeling.LanguageEditor</PackageId>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\DashSpec.Modeling.Core\DashSpec.Modeling.Core.fsproj" />
    <ProjectReference Include="..\DashSpec.Modeling.Parse\DashSpec.Modeling.Parse.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="DocumentSession.fs" />
  </ItemGroup>
</Project>
