<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>15</LangVersion>
    <RootNamespace>DashSpec.Cli</RootNamespace>
    <AssemblyName>dsc</AssemblyName>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DashSpec.Composition\DashSpec.Composition.csproj" />
    <ProjectReference Include="..\DashSpec.Execution.Compilation\DashSpec.Execution.Compilation.csproj" />
    <ProjectReference Include="..\..\publishing\DashSpec.Publishing.SqlServer\DashSpec.Publishing.SqlServer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- ADR-0125: dsc build views with a connection applies the publish-time DDL (tsql) -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.0" />
    <!-- transitive pin: NuGet audit fails the build on the vulnerable default -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <ProjectReference Include="..\..\publishing\DashSpec.Publishing.SqlServer\DashSpec.Publishing.SqlServer.csproj" />
  </ItemGroup>

</Project>
