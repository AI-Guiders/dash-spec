module section self_monitoring
namespace DashSpec.Std.Monitoring.Report

from DashSpec.Std import presentations
import types from DashSpec.Std.Monitoring.Types
import flows from DashSpec.Std.Monitoring.Flows
import diagrams from DashSpec.Std.Monitoring.Diagrams

runtime
  manifest = "host-telemetry.runtime.toml"
end runtime

connect
  layout grid
    [] [] [] [] [] [] [] [] [] [] [] []
  end grid
  layout board
    | working_set_chart   | managed_heap_chart |
    | query_latency_chart | log_levels_chart   |
    | recent_queries                           |
    | recent_logs                              |
  end layout
end connect

report "DashSpec Self-Monitoring (WitDB)"
  card working_set_chart as "Working Set Memory (MB)"
    diagram ref main diag_telemetry_memory_line
    data flow
      src_metrics_timeline [rows] -> [rows] main
    end data flow
  end card

  card managed_heap_chart as "Managed GC Heap (MB)"
    diagram ref main diag_telemetry_heap_area
    data flow
      src_metrics_timeline [rows] -> [rows] main
    end data flow
  end card

  card query_latency_chart as "Average Query Latency by Kind (ms)"
    diagram ref main diag_telemetry_query_kind_bar
    data flow
      src_query_kind_stats [rows] -> [rows] main
    end data flow
  end card

  card log_levels_chart as "Host Events by Severity"
    diagram ref main diag_telemetry_log_level_donut
    data flow
      src_log_level_stats [rows] -> [rows] main
    end data flow
  end card

  card recent_queries as "Executed Queries (WitDB: query_telemetry)"
    diagram ref main diag_telemetry_queries
    data flow
      src_queries [rows] -> [rows] main
    end data flow
  end card

  card recent_logs as "Host Event Log (WitDB: host_logs)"
    diagram ref main diag_telemetry_logs
    data flow
      src_logs [rows] -> [rows] main
    end data flow
  end card
end report

end section
