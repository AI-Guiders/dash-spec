module section self_monitoring
namespace DashSpec.Std.Monitoring.Report

from DashSpec.Std import presentations
import types from DashSpec.Std.Monitoring.Types
import flows from DashSpec.Std.Monitoring.Flows
import diagrams from DashSpec.Std.Monitoring.Diagrams

runtime
  manifest = "host-telemetry.runtime.toml"
end runtime

connect
  layout grid
    [] [] [] [] [] [] [] [] [] [] [] []
  end grid
  layout board
    [ kpi_working_set kpi_managed_heap kpi_thread_pool kpi_total_queries kpi_avg_latency kpi_failed_queries ]
    [ working_set_chart managed_heap_chart ]
    [ query_latency_chart log_levels_chart ]
    [ recent_queries ]
    [ recent_logs ]
  end layout
end connect

report "DashSpec Self-Monitoring (WitDB)"
  card kpi_working_set as "Working Set (MB)"
    diagram number
      value = WorkingSetMb
    end number
    data flow
      src_latest_metrics [rows] -> [rows] __diagram__
    end data flow
  end card

  card kpi_managed_heap as "Managed Heap (MB)"
    diagram number
      value = ManagedHeapMb
    end number
    data flow
      src_latest_metrics [rows] -> [rows] __diagram__
    end data flow
  end card

  card kpi_thread_pool as "ThreadPool Threads"
    diagram number
      value = ThreadPoolThreads
      scale_value = integer
    end number
    data flow
      src_latest_metrics [rows] -> [rows] __diagram__
    end data flow
  end card

  card kpi_total_queries as "Total SQL Queries"
    diagram number
      value = TotalQueries
      scale_value = integer
    end number
    data flow
      src_query_kpis [rows] -> [rows] __diagram__
    end data flow
  end card

  card kpi_avg_latency as "Avg Query Latency (ms)"
    diagram number
      value = AvgDurationMs
    end number
    data flow
      src_query_kpis [rows] -> [rows] __diagram__
    end data flow
  end card

  card kpi_failed_queries as "Failed Queries"
    diagram number
      value = FailedQueries
      scale_value = integer
    end number
    data flow
      src_query_kpis [rows] -> [rows] __diagram__
    end data flow
  end card

  card working_set_chart as "Working Set Memory (MB)"
    diagram ref main diag_telemetry_memory_line
    data flow
      src_metrics_timeline [rows] -> [rows] main
    end data flow
  end card

  card managed_heap_chart as "Managed GC Heap (MB)"
    diagram ref main diag_telemetry_heap_area
    data flow
      src_metrics_timeline [rows] -> [rows] main
    end data flow
  end card

  card query_latency_chart as "Average Query Latency by Kind (ms)"
    diagram ref main diag_telemetry_query_kind_bar
    data flow
      src_query_kind_stats [rows] -> [rows] main
    end data flow
  end card

  card log_levels_chart as "Host Events by Severity"
    diagram ref main diag_telemetry_log_level_donut
    data flow
      src_log_level_stats [rows] -> [rows] main
    end data flow
  end card

  card recent_queries as "Executed Queries (WitDB: query_telemetry)"
    diagram ref main diag_telemetry_queries
    data flow
      src_queries [rows] -> [rows] main
    end data flow
  end card

  card recent_logs as "Host Event Log (WitDB: host_logs)"
    diagram ref main diag_telemetry_logs
    data flow
      src_logs [rows] -> [rows] main
    end data flow
  end card
end report

end section
