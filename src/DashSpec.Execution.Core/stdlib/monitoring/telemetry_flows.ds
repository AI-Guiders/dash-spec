module flow host_telemetry_flows
namespace DashSpec.Std.Monitoring.Flows

import types from DashSpec.Std.Monitoring.Types

source src_latest_metrics {
  use provider witdb
  from sql query "SELECT WorkingSetMb, ManagedHeapMb, GcGen2, ThreadPoolThreads FROM host_metrics ORDER BY TimestampUtc DESC LIMIT 1"
  ports
    default output rows
    output stream rows: TelemetryMetricKpiRow
  end ports
}

transformer tr_latest_metrics_rounded {
  ports
    default input raw
    default output rows
    input stream raw: TelemetryMetricKpiRow
    output stream rows: TelemetryMetricKpiRow
  end ports
  transform use round {
    digits = 1
  }
}

src_latest_metrics [rows] -> [raw] tr_latest_metrics_rounded

source src_query_kpis {
  use provider witdb
  from sql query "SELECT ConnectorId, Kind, Status, 1 AS TotalQueries, DurationMs AS AvgDurationMs, CASE WHEN Status = 'ERROR' THEN 1 ELSE 0 END AS FailedQueries FROM query_telemetry"
  ports
    default output rows
    output stream rows: TelemetryQueryKpiRow
  end ports
}

transformer tr_query_kpis_rounded {
  ports
    default input raw
    default output rows
    input stream raw: TelemetryQueryKpiRow
    output stream rows: TelemetryQueryKpiRow
  end ports
  transform use round {
    digits = 1
  }
}

src_query_kpis [rows] -> [raw] tr_query_kpis_rounded

source src_metrics_timeline {
  use provider witdb
  from sql query "SELECT TimestampUtc, WorkingSetMb, ManagedHeapMb, ThreadPoolThreads FROM host_metrics ORDER BY TimestampUtc ASC"
  ports
    default output rows
    output stream rows: TelemetryMetricPointRow
  end ports
}

transformer tr_metrics_timeline_rounded {
  ports
    default input raw
    default output rows
    input stream raw: TelemetryMetricPointRow
    output stream rows: TelemetryMetricPointRow
  end ports
  transform use round {
    digits = 1
  }
}

src_metrics_timeline [rows] -> [raw] tr_metrics_timeline_rounded

source src_queries {
  use provider witdb
  from sql query "SELECT CAST(TimestampUtc AS TEXT) AS TimestampUtc, ConnectorId, Kind, DurationMs, RowCount, Status, SqlPreview FROM query_telemetry ORDER BY TimestampUtc DESC"
  ports
    default output rows
    output stream rows: TelemetryQueryRow
  end ports
}

transformer tr_query_kind_stats_rounded {
  ports
    default input raw
    default output rows
    input stream raw: TelemetryQueryRow
    output stream rows: TelemetryQueryKindRow
  end ports
  transform use summarize {
    by = Kind
    agg = avg
    value = DurationMs
  }
  transform use round {
    digits = 1
  }
}

src_queries [rows] -> [raw] tr_query_kind_stats_rounded

source src_logs {
  use provider witdb
  from sql query "SELECT CAST(TimestampUtc AS TEXT) AS TimestampUtc, Level, Category, Message FROM host_logs ORDER BY TimestampUtc DESC"
  ports
    default output rows
    output stream rows: TelemetryLogRow
  end ports
}

transformer tr_log_level_stats {
  ports
    default input raw
    default output rows
    input stream raw: TelemetryLogRow
    output stream rows: TelemetryLogLevelRow
  end ports
  transform use summarize {
    by = Level
    agg = count
  }
}

src_logs [rows] -> [raw] tr_log_level_stats

end flow
