module diagram diag_telemetry_logs
namespace DashSpec.Std.Monitoring.Diagrams

presentation
  size = content
  column_size = content
  align = left
  visible_rows = 15
  page_size = 15
  frozen_columns = 0
  grouping = off
end presentation

table
  columns
    | id           | format | label      | sorting | size    | align  |
    | TimestampUtc | -      | Time (UTC) | DESC    | content | left   |
    | Level        | -      | Level      | -       | content | center |
    | Category     | -      | Category   | -       | content | left   |
    | Message      | -      | Message    | -       | fill    | left   |
  end columns
end table
