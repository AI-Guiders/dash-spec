module diagram diag_telemetry_queries
namespace DashSpec.Std.Monitoring.Diagrams

presentation
  size = content
  column_size = content
  align = left
  visible_rows = 8
  page_size = 0
  frozen_columns = 0
  grouping = off
end presentation

table
  columns
    | id           | format  | label         | sorting | size    | align  |
    | TimestampUtc | -       | Time (UTC)    | DESC    | content | left   |
    | ConnectorId  | -       | Connector     | -       | content | center |
    | Kind         | -       | Kind          | -       | content | center |
    | DurationMs   | integer | Duration (ms) | -       | content | right  |
    | RowCount     | integer | Rows          | -       | content | right  |
    | Status       | -       | Status        | -       | content | center |
    | SqlPreview   | -       | SQL Preview   | -       | fill    | left   |
  end columns
end table
