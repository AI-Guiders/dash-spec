/// Стандартный шаблон рабочего пространства отчёта (`kind = report`) с боковым меню каталога (`sidebar`),
/// вкладками секций (`tabs`), панелью фильтров (`toolbar`) и сеткой карточек (`board`).
module template standard_report
namespace DashSpec.Std.Templates

kind = report

nest main
  [ tabs ]
  [ toolbar ]
  [ board ]
end nest

wide
  [ sidebar:1 main:5 ]
end wide

narrow
  [ main:1 ]
end narrow

chrome
  scroll = page
  sidebar_width = 256
  format_guide = true
end chrome
